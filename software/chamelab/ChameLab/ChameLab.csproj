<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- CI passes the release version; a local build is marked so it doesn't look out of date -->
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="ActiproSoftware.Controls.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIFARE Classic key recovery (crapto1 port, GPL-3.0), built from the m0n5ter/Crapto1Sharp fork
         (git submodule) for fixes not yet in the NuGet package; see software/external. -->
    <ProjectReference Include="..\..\external\Crapto1Sharp\Crapto1Sharp\Crapto1Sharp.csproj" />
  </ItemGroup>
</Project>
