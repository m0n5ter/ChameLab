<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:svc="using:ChameLab.Services"
             xmlns:c="using:ChameLab.Controls"
             xmlns:loc="using:ChameLab.Localization"
             x:Class="ChameLab.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- One setting: icon, title + description, and its control (SettingRow stacks them when narrow). -->
    <Style Selector=":is(Control).setting > :is(Control).control">
      <Setter Property="Width" Value="220" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=".compact :is(Control).setting > :is(Control).control">
      <Setter Property="Width" Value="160" />
    </Style>
    <!-- Stacked (narrow) rows: a slimmer control leaves the description room. -->
    <Style Selector=":is(Control).setting.stacked > :is(Control).control">
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector=":is(Control).setting.stacked > NumericUpDown.control, :is(Control).setting.stacked > TextBox.control">
      <Setter Property="Width" Value="116" />
    </Style>
    <Style Selector="Separator.row">
      <Setter Property="Margin" Value="0,14" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Classes="page" MaxWidth="820">

      <!-- Header -->
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Static loc:Strings.Settings_Settings}" Classes="h1" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="{x:Static loc:Strings.Settings_AppSettingsTheyApplyRightAway}" />
      </StackPanel>

      <!-- Appearance (app-side, applies immediately) -->
      <Border Classes="card">
        <c:SettingRow Classes="setting">
          <Border Classes="iconwell green">
            <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Accent.Swatch}" />
          </Border>
          <TextBlock Text="{x:Static loc:Strings.Settings_AccentColor}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_ButtonsTogglesAndHighlights}" />
          <ComboBox Classes="control" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:AccentOption">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </c:SettingRow>
      </Border>

      <!-- Language (app-side, applies after a restart) -->
      <Border Classes="card">
        <c:SettingRow Classes="setting">
          <Border Classes="iconwell blue">
            <PathIcon Data="{StaticResource Icon.language}" />
          </Border>
          <TextBlock Text="{x:Static loc:Strings.Settings_Language}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_LanguageCaption}" />
          <ComboBox Classes="control" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:LanguageOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </c:SettingRow>
      </Border>

      <!-- Scan feedback (app-side, applies immediately) -->
      <Border Classes="card">
        <StackPanel>
          <c:SettingRow Classes="setting">
            <Border Classes="iconwell amber">
              <PathIcon Data="{StaticResource Icon.volume}" />
            </Border>
            <TextBlock Text="{x:Static loc:Strings.Settings_ScanSounds}" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_BeepWhenAScanFinishesBuzz}" />
            <ToggleSwitch VerticalAlignment="Center" OnContent="" OffContent=""
                          IsChecked="{Binding ScanSound}" />
          </c:SettingRow>

          <Separator Classes="row" IsVisible="{Binding CanVibrate}" />

          <c:SettingRow Classes="setting" IsVisible="{Binding CanVibrate}">
            <Border Classes="iconwell amber">
              <PathIcon Data="{StaticResource Icon.vibrate}" />
            </Border>
            <TextBlock Text="{x:Static loc:Strings.Settings_Vibration}" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_VibrateWhenACardScanOr}" />
            <ToggleSwitch VerticalAlignment="Center" OnContent="" OffContent=""
                          IsChecked="{Binding ScanVibration}" />
          </c:SettingRow>
        </StackPanel>
      </Border>

      <!-- Backup -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="iconwell blue"><PathIcon Data="{StaticResource Icon.save}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Settings_Backup}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static loc:Strings.Settings_ExportOrImportYourSavedCards}" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding ExportBackupCommand}" IsEnabled="{Binding CanUseFiles}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.export}" /><TextBlock Text="{x:Static loc:Strings.Settings_ExportBackup}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ImportBackupCommand}" IsEnabled="{Binding CanUseFiles}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.import}" /><TextBlock Text="{x:Static loc:Strings.Settings_ImportBackup}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="iconwell green"><PathIcon Data="{StaticResource Icon.info}" /></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="ChameLab" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{Binding AppVersion, StringFormat={x:Static loc:Strings.Settings_Version}}" />
            </StackPanel>
          </StackPanel>
          <!-- App update check: the web app is always current, so it has none. -->
          <!-- The status gets the full width; the buttons wrap under each other on a narrow screen. -->
          <StackPanel Spacing="8" IsVisible="{Binding AppUpdate.IsSupported}">
            <c:SettingRow Classes="setting">
              <Border Classes="iconwell blue"><PathIcon Data="{StaticResource Icon.upload}" /></Border>
              <TextBlock Text="{x:Static loc:Strings.Settings_UpdateChannel}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_UpdateChannelCaption}" />
              <ComboBox Classes="control" ItemsSource="{Binding AppUpdate.Channels}" SelectedItem="{Binding AppUpdate.Channel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:UpdateChannelOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </c:SettingRow>
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding AppUpdate.Message}"
                       IsVisible="{Binding AppUpdate.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="accent" Content="{x:Static loc:Strings.Settings_Download}" Command="{Binding AppUpdate.OpenDownloadCommand}"
                      IsVisible="{Binding AppUpdate.IsUpdateAvailable}" ToolTip.Tip="{x:Static loc:Strings.Settings_OpenTheReleasePage}" />
              <Button Command="{Binding AppUpdate.CheckCommand}"
                      ToolTip.Tip="{x:Static loc:Strings.Common_CheckGitHubForANewerRelease}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.refresh}" /><TextBlock Text="{x:Static loc:Strings.Settings_CheckForUpdates}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{x:Static loc:Strings.Settings_CrossPlatformClientForTheChameleon}" />
          <!-- Community channels: Telegram and MAX in the Russian UI, Discord everywhere. -->
          <ItemsControl ItemsSource="{Binding SocialLinks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SocialLink">
                <Button Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).OpenLinkCommand}"
                        CommandParameter="{Binding Url}" ToolTip.Tip="{Binding Url}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.chat}" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <SelectableTextBlock Classes="caption" TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                               Text="{x:Static vm:SettingsViewModel.TrademarkNotice}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
