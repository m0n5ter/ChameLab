<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:svc="using:ChameLab.Services"
             x:Class="ChameLab.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- One setting: icon, title + description, and its control on the right. -->
    <Style Selector="Grid.setting > :is(Control).control">
      <Setter Property="Width" Value="220" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=".compact Grid.setting > :is(Control).control">
      <Setter Property="Width" Value="160" />
    </Style>
    <Style Selector="Separator.row">
      <Setter Property="Margin" Value="0,14" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Classes="page" MaxWidth="820">

      <!-- Header -->
      <StackPanel Spacing="2">
        <TextBlock Text="Settings" Classes="h1" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="App settings. They apply right away and work without a device; the Chameleon's own settings are on its page." />
      </StackPanel>

      <!-- Appearance (app-side, applies immediately) -->
      <Border Classes="card">
        <Grid Classes="setting" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <Border Grid.Column="0" Classes="iconwell green">
            <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Accent.Swatch}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Accent color" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="Color of buttons, toggles and highlights in this app." />
          </StackPanel>
          <ComboBox Grid.Column="2" Classes="control" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:AccentOption">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>

      <!-- Scan feedback (app-side, applies immediately) -->
      <Border Classes="card">
        <StackPanel>
          <Grid Classes="setting" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Grid.Column="0" Classes="iconwell amber">
              <PathIcon Data="{StaticResource Icon.volume}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Scan sounds" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Beep when a card scan or dump finishes, and buzz when no card is found." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent=""
                          IsChecked="{Binding ScanSound}" />
          </Grid>

          <Separator Classes="row" IsVisible="{Binding CanVibrate}" />

          <Grid Classes="setting" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                IsVisible="{Binding CanVibrate}">
            <Border Grid.Column="0" Classes="iconwell amber">
              <PathIcon Data="{StaticResource Icon.vibrate}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Vibration" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Vibrate when a card scan or dump finishes." />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent=""
                          IsChecked="{Binding ScanVibration}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Backup -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="iconwell blue"><PathIcon Data="{StaticResource Icon.save}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Backup" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="Export or import your saved cards and key dictionaries." />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding ExportBackupCommand}" IsEnabled="{Binding CanUseFiles}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.export}" /><TextBlock Text="Export backup" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ImportBackupCommand}" IsEnabled="{Binding CanUseFiles}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.import}" /><TextBlock Text="Import backup" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="iconwell green"><PathIcon Data="{StaticResource Icon.info}" /></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="ChameLab" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{Binding AppVersion, StringFormat='Version {0}'}" />
            </StackPanel>
          </StackPanel>
          <!-- App update check: the web app is always current, so it has none. -->
          <!-- The status gets the full width; the buttons wrap under each other on a narrow screen. -->
          <StackPanel Spacing="8" IsVisible="{Binding AppUpdate.IsSupported}">
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding AppUpdate.Message}"
                       IsVisible="{Binding AppUpdate.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="accent" Content="Download" Command="{Binding AppUpdate.OpenDownloadCommand}"
                      IsVisible="{Binding AppUpdate.IsUpdateAvailable}" ToolTip.Tip="Open the release page" />
              <Button Command="{Binding AppUpdate.CheckCommand}"
                      ToolTip.Tip="Check GitHub for a newer release">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.refresh}" /><TextBlock Text="Check for updates" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Cross-platform client for the Chameleon Ultra, built with Avalonia. Device, firmware and protocol documentation: github.com/RfidResearchGroup/ChameleonUltra" />
          <SelectableTextBlock Classes="caption" TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                               Text="{x:Static vm:SettingsViewModel.TrademarkNotice}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
