<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:svc="using:ChameLab.Services"
             xmlns:c="using:ChameLab.Controls"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:conv="using:ChameLab.Converters"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- One setting: icon, title + description, and its control (SettingRow stacks them when narrow). -->
    <Style Selector=":is(Control).setting > :is(Control).control">
      <Setter Property="Width" Value="220" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=".compact :is(Control).setting > :is(Control).control">
      <Setter Property="Width" Value="160" />
    </Style>
    <!-- Stacked (narrow) rows: a slimmer control leaves the description room. -->
    <Style Selector=":is(Control).setting.stacked > :is(Control).control">
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector=":is(Control).setting.stacked > NumericUpDown.control, :is(Control).setting.stacked > TextBox.control">
      <Setter Property="Width" Value="116" />
    </Style>
    <!-- Link buttons short of room: icon only (the tooltip has the address). ActionRow marks the
         item containers, so the generic ActionRow styles do not reach the buttons inside. The
         containers' logical parent is the ItemsControl, not the ActionRow that lays them out. -->
    <Style Selector="ItemsControl.links > ContentPresenter.iconic > Button > StackPanel > TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl.links > ContentPresenter" x:DataType="vm:SocialLink">
      <Setter Property="c:ActionRow.Priority" Value="{Binding Priority}" />
    </Style>
    <!-- The support link's heart in the accent color; its label stays as it is. -->
    <Style Selector="ItemsControl.links PathIcon.accent">
      <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
    </Style>
    <Style Selector="ItemsControl.links > ContentPresenter.iconic > Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Separator.row">
      <Setter Property="Margin" Value="0,14" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Classes="page" MaxWidth="820">

      <!-- Header -->
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Static loc:Strings.Settings_Settings}" Classes="h1" />
        <TextBlock Classes="caption hint" TextWrapping="Wrap"
                   Text="{x:Static loc:Strings.Settings_AppSettingsTheyApplyRightAway}" />
      </StackPanel>

      <!-- Appearance (app-side, applies immediately) -->
      <Border Classes="card">
        <c:SettingRow Classes="setting">
          <Border Classes="iconwell green">
            <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Accent.Swatch}" />
          </Border>
          <TextBlock Text="{x:Static loc:Strings.Settings_AccentColor}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_ButtonsTogglesAndHighlights}" />
          <ComboBox Classes="control" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:AccentOption">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </c:SettingRow>
      </Border>

      <!-- Language (app-side, applies after a restart) -->
      <Border Classes="card">
        <c:SettingRow Classes="setting">
          <Border Classes="iconwell blue">
            <PathIcon Data="{StaticResource Icon.language}" />
          </Border>
          <TextBlock Text="{x:Static loc:Strings.Settings_Language}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_LanguageCaption}" />
          <ComboBox Classes="control" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:LanguageOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </c:SettingRow>
      </Border>

      <!-- Scan feedback (app-side, applies immediately) -->
      <Border Classes="card">
        <StackPanel>
          <c:SettingRow Classes="setting">
            <Border Classes="iconwell amber">
              <PathIcon Data="{StaticResource Icon.volume}" />
            </Border>
            <TextBlock Text="{x:Static loc:Strings.Settings_ScanSounds}" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_BeepWhenAScanFinishesBuzz}" />
            <ToggleSwitch VerticalAlignment="Center" OnContent="" OffContent=""
                          IsChecked="{Binding ScanSound}" />
          </c:SettingRow>

          <Separator Classes="row" IsVisible="{Binding CanVibrate}" />

          <c:SettingRow Classes="setting" IsVisible="{Binding CanVibrate}">
            <Border Classes="iconwell amber">
              <PathIcon Data="{StaticResource Icon.vibrate}" />
            </Border>
            <TextBlock Text="{x:Static loc:Strings.Settings_Vibration}" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_VibrateWhenACardScanOr}" />
            <ToggleSwitch VerticalAlignment="Center" OnContent="" OffContent=""
                          IsChecked="{Binding ScanVibration}" />
          </c:SettingRow>
        </StackPanel>
      </Border>

      <!-- Device sync: this device's group, adding and removing devices, deleted items. -->
      <Border Classes="card" DataContext="{Binding Sync}" x:DataType="vm:SyncViewModel">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="iconwell green"><PathIcon Data="{StaticResource Icon.sync}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Sync_Title}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static loc:Strings.Sync_Caption}" IsVisible="{Binding IsOff}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}" IsVisible="{Binding IsEnabled}" />
            </StackPanel>
          </Grid>

          <!-- Not in a group: start one, or join the group of another device. -->
          <StackPanel Spacing="10" IsVisible="{Binding IsOff}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="{x:Static loc:Strings.Sync_DeviceName}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding DeviceName}" MaxLength="64" MaxWidth="320" HorizontalAlignment="Left" MinWidth="200" />
            </Grid>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="accent" Command="{Binding CreateCommand}" ToolTip.Tip="{x:Static loc:Strings.Sync_StartTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.sync}" /><TextBlock Text="{x:Static loc:Strings.Sync_Start}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ShowJoinCommand}" ToolTip.Tip="{x:Static loc:Strings.Sync_JoinTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.link}" /><TextBlock Text="{x:Static loc:Strings.Sync_Join}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <StackPanel Spacing="8" IsVisible="{Binding IsJoinOpen}" b:BringIntoViewOnShow.IsEnabled="True">
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static loc:Strings.Sync_JoinHint}" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <TextBox Text="{Binding JoinCode}" PlaceholderText="DE1-ABCD-1234" MinWidth="200" IsEnabled="{Binding !IsJoining}" />
                <Button Classes="accent" Content="{x:Static loc:Strings.Sync_Connect}" Command="{Binding JoinCommand}" />
                <Button Command="{Binding ScanJoinCommand}" IsVisible="{Binding HasQrCamera}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.qrcode}" /><TextBlock Text="{x:Static loc:Strings.Sync_ScanQr}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelJoinCommand}" IsVisible="{Binding IsJoining}" />
              </WrapPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding JoinStatus}"
                         IsVisible="{Binding JoinStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>

          <!-- In a group. -->
          <StackPanel Spacing="10" IsVisible="{Binding IsEnabled}">
            <TextBlock Text="{x:Static loc:Strings.Sync_Devices}" Classes="overline" />
            <ItemsControl ItemsSource="{Binding Members}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SyncMemberViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#3FB950" IsVisible="{Binding IsOnline}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="Gray" Opacity="0.5" IsVisible="{Binding !IsOnline}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Status}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon small" IsVisible="{Binding CanRemove}"
                            ToolTip.Tip="{x:Static loc:Strings.Sync_RemoveDevice}">
                      <PathIcon Data="{StaticResource Icon.remove}" />
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                          <StackPanel Spacing="8" MaxWidth="280">
                            <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.Sync_RemoveDeviceConfirm}" />
                            <Button Classes="danger" HorizontalAlignment="Right" Content="{x:Static loc:Strings.Sync_RemoveDevice}"
                                    Command="{Binding RemoveCommand}" CommandParameter="{Binding Id}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="accent" Command="{Binding AddDeviceCommand}" ToolTip.Tip="{x:Static loc:Strings.Sync_AddDeviceTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.add}" /><TextBlock Text="{x:Static loc:Strings.Sync_AddDevice}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <!-- Adding a device: the QR code and the code to type, then who asks to join. -->
            <Border Classes="inset" Padding="12" IsVisible="{Binding IsInviting}" b:BringIntoViewOnShow.IsEnabled="True">
              <StackPanel Spacing="10">
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static loc:Strings.Sync_InviteHint}" />
                <c:QrCodeView Text="{Binding InviteQr}" HorizontalAlignment="Center" MaxWidth="260"
                              IsVisible="{Binding InviteQr, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <SelectableTextBlock Text="{Binding InviteCode}" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                                     FontFamily="{x:Static c:AppFonts.Mono}"
                                     IsVisible="{Binding InviteCode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding InviteStatus}" HorizontalAlignment="Center" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button Classes="accent" Content="{x:Static loc:Strings.Sync_Accept}" Command="{Binding AcceptCommand}" IsVisible="{Binding IsDeciding}" />
                  <Button Content="{x:Static loc:Strings.Sync_Decline}" Command="{Binding DeclineCommand}" IsVisible="{Binding IsDeciding}" />
                  <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelInviteCommand}" IsVisible="{Binding !IsDeciding}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Separator Classes="row" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Text="{x:Static loc:Strings.Sync_DeviceName}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding DeviceName}" MaxLength="64" />
              <Button Grid.Column="2" Content="{x:Static loc:Strings.Common_Rename}" Command="{Binding RenameCommand}" />
            </Grid>

            <!-- Desktop: keep syncing with the window closed, and start with the system. -->
            <StackPanel Spacing="10" IsVisible="{x:Static vm:SyncViewModel.IsDesktop}">
              <c:SettingRow Classes="setting">
                <Border Classes="iconwell blue"><PathIcon Data="{StaticResource Icon.sync}" /></Border>
                <TextBlock Text="{x:Static loc:Strings.Sync_Background}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{x:Static loc:Strings.Sync_BackgroundCaption}" />
                <ToggleSwitch VerticalAlignment="Center" OnContent="" OffContent="" IsChecked="{Binding RunInBackground}" />
              </c:SettingRow>
              <c:SettingRow Classes="setting">
                <Border Classes="iconwell blue"><PathIcon Data="{StaticResource Icon.power}" /></Border>
                <TextBlock Text="{x:Static loc:Strings.Sync_StartWithSystem}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{x:Static loc:Strings.Sync_StartWithSystemCaption}" />
                <ToggleSwitch VerticalAlignment="Center" OnContent="" OffContent="" IsChecked="{Binding StartWithSystem}" />
              </c:SettingRow>
            </StackPanel>

            <!-- Deleted cards and dictionaries, newest first, to bring back. -->
            <Expander IsVisible="{Binding HasDeleted}" HorizontalAlignment="Stretch">
              <Expander.Header>
                <TextBlock Text="{x:Static loc:Strings.Sync_RecentlyDeleted}" />
              </Expander.Header>
              <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding DeletedCards}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SyncDeletedViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2">
                        <PathIcon Data="{StaticResource Icon.card}" Width="14" Height="14" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding When}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{x:Static loc:Strings.Sync_Restore}" Command="{Binding RestoreCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding DeletedDictionaries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SyncDeletedViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2">
                        <PathIcon Data="{StaticResource Icon.key}" Width="14" Height="14" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding When}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{x:Static loc:Strings.Sync_Restore}" Command="{Binding RestoreCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>

            <Button HorizontalAlignment="Left" ToolTip.Tip="{x:Static loc:Strings.Sync_LeaveTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.close}" /><TextBlock Text="{x:Static loc:Strings.Sync_Leave}" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                  <StackPanel Spacing="8" MaxWidth="300">
                    <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.Sync_LeaveConfirm}" />
                    <Button Classes="danger" HorizontalAlignment="Right" Content="{x:Static loc:Strings.Sync_Leave}" Command="{Binding LeaveCommand}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Backup -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="iconwell blue"><PathIcon Data="{StaticResource Icon.save}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Settings_Backup}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static loc:Strings.Settings_ExportOrImportYourSavedCards}" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding ExportBackupCommand}" IsEnabled="{Binding CanUseFiles}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.export}" /><TextBlock Text="{x:Static loc:Strings.Common_Export}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ImportBackupCommand}" IsEnabled="{Binding CanUseFiles}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.import}" /><TextBlock Text="{x:Static loc:Strings.Common_Import}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="iconwell green"><PathIcon Data="{StaticResource Icon.info}" /></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="ChameLab" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{Binding AppVersion, StringFormat={x:Static loc:Strings.Settings_Version}}" />
            </StackPanel>
          </StackPanel>
          <!-- App update check: the web app is always current, so it has none. -->
          <!-- The status gets the full width; the buttons wrap under each other on a narrow screen. -->
          <StackPanel Spacing="8" IsVisible="{Binding AppUpdate.IsSupported}">
            <c:SettingRow Classes="setting">
              <Border Classes="iconwell blue"><PathIcon Data="{StaticResource Icon.upload}" /></Border>
              <TextBlock Text="{x:Static loc:Strings.Settings_UpdateChannel}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Settings_UpdateChannelCaption}" />
              <ComboBox Classes="control" ItemsSource="{Binding AppUpdate.Channels}" SelectedItem="{Binding AppUpdate.Channel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:UpdateChannelOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </c:SettingRow>
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding AppUpdate.Message}"
                       IsVisible="{Binding AppUpdate.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="accent" Content="{x:Static loc:Strings.Settings_Download}" Command="{Binding AppUpdate.OpenDownloadCommand}"
                      IsVisible="{Binding AppUpdate.IsUpdateAvailable}" ToolTip.Tip="{x:Static loc:Strings.Settings_OpenTheReleasePage}" />
              <Button Command="{Binding AppUpdate.CheckCommand}"
                      ToolTip.Tip="{x:Static loc:Strings.Common_CheckGitHubForANewerRelease}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.refresh}" /><TextBlock Text="{x:Static loc:Strings.Settings_CheckForUpdates}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{x:Static loc:Strings.Settings_CrossPlatformClientForTheChameleon}" />
          <!-- The website, the support page (Boosty in the Russian UI, Patreon elsewhere; not in
               store copies), then community channels: Telegram and MAX in the Russian UI, Discord
               everywhere else. Short of room, they drop their labels by priority: MAX first, then
               Discord, Telegram, the website, and the support page last. -->
          <ItemsControl Classes="links" ItemsSource="{Binding SocialLinks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><c:ActionRow /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SocialLink">
                <Button Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).OpenLinkCommand}"
                        CommandParameter="{Binding Url}" ToolTip.Tip="{Binding Url}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconGeometryConverter.Instance}}" Classes.accent="{Binding Accent}" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <SelectableTextBlock Classes="caption" TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                               Text="{x:Static vm:SettingsViewModel.TrademarkNotice}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
