<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:c="using:ChameLab.Controls"
             xmlns:conv="using:ChameLab.Converters"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="ChameLab.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Grid x:Name="Root" RowDefinitions="Auto,*">

    <!-- ==================== Top app bar ==================== -->
    <Border Grid.Row="0" Padding="10,8,12,8" Background="{actipro:ThemeResource Container1BackgroundBrush}"
            BorderBrush="{actipro:ThemeResource Container1BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <Button Grid.Column="0" Classes="icon" Command="{Binding TogglePaneCommand}"
                IsVisible="{Binding HasNavigation}" ToolTip.Tip="Toggle navigation" Margin="0,0,6,0">
          <PathIcon Data="{StaticResource Icon.menu}" />
        </Button>

        <!-- Brand mark: the device itself. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    Margin="4,0,0,0">
          <Image Source="/Assets/chameleon-ultra.png" Height="36"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel VerticalAlignment="Center" Spacing="-2">
            <TextBlock Text="ChameLab" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="FOR CHAMELEON ULTRA" Classes="overline wide-only" />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Column="2" Classes="caption wide-only" Text="{Binding DeviceSummary}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0" />

        <!-- A newer ChameLab is out: opens its release page. -->
        <Button Grid.Column="3" Classes="accent" Margin="0,0,8,0" VerticalAlignment="Center"
                Command="{Binding AppUpdate.OpenReleaseCommand}" IsVisible="{Binding AppUpdate.IsUpdateAvailable}"
                ToolTip.Tip="{Binding AppUpdate.Message}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.upload}" />
            <TextBlock Text="Update" Classes="wide-only" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Connection pill -->
        <Border Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0"
                CornerRadius="12" Padding="10,4"
                Background="{actipro:ThemeResource Container2BackgroundBrush}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{actipro:ThemeResource ControlBackgroundBrushSolidSuccess}" IsVisible="{Binding IsConnected}" />
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{actipro:ThemeResource DefaultForegroundBrushTertiary}" IsVisible="{Binding !IsConnected}" />
            <TextBlock Text="Online" FontSize="12" IsVisible="{Binding IsConnected}" VerticalAlignment="Center" />
            <TextBlock Text="Offline" FontSize="12" IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <actipro:ToggleThemeButton Grid.Column="5" Margin="0,0,6,0" VerticalAlignment="Center"
                                   ToolTip.Tip="Toggle light / dark theme" />

        <Button Grid.Column="6" Classes="danger" Command="{Binding DisconnectCommand}"
                IsVisible="{Binding IsConnected}" ToolTip.Tip="Disconnect from the device">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.power}" />
            <TextBlock Text="Disconnect" Classes="wide-only" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ==================== Body ==================== -->
    <SplitView Grid.Row="1" x:Name="Shell"
               IsPaneOpen="{Binding IsPaneOpen}"
               DisplayMode="Inline" OpenPaneLength="260" CompactPaneLength="0"
               PaneBackground="{actipro:ThemeResource Container1BackgroundBrush}">

      <SplitView.Pane>
        <!-- As wide as the open pane even while it slides open or shut, so it is cut off instead of
             laid out again (rewrapping the folder names) at every step. -->
        <Panel ClipToBounds="True">
          <Border BorderBrush="{actipro:ThemeResource Container1BorderBrush}" BorderThickness="0,0,1,0"
                  Width="{Binding #Shell.OpenPaneLength}" HorizontalAlignment="Left">
            <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding HasNavigation}">
              <TextBlock Grid.Row="0" Text="NAVIGATION" Classes="overline" Margin="20,18,0,6" />

              <!-- The pages, with the card folders (one level) indented under Cards. Cards are dragged
                   onto a folder, or onto Cards to take them out of theirs (see ListReorder). -->
              <!-- Scrolls only up and down: long folder names are trimmed, never scrolled to. -->
              <ListBox Grid.Row="1" Classes="nav" Margin="10,0" ItemsSource="{Binding NavItems}"
                       SelectedItem="{Binding SelectedNavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.DataTemplates>
                  <!-- Cards, with + for a new folder (before the general page template, which would match too). -->
                  <DataTemplate DataType="vm:CardsViewModel">
                    <Border Classes="navrow" b:ListReorder.IsDropTarget="True">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="40">
                        <Border Grid.Column="0" Classes="navbar" Margin="0,0,9,0"
                                Opacity="{Binding $parent[ListBoxItem].IsSelected, Converter={x:Static conv:BoolToOpacityConverter.Instance}}" />
                        <PathIcon Grid.Column="1" Width="18" Height="18" Margin="0,0,12,0"
                                  Data="{Binding Icon, Converter={x:Static conv:IconGeometryConverter.Instance}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" />
                        <Button Grid.Column="3" Classes="icon small" Margin="0,0,4,0" Command="{Binding NewFolderCommand}"
                                ToolTip.Tip="New card folder">
                          <PathIcon Data="{StaticResource Icon.add}" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>

                  <DataTemplate DataType="vm:PageViewModelBase">
                    <Border Classes="navrow" b:ListReorder.IsDropTarget="True">
                      <Grid ColumnDefinitions="Auto,Auto,*" Height="40">
                        <Border Grid.Column="0" Classes="navbar" Margin="0,0,9,0"
                                Opacity="{Binding $parent[ListBoxItem].IsSelected, Converter={x:Static conv:BoolToOpacityConverter.Instance}}" />
                        <PathIcon Grid.Column="1" Width="18" Height="18" Margin="0,0,12,0"
                                  Data="{Binding Icon, Converter={x:Static conv:IconGeometryConverter.Instance}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" FontSize="14" />
                      </Grid>
                    </Border>
                  </DataTemplate>

                  <DataTemplate DataType="vm:CardFolderViewModel">
                    <Border Classes="navrow" b:ListReorder.IsDropTarget="True">
                      <Grid Classes="folderrow" Classes.empty="{Binding IsEmpty}"
                            ColumnDefinitions="Auto,Auto,*,Auto" MinHeight="32">
                        <Grid.ContextFlyout>
                          <MenuFlyout>
                            <MenuItem Header="Rename" Command="{Binding RenameCommand}" />
                            <MenuItem Header="Delete folder" Command="{Binding DeleteCommand}"
                                      ToolTip.Tip="Its cards stay in Cards" />
                          </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Border Grid.Column="0" Classes="navbar" Margin="0,0,9,0"
                                Opacity="{Binding $parent[ListBoxItem].IsSelected, Converter={x:Static conv:BoolToOpacityConverter.Instance}}" />
                        <!-- Indented under Cards. -->
                        <PathIcon Grid.Column="1" Classes="foldericon" Width="15" Height="15" Margin="22,0,10,0"
                                  Data="{StaticResource Icon.folder}" />
                        <!-- A transparent box around the name, so its tooltip shows over the whole cell, not just the glyphs. -->
                        <Border Grid.Column="2" Classes="foldername" Background="Transparent" ToolTip.Tip="{Binding Name}"
                                IsVisible="{Binding !IsEditing}">
                          <!-- Long names wrap onto a second line, tightly spaced, then trim. -->
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Margin="0,4"
                                     TextWrapping="Wrap" MaxLines="2" LineSpacing="-2" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Grid.Column="3" Classes="caption foldercount" Text="{Binding Count}"
                                   VerticalAlignment="Center" Margin="8,0,10,0" IsVisible="{Binding !IsEditing}" />
                        <!-- On hover (and on the open folder) the folder's actions, over the end of the name and the
                             count: the name keeps its width, so it doesn't rewrap as they come and go. -->
                        <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Classes="folderactions" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="4,0,2,0" IsVisible="{Binding !IsEditing}">
                          <Button Classes="icon small" Command="{Binding RenameCommand}" ToolTip.Tip="Rename folder">
                            <PathIcon Data="{StaticResource Icon.edit}" />
                          </Button>
                          <Button Classes="icon small" ToolTip.Tip="Delete folder">
                            <PathIcon Data="{StaticResource Icon.delete}" />
                            <Button.Flyout>
                              <Flyout Placement="RightEdgeAlignedTop">
                                <StackPanel Spacing="12" MaxWidth="280" Margin="16,14">
                                  <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                             Text="{Binding Name, StringFormat='Delete the folder {0}?'}" />
                                  <TextBlock Classes="caption" TextWrapping="Wrap"
                                             Text="Its cards are not deleted: they go back to Cards." />
                                  <Button Classes="danger solid" Content="Delete folder" HorizontalAlignment="Right"
                                          Click="OnFolderDeleteClick" />
                                </StackPanel>
                              </Flyout>
                            </Button.Flyout>
                          </Button>
                        </StackPanel>
                        <TextBox Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding EditName}" MaxLength="64"
                                 MinHeight="0" Padding="6,3" Margin="-7,0,4,0" VerticalAlignment="Center" FontSize="13"
                                 IsVisible="{Binding IsEditing}" b:FocusOnShow.IsEnabled="True"
                                 KeyDown="OnFolderNameKeyDown" LostFocus="OnFolderNameLostFocus" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.DataTemplates>
              </ListBox>

              <!-- Single trimmed lines: wrapped text would change the height while the pane animates its width. -->
              <Border Grid.Row="2" Classes="inset" Margin="12,8,12,14">
                <StackPanel Spacing="2">
                  <TextBlock Text="CONNECTED DEVICE" Classes="overline" IsVisible="{Binding !IsOffline}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="OFFLINE MODE" Classes="overline" IsVisible="{Binding IsOffline}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DeviceSummary}" FontSize="12" IsVisible="{Binding !IsOffline}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding DeviceSummary}" />
                  <TextBlock FontSize="12" IsVisible="{Binding IsOffline}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             Text="No device attached" ToolTip.Tip="No device. Open Connect to attach one." />
                  <!-- A newer release shows as a compact Update link beside the version. -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                               Text="{Binding Settings.AppVersion, StringFormat='ChameLab {0}'}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Classes="accent" Padding="8,1" MinHeight="0" FontSize="11"
                            VerticalAlignment="Center" Content="Update"
                            Command="{Binding AppUpdate.OpenReleaseCommand}" IsVisible="{Binding AppUpdate.IsUpdateAvailable}"
                            ToolTip.Tip="{Binding AppUpdate.Message}" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Panel>
      </SplitView.Pane>

      <SplitView.Content>
        <Panel>
          <TransitioningContentControl Content="{Binding CurrentPage}">
            <TransitioningContentControl.PageTransition>
              <CrossFade Duration="0:0:0.15" />
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>

          <!-- Thin activity bar while the current page talks to the device. -->
          <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" Height="3" MinHeight="3"
                       CornerRadius="0" Foreground="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" Background="Transparent"
                       IsVisible="{Binding CurrentPage.IsBusy}" />

          <!-- Status banner for the current page (errors stay until dismissed). -->
          <Border Classes="banner" Classes.error="{Binding CurrentPage.StatusIsError}"
                  VerticalAlignment="Bottom" HorizontalAlignment="Center"
                  Margin="16,0,16,18" MaxWidth="640"
                  IsVisible="{Binding CurrentPage.Status, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Panel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                <PathIcon Classes="state" Width="18" Height="18" Data="{StaticResource Icon.success}"
                          IsVisible="{Binding !CurrentPage.StatusIsError}" />
                <PathIcon Classes="state" Width="18" Height="18" Data="{StaticResource Icon.error}"
                          IsVisible="{Binding CurrentPage.StatusIsError}" />
              </Panel>
              <SelectableTextBlock Grid.Column="1" Text="{Binding CurrentPage.Status}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="icon small" Margin="8,0,0,0" ToolTip.Tip="Dismiss"
                      Command="{Binding CurrentPage.DismissStatusCommand}">
                <PathIcon Data="{StaticResource Icon.close}" />
              </Button>
            </Grid>
          </Border>
        </Panel>
      </SplitView.Content>
    </SplitView>

    <!-- ==================== Firmware install dialog ==================== -->
    <!-- Over the whole shell: the device disconnects while it restarts into the bootloader. -->
    <Panel Grid.Row="0" Grid.RowSpan="2" Background="#80000000"
           DataContext="{Binding Firmware}" IsVisible="{Binding IsDialogOpen}" x:DataType="vm:FirmwareUpdateViewModel">
      <!-- Stretched up to MaxWidth (and centered there), so the width doesn't follow the step text. -->
      <Border Classes="card" MaxWidth="520" Margin="16" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding InstallTitle}" Classes="h2" TextWrapping="Wrap" />

          <!-- Confirm -->
          <StackPanel Spacing="10" IsVisible="{Binding IsConfirming}">
            <TextBlock TextWrapping="Wrap" Text="{Binding InstallHint}" />
            <Border Classes="inset" Padding="0" IsVisible="{Binding InstallNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <ScrollViewer MaxHeight="260" Padding="14,10">
                <c:MarkdownView Markdown="{Binding InstallNotes}" TextElement.FontSize="12" />
              </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" Command="{Binding CloseCommand}" b:DialogKeys.IsCancel="True" />
              <Button Classes="accent" Content="Install" Command="{Binding ConfirmCommand}" b:DialogKeys.IsDefault="True" />
            </StackPanel>
          </StackPanel>

          <!-- Installing -->
          <StackPanel Spacing="10" IsVisible="{Binding IsInstalling}">
            <TextBlock Text="{Binding StepText}" TextWrapping="Wrap" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                         IsIndeterminate="{Binding !ProgressKnown}" />
            <TextBlock Classes="caption" Text="{Binding KeepConnectedHint}" />
          </StackPanel>

          <!-- Done -->
          <StackPanel Spacing="10" IsVisible="{Binding IsDone}">
            <TextBlock Text="{Binding StepText}" TextWrapping="Wrap" />
            <Button Classes="accent" Content="Close" HorizontalAlignment="Right" Command="{Binding CloseCommand}"
                    b:DialogKeys.IsDefault="True" b:DialogKeys.IsCancel="True" />
          </StackPanel>

          <!-- Failed -->
          <StackPanel Spacing="10" IsVisible="{Binding IsFailed}">
            <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding CanRetry}"
                       Text="If the device stays in its bootloader (LEDs 4 and 5 blink), Retry installs the firmware again." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Close" Command="{Binding CloseCommand}" b:DialogKeys.IsCancel="True" />
              <Button Classes="accent" Content="Retry" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}"
                      b:DialogKeys.IsDefault="True" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- ==================== Exit hint ==================== -->
    <!-- After Back on the start page; a second Back within a moment closes the app. -->
    <Border Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="16,0,16,24" Padding="16,9" CornerRadius="18" IsHitTestVisible="False"
            Background="{actipro:ThemeResource Container3BackgroundBrush}"
            BorderBrush="{actipro:ThemeResource Container3BorderBrush}" BorderThickness="1"
            BoxShadow="0 6 18 0 #40000000" IsVisible="{Binding IsExitHintVisible}">
      <TextBlock Text="Press Back again to exit" FontSize="13" />
    </Border>
  </Grid>
</UserControl>
