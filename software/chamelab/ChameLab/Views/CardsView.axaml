<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:conv="using:ChameLab.Converters"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:c="using:ChameLab.Controls"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Views.CardsView"
             x:DataType="vm:CardsViewModel">

  <UserControl.Styles>
    <!-- Wide: list on the left, add / edit pane on the right (SplitLayout sizes the column).
         Narrow ("single"): one at a time. -->
    <Style Selector="Grid.cardsplit > :is(Control).detailpane">
      <!-- Column is set here, not on the element, so the single style can move it. -->
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="18,0,0,0" />
    </Style>
    <!-- Both panes share the star column; the Auto column would let the pane grow unbounded. -->
    <Style Selector="Grid.cardsplit.single > :is(Control).detailpane">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Grid.cardsplit.single.open > :is(Control).listpane">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.cardsplit.single:not(.open) > :is(Control).detailpane">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.backonly">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.cardsplit.single Button.backonly">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Compact source tiles in the add pane: icon beside a label and a one-line hint. -->
    <Style Selector="Button.tile.source">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.tile.source Border.iconwell">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.tile.source Border.iconwell > PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
    </Style>
    <!-- Palette flyout: breathing room between the swatches and the flyout edge. -->
    <Style Selector="ListBox.swatches">
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="ListBox.swatches ListBoxItem">
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="ListBox.swatches ListBoxItem:selected Border.swatch">
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="2.5" />
    </Style>
    <!-- Header color strip: opens the palette. -->
    <Style Selector="Button.colorpick">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.colorpick > Border">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.colorpick:pointerover > Border">
      <Setter Property="BorderBrush" Value="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- Header name: reads as a title, turns into a field on hover / focus. -->
    <Style Selector="TextBox.titlebox">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="-7,0,0,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- The open folder's title being renamed: as big as the title it replaces. -->
    <Style Selector="TextBox.titlebox.foldertitle">
      <Setter Property="FontSize" Value="24" />
      <!-- Frame and padding outside the text (border 1 + padding), so the letters stay where the title's were. -->
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="-7,-3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.renaming > TextBlock.h1">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="TextBox.titlebox:pointerover">
      <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
    </Style>
    <Style Selector="TextBox.titlebox:focus-within">
      <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
    </Style>
    <!-- Frequency filter beside the combos: shorter than they are, then stretched to their height,
         so it never makes the row (and the combos) taller. -->
    <Style Selector="Border.segmented.filter">
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.segmented.filter RadioButton.segment /template/ Border#PART_Bg">
      <Setter Property="Padding" Value="9,0" />
    </Style>
    <!-- The card being dragged into place. -->
    <Style Selector="ListBox.cards ListBoxItem.dragging">
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <!-- Shadow only below and to the sides; the list leaves room for it (see ListScroll). -->
    <Style Selector="ListBox.cards ListBoxItem.dragging Border.cardrow">
      <Setter Property="BoxShadow" Value="0 4 14 -2 #80000000" />
    </Style>
    <!-- The item and its presenter must not clip the shadow. -->
    <Style Selector="ListBox.cards ListBoxItem.dragging">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem.dragging /template/ ContentPresenter">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <!-- Thick frame drawn over the row's own edge, inwards, so the tile keeps its size. -->
    <Style Selector="Border.dragframe">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem.dragging Border.dragframe">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.slottarget">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <!-- Card actions short of room: icon only (the tooltip names the action). Only the label in the
         button's content: a plain descendant selector would also blank the tooltip's text. -->
    <Style Selector="c|ActionRow > :is(Control).iconic > StackPanel > TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <!-- 600 is what the memory editor needs for 16 bytes per line plus the ASCII column.
       The list needs 400 so the card type filter keeps room beside the band toggle and sort. -->
  <Grid Classes="page cardsplit" ColumnDefinitions="*,Auto" Classes.open="{Binding HasPane}"
        b:SplitLayout.DetailWidth="460,600" b:SplitLayout.ListMinWidth="400">

    <!-- ==================== Card list ==================== -->
    <!-- Always usable (leaving unsaved work asks first), except while a write to a tag runs. -->
    <Grid Grid.Column="0" Classes="listpane panestack" RowDefinitions="Auto,*"
          IsEnabled="{Binding !ListLocked}">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
        <!-- Back from a folder to Cards, also when the navigation pane is hidden (narrow, or closed). -->
        <Button Grid.Column="0" Classes="icon" Margin="-8,0,6,0" VerticalAlignment="Center"
                IsVisible="{Binding IsInFolder}" Command="{Binding ShowRootCommand}"
                ToolTip.Tip="{x:Static loc:Strings.Cards_BackToCards}" b:DialogKeys.IsBack="True">
          <PathIcon Data="{StaticResource Icon.back}" />
        </Button>
        <!-- Short of room, the buttons drop their labels (Add card last); then the title trims. -->
        <c:TitleRow Grid.Column="1">
        <StackPanel Spacing="2">
          <!-- A folder's title, renamed in place (Rename beside Add card). -->
          <!-- Renaming: the title stays, unseen, so the header keeps its size; the field lies over it. -->
          <Panel Classes.renaming="{Binding IsRenamingFolder}">
            <TextBlock Text="{Binding ListTitle}" Classes="h1" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ListTitle}" />
            <TextBox Classes="titlebox foldertitle" Text="{Binding FolderRenameText}" MaxLength="64"
                     IsVisible="{Binding IsRenamingFolder}" b:FocusOnShow.IsEnabled="True"
                     KeyDown="OnFolderTitleKeyDown" LostFocus="OnFolderTitleLostFocus" />
          </Panel>
          <TextBlock Classes="caption" Text="{Binding CountText}" />
        </StackPanel>
        <!-- The open folder's Rename and Delete; short of room Delete drops its label first, then Rename.
             New folder only in Cards: folders are one level. -->
        <c:ActionRow>
          <Button Command="{Binding RenameCurrentFolderCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_RenameFolder}"
                  IsVisible="{Binding IsInFolder}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.edit}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Rename}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="danger" ToolTip.Tip="{x:Static loc:Strings.Common_DeleteFolder}"
                  IsVisible="{Binding IsInFolder}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.delete}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Delete}" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="12" MaxWidth="280" Margin="16,14">
                  <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                             Text="{Binding ListTitle, StringFormat={x:Static loc:Strings.Common_DeleteFolderPrompt}}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{x:Static loc:Strings.Common_ItsCardsAreNotDeletedThey}" />
                  <Button Classes="danger solid" Content="{x:Static loc:Strings.Common_DeleteFolder}" HorizontalAlignment="Right"
                          Click="OnFolderDeleteClick" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Command="{Binding OpenNewFolderCommand}" IsVisible="{Binding !IsInFolder}"
                  ToolTip.Tip="{x:Static loc:Strings.Common_NewFolder}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.folderAdd}" />
              <TextBlock Text="{x:Static loc:Strings.Common_NewFolder}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding AddCommand}" c:ActionRow.Priority="1"
                  ToolTip.Tip="{x:Static loc:Strings.Cards_ScanImportOrEnterANew}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.add}" />
              <TextBlock Text="{x:Static loc:Strings.Common_AddCard}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </c:ActionRow>
        </c:TitleRow>
      </Grid>

      <!-- Under the title everything scrolls together once the window is too short for the list's
           minimum; until then the list fills the rest and scrolls on its own. The scroller reaches past
           the column like the list does, so a dragged card's shadow is not clipped. -->
      <ScrollViewer Grid.Row="1" Name="ListPaneScroll" Margin="-12,0,-12,-16" HorizontalScrollBarVisibility="Disabled">
        <c:FillStack Classes="panestack" Margin="12,0,12,16">
          <StackPanel Spacing="8" IsVisible="{Binding !IsEmpty}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding Filter}" PlaceholderText="{x:Static loc:Strings.Common_SearchByNameTypeOrUID}">
                <TextBox.InnerLeftContent>
                  <PathIcon Data="{StaticResource Icon.search}" Width="16" Height="16" Margin="10,0,2,0" Opacity="0.6" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <Button Grid.Column="1" Classes="icon" Command="{Binding ResetFiltersCommand}"
                      VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.Cards_ClearSearchAndFilters}">
                <PathIcon Data="{StaticResource Icon.close}" />
              </Button>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Border Grid.Column="0" Classes="segmented filter">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="CardBand" IsChecked="{Binding IsBandAll}"
                               ToolTip.Tip="{x:Static loc:Strings.Cards_CardsOfBothFrequencies}">
                    <TextBlock Text="{x:Static loc:Strings.Cards_All}" FontWeight="SemiBold" />
                  </RadioButton>
                  <RadioButton Classes="segment" GroupName="CardBand" IsChecked="{Binding IsBandHf}"
                               ToolTip.Tip="{x:Static loc:Strings.Cards_1356MHzCardsOnly}">
                    <TextBlock Text="HF" FontWeight="SemiBold" />
                  </RadioButton>
                  <RadioButton Classes="segment" GroupName="CardBand" IsChecked="{Binding IsBandLf}"
                               ToolTip.Tip="{x:Static loc:Strings.Cards_125KHzCardsOnly}">
                    <TextBlock Text="LF" FontWeight="SemiBold" />
                  </RadioButton>
                </StackPanel>
              </Border>
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}"
                        ToolTip.Tip="{x:Static loc:Strings.Cards_CardType}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CardTypeOption">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="2" ItemsSource="{Binding SortModes}" SelectedItem="{Binding Sort}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static loc:Strings.Cards_OrderOfTheListInManual}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </StackPanel>
          <Panel c:FillStack.Fill="True" MinHeight="180">
          <!-- Empty library -->
          <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
            <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,12">
              <PathIcon Data="{StaticResource Icon.cards}" Width="40" Height="40" Opacity="0.4"
                        HorizontalAlignment="Center" />
              <TextBlock Text="{x:Static loc:Strings.Cards_NoCardsYet}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                         Text="{x:Static loc:Strings.Cards_PressToScanACardImport}" />
            </StackPanel>
          </Border>


          <!-- In manual order the cards can be dragged into place, and in any order onto a folder in
               the navigation pane (see CardsView.axaml.cs). -->
          <!-- Reaches past the column by as much as the list is padded, so the shadow of a
               dragged card is not clipped at the sides and bottom; the cards stay in place. -->
          <ScrollViewer Name="ListScroll" IsVisible="{Binding !IsEmpty}" Margin="-12,0,-12,-16">
            <StackPanel>
              <!-- In the flow above the list, so they never overlap the folder tiles below it. -->
              <TextBlock Classes="caption" Margin="12,0,12,8" Text="{x:Static loc:Strings.Cards_NoCardsMatchTheSearchAnd}"
                         IsVisible="{Binding NoMatches}" />
              <TextBlock Classes="caption" Margin="12,0,12,8" TextWrapping="Wrap" IsVisible="{Binding IsFolderEmpty}"
                         Text="{x:Static loc:Strings.Cards_NoCardsInThisFolderYet}" />
              <ListBox Name="CardList" Classes="cards" ItemsSource="{Binding Cards}" Padding="8,0,8,12"
                       SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CardItemViewModel">
                    <Panel>
                      <Border Classes="cardrow"><Border Classes="cardclip">
                        <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="14">
                          <Border Grid.Column="0" Background="{Binding ColorBrush}" />
                          <StackPanel Grid.Column="1" Margin="0,10" Spacing="0">
                            <c:Marquee><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" /></c:Marquee>
                            <TextBlock Text="{Binding Summary}" Classes="caption" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Panel Grid.Column="2" VerticalAlignment="Center">
                            <Border Classes="chip hf" IsVisible="{Binding IsHf}"><TextBlock Text="HF" /></Border>
                            <Border Classes="chip lf" IsVisible="{Binding IsLf}"><TextBlock Text="LF" /></Border>
                            <Border Classes="chip" IsVisible="{Binding IsUnknownType}"
                                    Background="{actipro:ThemeResource Container3BackgroundBrush}">
                              <TextBlock Text="?" />
                            </Border>
                          </Panel>
                        </Grid>
                      </Border></Border>
                      <Border Classes="dragframe" />
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Cards (no folder open): the folders after its own cards. A tile opens its folder, and cards
                   are dragged onto it like onto a folder in the navigation pane (see ListReorder). -->
              <StackPanel Spacing="4" Margin="8,4,8,12" IsVisible="{Binding ShowsFolderTiles}">
                <TextBlock Text="{x:Static loc:Strings.Cards_FoldersHeader}" Classes="overline" Margin="4,0" />
                <ItemsControl ItemsSource="{Binding Folders}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <c:TileGrid MinItemWidth="280" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CardFolderViewModel">
                      <Button Classes="foldertile" Classes.empty="{Binding IsEmpty}"
                              Command="{Binding OpenCommand}" b:ListReorder.IsDropTarget="True"
                              ToolTip.Tip="{Binding Name}">
                        <Border Classes="cardrow">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="14,8,14,8" MinHeight="36">
                            <PathIcon Grid.Column="0" Classes="foldericon" Width="20" Height="20"
                                      Data="{StaticResource Icon.folder}" />
                            <TextBlock Grid.Column="1" Classes="foldername" Text="{Binding Name}" FontWeight="SemiBold"
                                       FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                       LineSpacing="-2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Classes="caption foldercount" VerticalAlignment="Center"
                                       Text="{Binding CountText}" />
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          </Panel>
        </c:FillStack>
      </ScrollViewer>
    </Grid>

    <!-- ==================== Add / edit pane ==================== -->
    <Grid Classes="detailpane" RowDefinitions="Auto,*,Auto">
      <!-- ===================== Card header + actions (saved or new card; stays in view) ===================== -->
      <!-- Disabled under the lightbox so Tab can't reach it. -->
      <Border Grid.Row="0" Classes="card panehead" IsVisible="{Binding ShowCardHeader}"
              IsEnabled="{Binding !IsAsking}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <Button Grid.Column="0" Classes="icon backonly" Margin="-8,0,6,0"
                    Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_BackToTheList}"
                    b:DialogKeys.IsBack="True">
              <PathIcon Data="{StaticResource Icon.back}" />
            </Button>
            <Button Grid.Column="1" Classes="colorpick" Margin="0,0,12,0" ToolTip.Tip="{x:Static loc:Strings.Cards_CardColor}">
              <Border Background="{Binding Form?.Color, Converter={x:Static conv:HexBrushConverter.Instance}}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ListBox Classes="swatches" ItemsSource="{x:Static vm:CardEditorViewModel.Palette}"
                           SelectedItem="{Binding Form?.Color}" Background="Transparent" BorderThickness="0"
                           Tapped="OnFlyoutPickTapped">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="8" ColumnSpacing="2" RowSpacing="2" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="swatch" Background="{Binding Converter={x:Static conv:HexBrushConverter.Instance}}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Flyout>
              </Button.Flyout>
            </Button>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
              <TextBox Classes="titlebox" Text="{Binding Form?.Name}" MaxLength="64" PlaceholderText="{x:Static loc:Strings.Cards_CardName}" />
              <TextBlock Text="{Binding FormSource}" Classes="caption" TextWrapping="Wrap"
                         IsVisible="{Binding IsEditingNew}" />
              <TextBlock Text="{Binding Selected?.Summary}" Classes="caption" TextWrapping="Wrap"
                         IsVisible="{Binding IsCardOpen}" />
            </StackPanel>
          </Grid>

          <!-- One line; when it gets tight, Delete, Folder, Save keys and Duplicate drop their labels first, then Export,
               then Assign / Write (tooltips name them). -->
          <c:ActionRow IsVisible="{Binding !IsWriteOpen}">
            <Button Command="{Binding DuplicateCommand}" IsVisible="{Binding IsCardOpen}"
                    ToolTip.Tip="{x:Static loc:Strings.Cards_SaveACopyOfThisCard}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.copy}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Duplicate}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- JSON only: a plain button; with a MIFARE Classic dump the dump formats join a menu. -->
            <Button Command="{Binding ExportCommand}" IsEnabled="{Binding CanUseFiles}"
                    IsVisible="{Binding !CanExportDump}" c:ActionRow.Priority="1"
                    ToolTip.Tip="{x:Static loc:Strings.Cards_SaveAsJSONCompatibleWithThe}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.export}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Export}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <DropDownButton IsEnabled="{Binding CanUseFiles}" IsVisible="{Binding CanExportDump}"
                            c:ActionRow.Priority="1" ToolTip.Tip="{x:Static loc:Strings.Cards_SaveTheCardToAFile}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.export}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Export}" VerticalAlignment="Center" />
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="JSON" Command="{Binding ExportCommand}"
                            ToolTip.Tip="{x:Static loc:Strings.Cards_CardFileCompatibleWithTheFlutter}" />
                  <MenuItem Header="{x:Static loc:Strings.Cards_BinDump}" Command="{Binding ExportBinCommand}"
                            ToolTip.Tip="{x:Static loc:Strings.Cards_RawMemoryDumpReadableByMost}" />
                  <MenuItem Header="{x:Static loc:Strings.Cards_EmlDump}" Command="{Binding ExportEmlCommand}"
                            ToolTip.Tip="{x:Static loc:Strings.Cards_Proxmark3EmlDumpHexText}" />
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <!-- The card's known keys (MIFARE Classic A/B, Ultralight EV1 / NTAG password). -->
            <DropDownButton IsVisible="{Binding CanSaveKeys}"
                            ToolTip.Tip="{x:Static loc:Strings.Cards_SaveTheCardsKeys}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.key}" />
                <TextBlock Text="{x:Static loc:Strings.Cards_SaveKeys}" VerticalAlignment="Center" />
              </StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="{x:Static loc:Strings.Cards_KeysToClipboard}" Click="OnCopyKeys">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.copy}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Classes="keystargets" Header="{x:Static loc:Strings.Cards_KeysToDictionary}"
                            IsVisible="{Binding HasKeysTargets}" ItemsSource="{Binding KeysTargets}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.key}" /></MenuItem.Icon>
                    <MenuItem.Styles>
                      <!-- Each dictionary as a compact row (as in the dictionary pickers); a rounded highlight
                           follows the pointer and the arrow keys. -->
                      <Style Selector="MenuItem.keystargets > MenuItem" x:DataType="vm:KeysTargetViewModel">
                        <Setter Property="Command" Value="{Binding SaveCommand}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                          <ControlTemplate>
                            <Border Name="PART_Row" Width="260" Margin="4,0" Padding="8,3" CornerRadius="6"
                                    Background="Transparent" x:DataType="vm:KeysTargetViewModel">
                              <c:DictionaryRow Color="{Binding Item.ColorBrush}" Title="{Binding Item.Name}"
                                               Count="{Binding Item.Dictionary.Count}" />
                            </Border>
                          </ControlTemplate>
                        </Setter>
                      </Style>
                      <Style Selector="MenuItem.keystargets > MenuItem:pointerover /template/ Border#PART_Row, MenuItem.keystargets > MenuItem:selected /template/ Border#PART_Row">
                        <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPointerOver}" />
                      </Style>
                      <Style Selector="MenuItem.keystargets > MenuItem:pressed /template/ Border#PART_Row">
                        <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPressed}" />
                      </Style>
                    </MenuItem.Styles>
                  </MenuItem>
                  <MenuItem Header="{x:Static loc:Strings.Cards_KeysToNewDictionary}"
                            Command="{Binding SaveKeysToNewDictionaryCommand}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.add}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{x:Static loc:Strings.Cards_KeysToFile}" Command="{Binding SaveKeysToFileCommand}"
                            IsEnabled="{Binding CanUseFiles}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.export}" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <Button IsVisible="{Binding IsCardOpen}" ToolTip.Tip="{x:Static loc:Strings.Cards_MoveThisCardToAFolder}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.folder}" />
                <TextBlock Text="{Binding CardFolderLabel}" VerticalAlignment="Center"
                           MaxWidth="140" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <!-- Fixed width: long names wrap onto a second line, tightly spaced, then trim. No folder
                       (back to Cards) stands apart above the folders; one choice across both lists. -->
                  <StackPanel Width="260">
                    <ListBox ItemsSource="{Binding RootFolderOptions}" SelectedItem="{Binding SelectedCardFolder}"
                             Background="Transparent" BorderThickness="0" Tapped="OnFlyoutPickTapped">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CardFolderOption">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.75" VerticalAlignment="Center"
                                      Data="{StaticResource Icon.cards}" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Separator Margin="0,4" IsVisible="{Binding HasFolders}" />
                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                      <ListBox ItemsSource="{Binding FolderOptions}" SelectedItem="{Binding SelectedCardFolder}"
                               Background="Transparent" BorderThickness="0"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled" Tapped="OnFlyoutPickTapped">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:CardFolderOption">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                              <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.75" VerticalAlignment="Center"
                                        Data="{StaticResource Icon.folder}" />
                              <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                         TextWrapping="Wrap" MaxLines="2" LineSpacing="-2"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="caption"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </ScrollViewer>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Command="{Binding AssignCommand}" Classes.accent="{Binding IsSlotsOpen}" c:ActionRow.Priority="2"
                    ToolTip.Tip="{x:Static loc:Strings.Cards_EmulateThisCardInOneOf}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.slots}" />
                <TextBlock Text="{x:Static loc:Strings.Cards_AssignToSlot}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="brandblue" Command="{Binding WriteCommand}" c:ActionRow.Priority="2"
                    ToolTip.Tip="{x:Static loc:Strings.Cards_WriteOntoAT55xxTagLF}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.upload}" />
                <TextBlock Text="{x:Static loc:Strings.Cards_Write}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="danger" Command="{Binding DeleteCommand}" IsVisible="{Binding IsCardOpen}"
                    ToolTip.Tip="{x:Static loc:Strings.Cards_DeleteThisCard}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Delete}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionRow>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="PaneScroll" Grid.Row="1" IsEnabled="{Binding !IsAsking}">
        <StackPanel Classes="panestack">

          <!-- Nothing open (desktop only) -->
          <Border Classes="card" IsVisible="{Binding !HasPane}">
            <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,20">
              <PathIcon Data="{StaticResource Icon.card}" Width="34" Height="34" Opacity="0.4"
                        HorizontalAlignment="Center" />
              <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="280" TextWrapping="Wrap"
                         Text="{x:Static loc:Strings.Cards_SelectACardToEditEmulate}" />
            </StackPanel>
          </Border>

          <!-- ===================== Add a card ===================== -->
          <!-- Choosing a source; once a card is scanned or imported the editor below replaces it. -->
          <Border Classes="card" IsVisible="{Binding IsPickingSource}">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="icon backonly" Margin="-8,0,6,0"
                        Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_BackToTheList}"
                        b:DialogKeys.IsBack="True">
                  <PathIcon Data="{StaticResource Icon.back}" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static loc:Strings.Cards_AddACard}" Classes="h2" />
                  <TextBlock Classes="caption hint" TextWrapping="Wrap"
                             Text="{x:Static loc:Strings.Cards_HoldATagAgainstTheDevice}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.Common_Cancel}" VerticalAlignment="Top">
                  <PathIcon Data="{StaticResource Icon.close}" />
                </Button>
              </Grid>

              <UniformGrid Columns="2" ColumnSpacing="8" RowSpacing="8">
                <Button Classes="tile source" Command="{Binding ScanHfCommand}" IsVisible="{Binding IsConnected}"
                        ToolTip.Tip="{x:Static loc:Strings.Cards_ScanAnISO14443ATagThe}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="iconwell blue" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.scan}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static loc:Strings.Cards_ScanHF}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Static loc:Strings.Cards_1356MHz}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Classes="tile source" Command="{Binding ScanLfCommand}" IsVisible="{Binding IsConnected}"
                        ToolTip.Tip="{x:Static loc:Strings.Cards_ScanA125KHzTagOf}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="iconwell amber" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.scan}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static loc:Strings.Cards_ScanLF}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Static loc:Strings.Common_125KHz}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Classes="tile source" Command="{Binding ImportCommand}" IsEnabled="{Binding CanUseFiles}"
                        ToolTip.Tip="{x:Static loc:Strings.Cards_ImportJSONFlipperNfcRfidProxmark3}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="iconwell green" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.import}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static loc:Strings.Cards_ImportFile}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Static loc:Strings.Cards_JSONNfcBinEml}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Classes="tile source" Command="{Binding ManualCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.Cards_CreateACardByEnteringIts}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="iconwell" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.edit}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static loc:Strings.Cards_EnterManually}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Static loc:Strings.Cards_TypeAndUIDByHand}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
              </UniformGrid>

              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ScanMissText}"
                         Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}"
                         IsVisible="{Binding ScanMissText, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsConnected}"
                         Text="{x:Static loc:Strings.Cards_ConnectAChameleonToScanTags}" />

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsConnected}">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Cards_LFProtocol}" Classes="caption" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding LfProtocols}" SelectedItem="{Binding LfProtocol}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ===================== Assign to slot / write (below the fixed header) ===================== -->
          <Border Classes="card">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="IsSlotsOpen" />
                <Binding Path="IsWriteOpen" />
              </MultiBinding>
            </Border.IsVisible>
            <StackPanel>
              <!-- Assign to slot -->
              <StackPanel Spacing="10" b:BringIntoViewOnShow.IsEnabled="True" IsVisible="{Binding IsSlotsOpen}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static loc:Strings.Cards_AssignToSlotHeader}" Classes="overline" />
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Cards_TheCardReplacesTheSlotsCurrent}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="icon" Command="{Binding RefreshSlotsCommand}"
                          IsVisible="{Binding IsConnected}" ToolTip.Tip="{x:Static loc:Strings.Cards_ReloadSlots}" VerticalAlignment="Top">
                    <PathIcon Data="{StaticResource Icon.refresh}" />
                  </Button>
                </Grid>
                <TextBlock Classes="caption" IsVisible="{Binding !IsConnected}"
                           Text="{x:Static loc:Strings.Cards_ConnectAChameleonToLoadThis}" />
                <TextBlock Classes="caption" IsVisible="{Binding Selected?.IsUnknownType, TargetNullValue=False}" TextWrapping="Wrap"
                           Text="{x:Static loc:Strings.Cards_ThisCardHasNoTagType}" />
                <ItemsControl ItemsSource="{Binding SlotTargets}" IsVisible="{Binding IsConnected}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="8" RowSpacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotTargetViewModel">
                      <Button Classes="slottarget"
                              Command="{Binding $parent[ItemsControl].((vm:CardsViewModel)DataContext).LoadToSlotCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <Border Classes="slotnum" Classes.active="{Binding IsActive}" Width="28" Height="28" CornerRadius="14">
                            <TextBlock Text="{Binding Index}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Classes.dim="{Binding IsEmpty}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption" Text="{Binding ProgressText}"
                           b:BringIntoViewOnShow.IsEnabled="True" IsVisible="{Binding ProgressText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>

              <!-- Write to a physical tag (replaces the editor; the list is locked) -->
              <StackPanel Spacing="12" b:BringIntoViewOnShow.IsEnabled="True" IsVisible="{Binding IsWriteOpen}">
                <TextBlock Text="{Binding WriteKind}" FontWeight="SemiBold" />

                <!-- MIFARE Classic: pick the magic generation, or let the device detect it -->
                <StackPanel Spacing="6" IsVisible="{Binding IsMifareWrite}">
                  <TextBlock Text="{x:Static loc:Strings.Cards_MagicGenerationHeader}" Classes="overline" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" IsEnabled="{Binding CanChangeWriteOptions}"
                              ItemsSource="{Binding MagicGenerations}"
                              SelectedItem="{Binding SelectedGeneration}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Command="{Binding DetectCommand}" IsEnabled="{Binding CanChangeWriteOptions}"
                            ToolTip.Tip="{x:Static loc:Strings.Cards_ProbeTheCardOnTheReader}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.scan}" />
                        <TextBlock Text="{x:Static loc:Strings.Cards_Detect}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <CheckBox Content="{x:Static loc:Strings.Cards_WriteBlock0UID}" IsChecked="{Binding WriteGen2Block0}"
                            IsVisible="{Binding IsGen2Write}" IsEnabled="{Binding CanChangeWriteOptions}"
                            ToolTip.Tip="{x:Static loc:Strings.Cards_WriteTheSourceDumpsManufacturerBlock}" />
                </StackPanel>

                <!-- Ultralight / NTAG: optional password of the target card -->
                <StackPanel Spacing="4" IsVisible="{Binding IsUltralightWrite}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="{x:Static loc:Strings.Cards_CurrentCardPassword}" Classes="caption" VerticalAlignment="Center" />
                    <c:HexBox Grid.Column="1" Text="{Binding WritePassword}" ByteLengths="4"
                              IsEnabled="{Binding !IsBusy}" PlaceholderText="{x:Static loc:Strings.Cards_Optional}"
                              ToolTip.Tip="{x:Static loc:Strings.Cards_PWD4BytesOfTheTarget}" />
                  </Grid>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding WritePasswordError}"
                             Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}"
                             IsVisible="{Binding WritePasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <!-- Ultralight EV1 / NTAG21x: password settings for the target, starting from this card's -->
                <StackPanel Spacing="10" IsVisible="{Binding CanWriteProtection}" IsEnabled="{Binding !IsBusy}">
                  <!-- Laid out like a slot's LED color choice: label, then a compact segmented switch. -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{x:Static loc:Strings.Cards_PasswordSettings}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Classes="segmented compact">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="segment" IsChecked="{Binding KeepProtection}"
                                     ToolTip.Tip="{x:Static loc:Strings.Cards_LeaveTheTargetCardsPasswordPACK}">
                          <TextBlock Text="{x:Static loc:Strings.Cards_Keep}" FontWeight="SemiBold" />
                        </RadioButton>
                        <RadioButton Classes="segment" IsChecked="{Binding RewriteProtection}"
                                     ToolTip.Tip="{x:Static loc:Strings.Cards_AfterThePagesWriteTheSettings}">
                          <TextBlock Text="{x:Static loc:Strings.Cards_WriteNew}" FontWeight="SemiBold" />
                        </RadioButton>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Border Classes="inset" IsVisible="{Binding RewriteProtection}">
                    <c:ProtectionSettingsPanel DataContext="{Binding WriteProtection}" />
                  </Border>
                </StackPanel>

                <!-- EM410x: clone onto a T55xx (default) or an EM4205 / EM4305 -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding CanWriteEm4305}" IsEnabled="{Binding !IsBusy}">
                  <TextBlock Text="{x:Static loc:Strings.Cards_LfChip}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="segmented compact">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Classes="segment" IsChecked="{Binding WriteToT55xx}">
                        <TextBlock Text="T55xx" FontWeight="SemiBold" />
                      </RadioButton>
                      <RadioButton Classes="segment" IsChecked="{Binding WriteToEm4305}">
                        <TextBlock Text="EM4305" FontWeight="SemiBold" />
                      </RadioButton>
                    </StackPanel>
                  </Border>
                </Grid>

                <Panel IsVisible="{Binding IsT55xxWrite}" IsEnabled="{Binding !IsBusy}">
                  <c:T55xxPasswordSettingsPanel DataContext="{Binding WriteT55xxSettings}" />
                </Panel>
                <!-- T55xx result, as in Tools / T55xx: the UID, the matching key and the new key, as hex. -->
                <StackPanel Spacing="6" IsVisible="{Binding IsT55xxWrite}">
                  <Grid ColumnDefinitions="72,*" ColumnSpacing="8"
                        IsVisible="{Binding WriteT55xxUid, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{x:Static loc:Strings.Tools_T55xxUid}" Classes="caption" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding WriteT55xxUid}" FontFamily="{x:Static c:AppFonts.Mono}" TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="72,*" ColumnSpacing="8"
                        IsVisible="{Binding WriteT55xxFoundKey, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{x:Static loc:Strings.Tools_T55xxFound}" Classes="caption" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding WriteT55xxFoundKey}" FontFamily="{x:Static c:AppFonts.Mono}"
                                         FontWeight="SemiBold" TextWrapping="Wrap" />
                  </Grid>
                  <Grid ColumnDefinitions="72,*" ColumnSpacing="8"
                        IsVisible="{Binding WriteT55xxSetKey, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{x:Static loc:Strings.Tools_T55xxNew}" Classes="caption" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding WriteT55xxSetKey}" FontFamily="{x:Static c:AppFonts.Mono}"
                                         FontWeight="SemiBold" TextWrapping="Wrap"
                                         Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineSuccess}" />
                  </Grid>
                </StackPanel>

                <!-- EM4305 only needs the optional current password for LOGIN. -->
                <StackPanel Spacing="4" IsVisible="{Binding IsEm4305Write}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="{x:Static loc:Strings.Cards_CurrentPassword}" Classes="caption" VerticalAlignment="Center" />
                    <c:HexBox Grid.Column="1" Text="{Binding WriteLfPassword}" ByteLengths="4"
                              IsEnabled="{Binding !IsBusy}" PlaceholderText="{x:Static loc:Strings.Cards_Optional}"
                              ToolTip.Tip="{Binding WriteLfPasswordTip}" />
                  </Grid>
                  <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{Binding WriteLfPasswordError}"
                             IsVisible="{Binding WriteLfPasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <Border Classes="inset">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding WriteInstructions}" TextWrapping="Wrap" />
                    <TextBlock Classes="warning" Text="{Binding WriteWarning}" TextWrapping="Wrap"
                               IsVisible="{Binding WriteWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </Border>
                <TextBlock Classes="caption" IsVisible="{Binding !IsConnected}"
                           Text="{x:Static loc:Strings.Cards_ConnectAChameleonToWriteCards}" />
                <TextBlock Classes="caption" Text="{Binding ProgressText}"
                           b:BringIntoViewOnShow.IsEnabled="True" IsVisible="{Binding ProgressText, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <StackPanel IsVisible="{Binding ShowWriteSectors}">
                  <c:KeyRecoveryPanel DataContext="{Binding WriteRecovery}" />
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding WriteKeyHint}" TextWrapping="Wrap"
                           IsVisible="{Binding WriteKeyHint, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Block strip: one cell per block / page, as for a dump; kept after the write. -->
                <StackPanel Spacing="4" b:BringIntoViewOnShow.IsEnabled="True" IsVisible="{Binding HasWriteBlocks}">
                  <c:BlockStrip Classes="write" States="{Binding WriteBlockStates}" Unit="{Binding WriteUnit}" IsWrite="True"
                                HorizontalAlignment="Stretch" />
                  <WrapPanel ItemSpacing="14" LineSpacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend read" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Common_Written}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend searching" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Common_Writing}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend writeerror" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Common_Error}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Common_Pending}" Classes="caption" />
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>

                <!-- A T55xx write takes the button row's place: the bar with the key count, Cancel on the right. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" IsVisible="{Binding IsT55xxWriting}">
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding WriteT55xxProgress}" />
                    <TextBlock Text="{Binding WriteProgressText}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="danger" Command="{Binding CancelWriteCommand}" VerticalAlignment="Center"
                          b:DialogKeys.IsCancel="True" ToolTip.Tip="{Binding CancelWriteTip}"
                          AutomationProperties.Name="{x:Static loc:Strings.Common_Cancel}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.close}" />
                      <TextBlock Text="{x:Static loc:Strings.Common_Cancel}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding !IsT55xxWriting}">
                  <TextBlock Classes="caption" Text="{Binding WriteProgressText}"
                             VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding IsWriting}" />
                  <!-- A T55xx password recovered by the write can be saved, as in Tools / T55xx. -->
                  <DropDownButton Grid.Column="1" IsVisible="{Binding CanSaveWriteT55xxKey}"
                                  ToolTip.Tip="{x:Static loc:Strings.Cards_SaveTheCardsKeys}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.key}" />
                      <TextBlock Text="{x:Static loc:Strings.Cards_SaveKeys}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{x:Static loc:Strings.Cards_KeysToClipboard}" Click="OnCopyWriteT55xxKey">
                          <MenuItem.Icon><PathIcon Data="{StaticResource Icon.copy}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Classes="keystargets" Header="{x:Static loc:Strings.Cards_KeysToDictionary}"
                                  IsVisible="{Binding HasWriteT55xxKeysTargets}" ItemsSource="{Binding WriteT55xxKeysTargets}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource Icon.key}" /></MenuItem.Icon>
                          <MenuItem.Styles>
                            <Style Selector="MenuItem.keystargets > MenuItem" x:DataType="vm:KeysTargetViewModel">
                              <Setter Property="Command" Value="{Binding SaveCommand}" />
                              <Setter Property="Cursor" Value="Hand" />
                              <Setter Property="Template">
                                <ControlTemplate>
                                  <Border Name="PART_Row" Width="260" Margin="4,0" Padding="8,3" CornerRadius="6"
                                          Background="Transparent" x:DataType="vm:KeysTargetViewModel">
                                    <c:DictionaryRow Color="{Binding Item.ColorBrush}" Title="{Binding Item.Name}"
                                                     Count="{Binding Item.Dictionary.Count}" />
                                  </Border>
                                </ControlTemplate>
                              </Setter>
                            </Style>
                            <Style Selector="MenuItem.keystargets > MenuItem:pointerover /template/ Border#PART_Row, MenuItem.keystargets > MenuItem:selected /template/ Border#PART_Row">
                              <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPointerOver}" />
                            </Style>
                            <Style Selector="MenuItem.keystargets > MenuItem:pressed /template/ Border#PART_Row">
                              <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPressed}" />
                            </Style>
                          </MenuItem.Styles>
                        </MenuItem>
                        <MenuItem Header="{x:Static loc:Strings.Cards_KeysToNewDictionary}"
                                  Command="{Binding SaveWriteT55xxKeyToNewDictionaryCommand}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource Icon.add}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static loc:Strings.Cards_KeysToFile}" Command="{Binding SaveWriteT55xxKeyToFileCommand}"
                                  IsEnabled="{Binding CanUseFiles}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource Icon.export}" /></MenuItem.Icon>
                        </MenuItem>
                      </MenuFlyout>
                    </DropDownButton.Flyout>
                  </DropDownButton>
                  <!-- While a write runs, Cancel stops it and the writer stays open to show the result;
                       otherwise the button is Close. -->
                  <Button Grid.Column="2" Content="{Binding CancelWriteLabel}" Command="{Binding CancelWriteCommand}"
                          Classes.danger="{Binding IsWriting}"
                          ToolTip.Tip="{Binding CancelWriteTip}" />
                  <Button Grid.Column="3" Classes="brandblue" Command="{Binding WriteNowCommand}"
                          IsVisible="{Binding !IsWriteSuccessful}"
                          IsEnabled="{Binding IsConnected}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.upload}" />
                      <TextBlock Text="{x:Static loc:Strings.Cards_Write}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="3" Classes="brandblue" Command="{Binding WriteAnotherCommand}"
                          IsVisible="{Binding IsWriteSuccessful}"
                          ToolTip.Tip="{x:Static loc:Strings.Cards_WriteTheSameCardToAnother}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.upload}" />
                      <TextBlock Text="{x:Static loc:Strings.Cards_WriteAnother}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ===================== New card: the scanned tag is already saved ===================== -->
          <Border Classes="card" b:BringIntoViewOnShow.IsEnabled="True">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsEditingNew" />
                <Binding Path="HasScanMatches" />
                <Binding Path="!IsWriteOpen" />
              </MultiBinding>
            </Border.IsVisible>
            <StackPanel Spacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Static loc:Strings.Cards_AlreadySavedHeader}" Classes="overline" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="{Binding ScanMatchText}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ScanMatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CardItemViewModel">
                    <Button Classes="cardtile"
                            Command="{Binding $parent[ItemsControl].((vm:CardsViewModel)DataContext).OpenScanMatchCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{x:Static loc:Strings.Cards_OpenTheSavedCard}">
                      <Border Classes="cardclip">
                        <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="14">
                          <Border Grid.Column="0" Background="{Binding ColorBrush}" />
                          <StackPanel Grid.Column="1" Margin="0,10" Spacing="0">
                            <c:Marquee><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" /></c:Marquee>
                            <TextBlock Text="{Binding Summary}" Classes="caption" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <PathIcon Grid.Column="2" Data="{StaticResource Icon.edit}" Width="16" Height="16" Opacity="0.6"
                                    VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- ===================== Card details (add + edit) ===================== -->
          <Border Classes="card" IsVisible="{Binding ShowEditor}">
            <StackPanel Spacing="10">
              <TextBlock Text="{x:Static loc:Strings.Cards_CardDetailsHeader}" Classes="overline" />

              <!-- Tag type and UID share a row when the UID's longest value fits beside the type
                   (HexBox sizes to it); otherwise, e.g. on phones, the UID wraps below. The type keeps
                   its width, so typing the UID doesn't move it. -->
              <c:FlowGrid MinItemWidth="200" ColumnSpacing="10" RowSpacing="10">
                <StackPanel Spacing="4" c:FlowGrid.ItemWidth="280">
                  <TextBlock Text="{x:Static loc:Strings.Cards_TagType}" Classes="caption" />
                  <!-- Bound through its own DataContext (the form): a DataContext switch applies the
                       selection after the new list, while separate Form?.TagChoices / Form?.Tag bindings
                       could select the new card's type in the old list and leave the box empty. -->
                  <ComboBox DataContext="{Binding Form}" x:DataType="vm:CardEditorViewModel"
                            ItemsSource="{Binding TagChoices}" SelectedItem="{Binding Tag}"
                            IsEnabled="{Binding CanChangeTag, FallbackValue=False}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Form?.UidLabel}" Classes="caption" />
                  <c:HexBox Text="{Binding Form?.Uid}" ByteLengths="{Binding Form?.UidLengths}" PlaceholderText="{Binding Form?.UidHint}" />
                </StackPanel>
              </c:FlowGrid>

              <!-- Pyramid: build the 128-bit frame from a 26-bit facility code and card number. -->
              <c:FlowGrid MinItemWidth="140" ColumnSpacing="10" RowSpacing="10"
                          IsVisible="{Binding Form?.IsPyramid, TargetNullValue=False}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{x:Static loc:Strings.Cards_FacilityCode0255}" Classes="caption" />
                  <TextBox Text="{Binding Form?.PyramidFacility}" PlaceholderText="{x:Static loc:Strings.Cards_26BitFormat}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="{x:Static loc:Strings.Cards_CardNumber065535}" Classes="caption" />
                  <TextBox Text="{Binding Form?.PyramidCard}" PlaceholderText="{x:Static loc:Strings.Cards_26BitFormat}" />
                </StackPanel>
              </c:FlowGrid>

              <TextBlock Classes="caption" TextWrapping="Wrap"
                         IsVisible="{Binding Form?.IsTypeRestricted, TargetNullValue=False}"
                         Text="{x:Static loc:Strings.Cards_OnlyTypesThatKeepThisCards}" />

              <!-- Decoded from the ID as it is typed; click a value to copy it. -->
              <ItemsControl ItemsSource="{Binding Form?.LfFields}"
                            IsVisible="{Binding Form?.HasLfFields, TargetNullValue=False}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><c:FlowGrid MinItemWidth="90" ColumnSpacing="8" RowSpacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScanResultRow">
                    <Button Classes="copycell" b:CopyToClipboard.Text="{Binding Value}" ToolTip.Tip="{x:Static loc:Strings.Cards_ClickToCopy}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Field}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Value}" Classes="mono" FontSize="14" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="3*,4*,8*" ColumnSpacing="10" IsVisible="{Binding Form?.IsHf, TargetNullValue=False}">
                <StackPanel Spacing="4">
                  <TextBlock Text="SAK" Classes="caption" />
                  <c:HexBox Text="{Binding Form?.Sak}" ByteLengths="1" PlaceholderText="08" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="ATQA" Classes="caption" />
                  <c:HexBox Text="{Binding Form?.Atqa}" ByteLengths="2" PlaceholderText="00 04" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="ATS" Classes="caption" />
                  <c:HexBox Text="{Binding Form?.Ats}" PlaceholderText="{x:Static loc:Strings.Cards_Optional2}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Memory dump / continuation for scanned, saved, imported and manual cards. -->
          <Border x:Name="MemoryCard" Classes="card" IsVisible="{Binding ShowMemoryEditor}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <!-- What of the memory is known, on the heading's line: "Not read", "45/45 pages"…
                       One TextBlock so the 11px heading and the 12px summary share a baseline. -->
                  <TextBlock Classes="caption" TextWrapping="NoWrap" VerticalAlignment="Center">
                    <Run Text="{x:Static loc:Strings.Cards_MemoryHeader}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.6"
                         Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}" />
                    <Run Text=" " />
                    <Run Text="{Binding Form?.DataSummary}" />
                  </TextBlock>
                  <!-- Ultralight / NTAG: the memory as hex, or as the NDEF records it holds. -->
                  <Border Grid.Column="2" Classes="segmented compact" IsVisible="{Binding CanShowNdef}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Classes="segment" IsChecked="{Binding IsHexView}" ToolTip.Tip="{x:Static loc:Strings.Cards_EveryPageAsHex}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource Icon.hex}" Width="14" Height="14" />
                          <TextBlock Text="Hex" FontWeight="SemiBold" />
                        </StackPanel>
                      </RadioButton>
                      <RadioButton Classes="segment" IsChecked="{Binding IsNdefView}" ToolTip.Tip="{x:Static loc:Strings.Cards_TheNDEFRecordsInTheMemory}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource Icon.ndefLink}" Width="14" Height="14" />
                          <TextBlock Text="NDEF" FontWeight="SemiBold" />
                        </StackPanel>
                      </RadioButton>
                    </StackPanel>
                  </Border>
                  <!-- Measured by the scan; decides which key attacks can work. -->
                  <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center"
                             ToolTip.Tip="{x:Static loc:Strings.Cards_TheCardsRandomNumberGeneratorMeasured}"
                             IsVisible="{Binding Prng, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Run Text="PRNG" />
                    <Run Text="{Binding Prng}" FontWeight="SemiBold" />
                  </TextBlock>
                </Grid>
                <TextBlock Classes="caption" Text="{Binding Form?.MemoryWarning}" TextWrapping="Wrap"
                           Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}"
                           IsVisible="{Binding Form?.MemoryWarning, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DumpHint}"
                           IsVisible="{Binding ShowDumpHint}" />
              </StackPanel>
              <StackPanel Spacing="8">
                <!-- Actions and progress share a fixed-height slot to keep the sector grid still. -->
                <c:KeyRecoveryPanel>
                  <!-- Hidden when it has nothing to show, so its empty slot adds no spacing above the page map. -->
                  <c:KeyRecoveryPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                      <Binding Path="RecoveryIdentity" Converter="{x:Static ObjectConverters.IsNotNull}" />
                      <Binding Path="ShowRecoveryTools" />
                      <Binding Path="ShowDumpNotice" />
                      <Binding Path="HasDumpSectors" />
                    </MultiBinding>
                  </c:KeyRecoveryPanel.IsVisible>
                  <!-- Ultralight / NTAG: optional password for the protected pages, beside Read. -->
                  <c:KeyRecoveryPanel.ToolbarContent>
                    <c:HexBox Text="{Binding DumpPassword}" ByteLengths="4,16"
                              IsVisible="{Binding IsUltralightDump}"
                              PlaceholderText="{x:Static loc:Strings.Cards_PasswordOptional}"
                              ToolTip.Tip="{x:Static loc:Strings.Cards_PWD4BytesForNTAGUltralight}" />
                  </c:KeyRecoveryPanel.ToolbarContent>
                </c:KeyRecoveryPanel>

                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding DumpPasswordError}"
                           Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="ShowDumpPassword" />
                      <Binding Path="DumpPasswordError" Converter="{x:Static ObjectConverters.IsNotNull}" />
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>

                <!-- Ultralight / NTAG: one cell per page, drawn as one control spanning the full width. -->
                <StackPanel Spacing="6" b:BringIntoViewOnShow.IsEnabled="True"
                            IsVisible="{Binding HasDumpBlocks}">
                  <c:BlockStrip States="{Binding DumpBlockStates}" Unit="{Binding DumpUnit}"
                                LockedText="{x:Static loc:Strings.Common_NoKey}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                  <WrapPanel ItemSpacing="14" LineSpacing="4" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend read" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Common_OK}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend reading" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Cards_Reading}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend readerror" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Common_Error}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend nokey" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Common_NoKey}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Border Classes="blockcell blocklegend" Margin="0" />
                      <TextBlock Text="{x:Static loc:Strings.Common_NotTried}" Classes="caption" />
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding ShowHexView}">
                  <Border Classes="inset" Padding="8,6">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              VerticalAlignment="Center">
                          <TextBlock Classes="mono" FontSize="12" Text="{Binding #MemoryEditor.SelectionStatus?.Title}" />
                          <!-- Proportional text sits lower than the mono title beside it: lift it onto the same line. -->
                          <TextBlock Grid.Column="1" FontSize="12" Margin="0,-2,0,2" Text="{Binding #MemoryEditor.SelectionStatus?.Detail}"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding #MemoryEditor.SelectionStatus?.Detail}" />
                          <TextBlock Grid.Row="1" Classes="caption mono" Text="{Binding #MemoryEditor.SelectionStatus?.Position}" />
                          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                            <TextBlock Classes="mono" FontSize="12" Text="{Binding #MemoryEditor.SelectionStatus?.Hex}"
                                       Foreground="{StaticResource BrandBlueBrush}" />
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding #MemoryEditor.SelectionStatus?.Decimal}"
                                       Foreground="{StaticResource BrandAmberBrush}" />
                            <TextBlock Grid.Column="2" Classes="mono" FontSize="12" Text="{Binding #MemoryEditor.SelectionStatus?.Binary}"
                                       Foreground="{StaticResource HexKeyBBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.ColumnSpan="3" Classes="caption mono" Text="{Binding #MemoryEditor.SelectionStatus?.Note}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding #MemoryEditor.SelectionStatus?.Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </Grid>
                        </Grid>
                        <Button Grid.Column="1" Classes="danger" Command="{Binding Form?.ClearSectorCommand}"
                                VerticalAlignment="Center" IsVisible="{Binding Form?.IsMifareClassic, TargetNullValue=False}"
                                IsEnabled="{Binding !IsBusy}"
                                ToolTip.Tip="{x:Static loc:Strings.Cards_ClearTheSelectedSectorAndMark}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.delete}" />
                            <TextBlock Text="{x:Static loc:Strings.Common_Clear}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>
                      <ScrollViewer x:Name="MemoryScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <c:HexEditor x:Name="MemoryEditor" Buffer="{Binding Form?.SelectedMemory}" ShowGroupHeaders="False" />
                      </ScrollViewer>
                    </Grid>
                  </Border>
                  <WrapPanel Classes="hexlegend" IsVisible="{Binding Form?.IsMifareClassic, TargetNullValue=False}" Margin="16,0,0,0">
                    <TextBlock Classes="manufacturer" Text="{x:Static loc:Strings.Cards_Block0}" />
                    <TextBlock Classes="keya" Text="{x:Static loc:Strings.Cards_KeyA}" />
                    <TextBlock Classes="access" Text="{x:Static loc:Strings.Cards_AccessBits}" />
                    <TextBlock Classes="keyb" Text="{x:Static loc:Strings.Cards_KeyB}" />
                    <TextBlock Classes="changed" Text="{x:Static loc:Strings.Common_Modified}" />
                  </WrapPanel>
                  <WrapPanel Classes="hexlegend" IsVisible="{Binding Form?.IsUltralight, TargetNullValue=False}" Margin="0,6,0,0">
                    <TextBlock Classes="manufacturer" Text="{x:Static loc:Strings.Cards_UID}" />
                    <TextBlock Classes="access" Text="{x:Static loc:Strings.Cards_LockBytes}" />
                    <TextBlock Classes="keya" Text="{x:Static loc:Strings.Cards_Config}"
                               IsVisible="{Binding Form?.HasUltralightConfig, TargetNullValue=False}" />
                    <TextBlock Classes="keyb" Text="{Binding Form?.UltralightKeyLegend}"
                               IsVisible="{Binding Form?.HasUltralightConfig, TargetNullValue=False}" />
                    <TextBlock Classes="changed" Text="{x:Static loc:Strings.Common_Modified}" />
                  </WrapPanel>
                </StackPanel>

                <!-- Ultralight / NTAG: the NDEF records, edited in place; valid edits go straight into the memory. -->
                <Panel IsVisible="{Binding ShowNdefView}">
                <Border Classes="inset" Padding="8">
                <StackPanel Spacing="8" DataContext="{Binding Form?.Ndef}" x:DataType="vm:NdefEditorViewModel">
                  <!-- Records and the bytes they take; more than the card holds shows in red. -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,0">
                    <TextBlock Classes="caption" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Usage}" VerticalAlignment="Center"
                               Classes.overcapacity="{Binding IsOverCapacity}" />
                  </Grid>
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Error}" Margin="4,0"
                             Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}"
                             IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <!-- Dragged into place by any spot of a tile that isn't an input. -->
                  <ListBox x:Name="NdefList" Classes="ndef" ItemsSource="{Binding Records}" b:ListReorder.HasInputs="True"
                           IsVisible="{Binding HasRecords}"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:NdefRecordEditorViewModel">
                        <Border Classes="ndefrecord">
                          <!-- The kind's icon, the fields, and Remove; the kind's name shows on the icon's tooltip. -->
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Border Classes="iconwell small blue" VerticalAlignment="Top" ToolTip.Tip="{Binding Title}">
                              <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconGeometryConverter.Instance}}" />
                            </Border>
                            <Button Grid.Column="2" Classes="icon small danger" VerticalAlignment="Top"
                                    ToolTip.Tip="{x:Static loc:Strings.Cards_RemoveTheRecord}" AutomationProperties.Name="{x:Static loc:Strings.Cards_RemoveTheRecord}"
                                    Command="{Binding $parent[ListBox].((vm:NdefEditorViewModel)DataContext).RemoveCommand}"
                                    CommandParameter="{Binding}">
                              <PathIcon Data="{StaticResource Icon.delete}" />
                            </Button>
                            <StackPanel Grid.Column="1" Spacing="6">

                              <TextBox Text="{Binding Uri}" IsVisible="{Binding IsLink}"
                                       PlaceholderText="https://example.com" />

                              <TextBox Text="{Binding Phone}" IsVisible="{Binding HasNumber}" PlaceholderText="{x:Static loc:Strings.Cards_PhoneNumberEG1555}" />

                              <StackPanel Spacing="6" IsVisible="{Binding IsEmail}">
                                <TextBox Text="{Binding Email}" PlaceholderText="{x:Static loc:Strings.Cards_EmailAddress}" />
                                <TextBox Text="{Binding Subject}" PlaceholderText="{x:Static loc:Strings.Cards_SubjectOptional}" />
                              </StackPanel>

                              <TextBox Text="{Binding Message}" IsVisible="{Binding HasMessage}" AcceptsReturn="True" TextWrapping="Wrap"
                                       PlaceholderText="{x:Static loc:Strings.Cards_MessageOptional}" />

                              <StackPanel Spacing="6" IsVisible="{Binding IsContact}">
                                <TextBox Text="{Binding Name}" PlaceholderText="{x:Static loc:Strings.Cards_Name}" />
                                <TextBox Text="{Binding Organization}" PlaceholderText="{x:Static loc:Strings.Cards_OrganizationOptional}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                  <TextBox Text="{Binding Phone}" PlaceholderText="{x:Static loc:Strings.Cards_PhoneOptional}" />
                                  <TextBox Grid.Column="1" Text="{Binding Email}" PlaceholderText="{x:Static loc:Strings.Cards_EmailOptional}" />
                                </Grid>
                                <TextBox Text="{Binding Website}" PlaceholderText="{x:Static loc:Strings.Cards_WebsiteOptional}" />
                              </StackPanel>

                              <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding IsGeo}">
                                <TextBox Text="{Binding Latitude}" PlaceholderText="{x:Static loc:Strings.Cards_LatitudeEG488584}"
                                         ToolTip.Tip="{x:Static loc:Strings.Cards_DegreesNorthNegativeSouth}" />
                                <TextBox Grid.Column="1" Text="{Binding Longitude}" PlaceholderText="{x:Static loc:Strings.Cards_LongitudeEG22945}"
                                         ToolTip.Tip="{x:Static loc:Strings.Cards_DegreesEastNegativeWest}" />
                              </Grid>

                              <Grid ColumnDefinitions="*,64" ColumnSpacing="6" IsVisible="{Binding IsText}">
                                <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="{x:Static loc:Strings.Cards_Text}" />
                                <TextBox Grid.Column="1" Text="{Binding Language}" PlaceholderText="en" VerticalAlignment="Top"
                                         ToolTip.Tip="{x:Static loc:Strings.Cards_LanguageCodeEGEnDe}" />
                              </Grid>

                              <StackPanel Spacing="6" IsVisible="{Binding IsWifi}">
                                <TextBox Text="{Binding Ssid}" PlaceholderText="{x:Static loc:Strings.Cards_NetworkNameSSID}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                  <ComboBox ItemsSource="{Binding WifiAuths}" SelectedItem="{Binding WifiAuth}" MinWidth="150">
                                    <ComboBox.ItemTemplate>
                                      <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                                      </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <TextBox Grid.Column="1" Text="{Binding WifiKey}" PlaceholderText="{x:Static loc:Strings.Cards_Password}" IsVisible="{Binding HasWifiKey}" />
                                </Grid>
                              </StackPanel>

                              <TextBox Text="{Binding Package}" IsVisible="{Binding IsAndroidApp}"
                                       PlaceholderText="{x:Static loc:Strings.Cards_PackageNameEGComExample}" />

                              <StackPanel Spacing="6" IsVisible="{Binding IsMime}">
                                <TextBox Text="{Binding MimeType}" PlaceholderText="{x:Static loc:Strings.Cards_MIMETypeEGTextPlain}" />
                                <TextBox Text="{Binding MimeContent}" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="{x:Static loc:Strings.Cards_Content}" />
                              </StackPanel>

                              <StackPanel Spacing="6" IsVisible="{Binding IsRaw}">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                  <ComboBox ItemsSource="{Binding Tnfs}" SelectedItem="{Binding RawTnf}" HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{x:Static loc:Strings.Cards_TypeNameFormat}">
                                    <ComboBox.ItemTemplate>
                                      <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                                      </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                  </ComboBox>
                                  <TextBox Grid.Column="1" Text="{Binding RawType}" PlaceholderText="{x:Static loc:Strings.Cards_Type}" />
                                </Grid>
                                <c:HexBox Text="{Binding RawPayload}" PlaceholderText="{x:Static loc:Strings.Cards_PayloadHex}" TextWrapping="Wrap" />
                              </StackPanel>

                              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Error}"
                                         Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}"
                                         IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding EditError}" Margin="4,0"
                             Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}"
                             IsVisible="{Binding EditError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding CanEdit}">
                    <DropDownButton Classes="theme-outline accent" ToolTip.Tip="{x:Static loc:Strings.Cards_AddARecordAtTheEnd}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.add}" />
                        <TextBlock Text="{x:Static loc:Strings.Cards_AddRecord}" VerticalAlignment="Center" />
                      </StackPanel>
                      <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                          <MenuItem Header="{x:Static loc:Strings.Cards_LinkURI}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Link}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefLink}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static loc:Strings.Cards_PhoneNumber}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Phone}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefPhone}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static loc:Strings.Cards_Email}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Email}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefEmail}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static loc:Strings.Cards_TextMessageSMS}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Sms}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefSms}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static loc:Strings.Cards_Location}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Geo}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefGeo}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static loc:Strings.Cards_ContactVCard}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Contact}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefContact}" /></MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="{x:Static loc:Strings.Cards_Text}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Text}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefText}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static loc:Strings.Cards_WiFiNetwork}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Wifi}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefWifi}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static loc:Strings.Cards_AndroidApp}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.AndroidApp}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefAndroidApp}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{x:Static loc:Strings.Cards_MIMEData}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Mime}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefMime}" /></MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="{x:Static loc:Strings.Cards_RawRecord}" Command="{Binding AddCommand}" CommandParameter="{x:Static vm:NdefRecordKind.Raw}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource Icon.ndefRaw}" /></MenuItem.Icon>
                          </MenuItem>
                        </MenuFlyout>
                      </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="{x:Static loc:Strings.Cards_EditsGoStraightIntoTheMemory}" />
                  </Grid>
                </StackPanel>
                </Border>
                </Panel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ===================== Password protection (Ultralight EV1 / NTAG21x) ===================== -->
          <!-- Hidden as a whole, so the list's spacing doesn't leave a gap for the hidden card. -->
          <Panel>
            <Panel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="ShowMemoryEditor" />
                <Binding ElementName="PasswordCard" Path="IsVisible" />
              </MultiBinding>
            </Panel.IsVisible>
            <!-- Shown once the configuration pages are read: before, there are no settings to show. -->
            <Border x:Name="PasswordCard" Classes="card" IsVisible="{Binding Form?.HasProtection, TargetNullValue=False}">
              <StackPanel Spacing="10" DataContext="{Binding Form}" x:DataType="vm:CardEditorViewModel">
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static loc:Strings.Cards_PasswordProtectionHeader}" Classes="overline" />
                </StackPanel>
                <c:ProtectionSettingsPanel />
              </StackPanel>
            </Border>
          </Panel>
        </StackPanel>
      </ScrollViewer>

      <!-- Lightbox: dims and blocks the editor while a question waits for an answer. -->
      <Border Grid.Row="0" Grid.RowSpan="2" Classes="lightbox" Classes.on="{Binding IsAsking}" CornerRadius="12" />

      <!-- ===================== Save bar (stays in view) ===================== -->
      <!-- Adding: offered as soon as there is a new card (not one already saved); Discard drops it and goes back to picking a source. -->
      <Border Grid.Row="2" Classes="savebar">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsNewCardUnsaved" />
            <Binding Path="!IsConfirmingLeave" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel>
          <DockPanel Classes="saveerror" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource Icon.error}" />
            <TextBlock Text="{Binding SaveError}" />
          </DockPanel>
          <c:ActionBar>
            <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Static loc:Strings.Cards_DumpTheCardFirstToSave}" IsVisible="{Binding NeedsDump}" />
            <Button Content="{x:Static loc:Strings.Common_Discard}" Command="{Binding CancelAddCommand}" />
            <Button Classes.accent="{Binding !NeedsDump}" Command="{Binding SaveCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{Binding AddSaveLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionBar>
        </StackPanel>
      </Border>
      <!-- Saved card: appears only once something changed. -->
      <Border Grid.Row="2" Classes="savebar">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsCardDirty" />
            <Binding Path="!IsConfirmingLeave" />
            <Binding Path="!IsConfirmingDelete" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel>
          <DockPanel Classes="saveerror" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource Icon.error}" />
            <TextBlock Text="{Binding SaveError}" />
          </DockPanel>
          <c:ActionBar>
            <TextBlock Text="{x:Static loc:Strings.Common_UnsavedChanges}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Content="{x:Static loc:Strings.Common_Discard}" Command="{Binding DiscardCommand}" />
            <Button Classes="accent" Command="{Binding SaveCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionBar>
        </StackPanel>
      </Border>
      <!-- Switching card, closing or adding with unsaved work: save, drop it, or stay. -->
      <Border Grid.Row="0" Grid.RowSpan="3" Classes="savebar dialog" IsVisible="{Binding IsConfirmingLeave}">
        <c:ActionBar>
          <TextBlock Text="{Binding LeaveText}" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
          <!-- Short of room, Cancel gives up its label first, then Discard; Save keeps it longest. -->
          <c:ActionRow>
            <Button Command="{Binding StayCommand}" b:DialogKeys.IsCancel="True"
                    ToolTip.Tip="{x:Static loc:Strings.Cards_KeepEditingThisCard}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.close}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Cancel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding DiscardAndLeaveCommand}" c:ActionRow.Priority="1"
                    ToolTip.Tip="{x:Static loc:Strings.Common_Discard}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Discard}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding SaveAndLeaveCommand}" b:DialogKeys.IsDefault="True"
                    c:ActionRow.Priority="2" ToolTip.Tip="{x:Static loc:Strings.Common_Save}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionRow>
        </c:ActionBar>
      </Border>
      <!-- Saved a card that is loaded in slots: optionally push the new version to the device. -->
      <Border Grid.Row="0" Grid.RowSpan="3" Classes="savebar dialog">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsAskingSlotUpdate" />
            <Binding Path="!IsConfirmingDelete" />
          </MultiBinding>
        </Border.IsVisible>
        <c:ActionBar>
          <TextBlock Text="{Binding SlotUpdateText}" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button Content="{x:Static loc:Strings.Cards_NotNow}" Command="{Binding SkipSlotUpdateCommand}" b:DialogKeys.IsCancel="True"
                  ToolTip.Tip="{x:Static loc:Strings.Cards_KeepTheOldVersionInThe}" />
          <Button Classes="accent" Content="{x:Static loc:Strings.Common_Update}" Command="{Binding UpdateSlotsCommand}" b:DialogKeys.IsDefault="True"
                  ToolTip.Tip="{x:Static loc:Strings.Cards_UploadTheSavedCardToThese}" />
        </c:ActionBar>
      </Border>
      <!-- Delete: asked like the other questions, and wins over the save bar while open. -->
      <Border Grid.Row="0" Grid.RowSpan="3" Classes="savebar dialog">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConfirmingDelete" />
            <Binding Path="!IsConfirmingLeave" />
          </MultiBinding>
        </Border.IsVisible>
        <c:ActionBar>
          <TextBlock Text="{x:Static loc:Strings.Cards_DeleteThisCardPermanently}" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CloseActionCommand}" b:DialogKeys.IsCancel="True" />
          <Button Classes="danger solid" Command="{Binding ConfirmDeleteCommand}" b:DialogKeys.IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.delete}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Delete}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </c:ActionBar>
      </Border>
    </Grid>
  </Grid>
</UserControl>
