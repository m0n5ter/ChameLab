<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ChameLab.Localization"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:conv="using:ChameLab.Converters"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:c="using:ChameLab.Controls"
             x:Class="ChameLab.Views.ChameleonView"
             x:DataType="vm:ChameleonViewModel">

  <UserControl.Styles>
    <!-- Slot strip: a row of LEDs like the device's, each split HF | LF; the active one is ringed. -->
    <Style Selector="Ellipse.ledring">
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style Selector="Ellipse.ledring.active">
      <Setter Property="Stroke" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
    </Style>
    <Style Selector="Border.led">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.slot:pointerover Border.led, Border.led.active">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The number sits on the LED: white with a shadow over a color, plain text over an empty slot. -->
    <Style Selector="TextBlock.lednum">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.lednum.lit">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Effect">
        <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="3" Color="Black" Opacity="0.8" />
      </Setter>
    </Style>
    <Style Selector="TextBlock.lednum.active">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- An empty frequency of the active slot: its chip dimmed. -->
    <Style Selector="Border.chip.off">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Operating mode switch: sized to its labels, not the card. -->
    <Style Selector="Border.segmented.compact">
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Border.segmented.compact RadioButton.segment /template/ Border#PART_Bg">
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Border.segmented.compact RadioButton.segment PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <!-- Battery and mode stack once the page itself is too narrow for both, whatever the window does. -->
    <ContainerQuery Name="hero" Query="max-width:600">
      <Style Selector="UniformGrid.cols2">
        <Setter Property="Columns" Value="1" />
      </Style>
    </ContainerQuery>
    <!-- One setting: icon, title + description, and its control (SettingRow stacks them when narrow). -->
    <Style Selector=":is(Control).setting > :is(Control).control">
      <Setter Property="Width" Value="220" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=".compact :is(Control).setting > :is(Control).control">
      <Setter Property="Width" Value="160" />
    </Style>
    <!-- Stacked (narrow) rows: a slimmer control leaves the description room. -->
    <Style Selector=":is(Control).setting.stacked > :is(Control).control">
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector=":is(Control).setting.stacked > NumericUpDown.control, :is(Control).setting.stacked > TextBox.control">
      <Setter Property="Width" Value="116" />
    </Style>
    <!-- The save bar sits under the scrolling page, lined up with its cards. -->
    <Style Selector="Border.savebar.pagebar">
      <Setter Property="MaxWidth" Value="980" />
      <Setter Property="Margin" Value="28,0,28,24" />
    </Style>
    <Style Selector=".compact Border.savebar.pagebar">
      <Setter Property="Margin" Value="14,0,14,8" />
    </Style>
    <Style Selector="Separator.row">
      <Setter Property="Margin" Value="0,14" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Classes="page">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Chameleon" Classes="h1" />
            <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_DeviceStatusFirmwareAndSettings}" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="{x:Static loc:Strings.Chameleon_ReloadDeviceInformation}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.refresh}" />
              <TextBlock Text="{x:Static loc:Strings.Chameleon_Refresh}" Classes="wide-only" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Hero: battery + mode -->
        <Panel>
          <UniformGrid Classes="cols2">
            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                <!-- Ring gauge -->
                <Panel Grid.Column="0" Width="96" Height="96" VerticalAlignment="Center">
                  <Ellipse StrokeThickness="9" Stroke="{actipro:ThemeResource Container3BackgroundBrush}" />
                  <Arc StartAngle="-90" StrokeThickness="9" StrokeLineCap="Round"
                       SweepAngle="{Binding Battery?.Percent, Converter={x:Static conv:PercentToSweepConverter.Instance}}"
                       Stroke="{Binding Battery?.Percent, Converter={x:Static conv:BatteryBrushConverter.Instance}}"
                       IsVisible="{Binding Battery, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <PathIcon Data="{StaticResource Icon.bolt}" Width="26" Height="26"
                            Foreground="{Binding Battery?.Percent, Converter={x:Static conv:BatteryBrushConverter.Instance}}"
                            IsVisible="{Binding Battery, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <PathIcon Data="{StaticResource Icon.bolt}" Width="26" Height="26" Opacity="0.35"
                            IsVisible="{Binding Battery, Converter={x:Static ObjectConverters.IsNull}}" />
                </Panel>
  
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{x:Static loc:Strings.Chameleon_BatteryHeader}" Classes="overline" />
                  <TextBlock Text="{Binding Battery?.Percent, StringFormat='{}{0}%'}"
                             FontSize="34" FontWeight="Bold"
                             IsVisible="{Binding Battery, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="caption"
                             Text="{Binding Battery?.Volts, StringFormat={x:Static loc:Strings.Chameleon_BatteryVolts}}"
                             IsVisible="{Binding Battery, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="caption" FontWeight="SemiBold"
                             Text="{Binding Battery?.ConditionText}"
                             Foreground="{Binding Battery?.Condition, Converter={x:Static conv:BatteryBrushConverter.Instance}}"
                             IsVisible="{Binding Battery?.ConditionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="{x:Static loc:Strings.Chameleon_NotAvailable}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                             IsVisible="{Binding Battery, Converter={x:Static ObjectConverters.IsNull}}" />
                  <TextBlock Text="{x:Static loc:Strings.Chameleon_ThisModelHasNoBatteryGauge}" Classes="caption"
                             IsVisible="{Binding Battery, Converter={x:Static ObjectConverters.IsNull}}" />
                </StackPanel>
              </Grid>
            </Border>
  
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{x:Static loc:Strings.Chameleon_OperatingModeHeader}" Classes="overline" />
                <Border Classes="segmented compact" HorizontalAlignment="Left">
                  <UniformGrid Rows="1">
                    <RadioButton Classes="segment" GroupName="DeviceMode"
                                 IsChecked="{Binding ReaderMode, Converter={x:Static conv:InverseBoolConverter.Instance}}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.card}" />
                        <TextBlock Text="{x:Static loc:Strings.Chameleon_Emulator}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="segment" GroupName="DeviceMode" IsChecked="{Binding ReaderMode}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.scan}" />
                        <TextBlock Text="{x:Static loc:Strings.Chameleon_Reader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </RadioButton>
                  </UniformGrid>
                </Border>
                <TextBlock Classes="caption" IsVisible="{Binding !ReaderMode}"
                           Text="{x:Static loc:Strings.Chameleon_TheDevicePresentsTheActiveSlot}" />
                <TextBlock Classes="caption" IsVisible="{Binding ReaderMode}"
                           Text="{x:Static loc:Strings.Chameleon_TheDeviceScansExternalCardsAnd}" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </Panel>

        <!-- Active slot: the eight slots with their LED colors; arrows step through the filled ones -->
        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="iconwell blue"><PathIcon Data="{StaticResource Icon.slots}" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Static loc:Strings.Chameleon_ActiveSlotHeader}" Classes="overline" />
                <TextBlock Text="{Binding ActiveHeader}" Classes="caption" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Command="{Binding PrevSlotCommand}" VerticalAlignment="Center"
                      ToolTip.Tip="{x:Static loc:Strings.Chameleon_PreviousFilledSlot}">
                <PathIcon Data="{StaticResource Icon.back}" />
              </Button>
              <Button Grid.Column="3" Classes="icon" Command="{Binding NextSlotCommand}" VerticalAlignment="Center"
                      ToolTip.Tip="{x:Static loc:Strings.Chameleon_NextFilledSlot}">
                <PathIcon Data="{StaticResource Icon.back}" RenderTransform="scaleX(-1)" />
              </Button>
            </Grid>
            <!-- Laid out at a fixed size and scaled as a whole, so the strip keeps its proportions. -->
            <Viewbox Stretch="Uniform" MaxHeight="75">
              <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SlotItemViewModel">
                    <Button Classes="slot" ToolTip.Tip="{Binding Summary}"
                            Command="{Binding $parent[ItemsControl].((vm:ChameleonViewModel)DataContext).SelectSlotCommand}"
                            CommandParameter="{Binding}">
                      <Panel Width="36" Height="36">
                        <Ellipse Classes="ledring" Classes.active="{Binding IsActive}" />
                        <!-- HF color on the left, LF on the right; one card fills both halves. -->
                        <Border Classes="led" Classes.active="{Binding IsActive}" Width="28" Height="28" CornerRadius="14"
                                ClipToBounds="True" IsVisible="{Binding !IsEmpty}">
                          <Grid ColumnDefinitions="*,*">
                            <Border Grid.Column="0" Background="{Binding LedLeft, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                            <Border Grid.Column="1" Background="{Binding LedRight, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                          </Grid>
                        </Border>
                        <Ellipse Width="28" Height="28" StrokeThickness="1.5" StrokeDashArray="2,2"
                                 Stroke="{actipro:ThemeResource Container3BorderBrush}" IsVisible="{Binding IsEmpty}" />
                        <TextBlock Classes="lednum" Classes.active="{Binding IsActive}" Classes.lit="{Binding !IsEmpty}"
                                   Text="{Binding Index}" />
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Viewbox>

            <!-- The cards of the active slot. -->
            <Border BorderThickness="0,1,0,0" BorderBrush="{actipro:ThemeResource Container1BorderBrush}" Padding="0,12,0,0"
                    IsVisible="{Binding ActiveItem, Converter={x:Static ObjectConverters.IsNotNull}}">
              <!-- Scoped to the slot so the bindings below never walk through a null ActiveItem. -->
              <WrapPanel ItemSpacing="20" LineSpacing="6" HorizontalAlignment="Center"
                         DataContext="{Binding ActiveItem}" x:DataType="vm:SlotItemViewModel">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                  <Border Classes="chip hf" Classes.off="{Binding !HasHf}">
                    <TextBlock Text="HF" />
                  </Border>
                  <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center" IsVisible="{Binding HasHf}"
                           Fill="{Binding HfLed, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                  <!-- Name and type as runs of one line, so they share a baseline. -->
                  <c:Marquee Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding HasHf}">
                    <TextBlock>
                      <Run Text="{Binding HfNick}" FontWeight="Bold" />
                      <Run Text="{Binding HfTypeLabel}" FontSize="12"
                           Foreground="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
                    </TextBlock>
                  </c:Marquee>
                  <TextBlock Grid.Column="2" Classes="caption" Text="{x:Static loc:Strings.Common_Empty}" VerticalAlignment="Center"
                             IsVisible="{Binding !HasHf}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                  <Border Classes="chip lf" Classes.off="{Binding !HasLf}">
                    <TextBlock Text="LF" />
                  </Border>
                  <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center" IsVisible="{Binding HasLf}"
                           Fill="{Binding LfLed, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                  <c:Marquee Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding HasLf}">
                    <TextBlock>
                      <Run Text="{Binding LfNames}" FontWeight="Bold" />
                      <Run Text="{Binding LfTypeLabel}" FontSize="12"
                           Foreground="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
                    </TextBlock>
                  </c:Marquee>
                  <TextBlock Grid.Column="2" Classes="caption" Text="{x:Static loc:Strings.Common_Empty}" VerticalAlignment="Center"
                             IsVisible="{Binding !HasLf}" />
                </Grid>
              </WrapPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Device identity -->
        <Border Classes="card">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="iconwell green">
                <PathIcon Data="{StaticResource Icon.info}" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Info?.ModelName, TargetNullValue='Device'}" Classes="h2" />
                <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_HardwareAndFirmwareIdentity}" />
              </StackPanel>
            </StackPanel>

            <UniformGrid Classes="cols2">
              <Border Classes="inset">
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static loc:Strings.Chameleon_FirmwareHeader}" Classes="overline" />
                  <TextBlock Text="{Binding Info?.FirmwareVersion, TargetNullValue='-'}" Classes="value" />
                </StackPanel>
              </Border>
              <Border Classes="inset">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Static loc:Strings.Chameleon_GitVersionHeader}" Classes="overline" />
                    <TextBlock Text="{Binding Info?.GitVersion, TargetNullValue='-'}" Classes="value mono" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="icon small" VerticalAlignment="Center"
                          b:CopyToClipboard.Text="{Binding Info?.GitVersion}">
                    <PathIcon Data="{StaticResource Icon.copy}" />
                  </Button>
                </Grid>
              </Border>
              <Border Classes="inset">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Static loc:Strings.Chameleon_ChipIdHeader}" Classes="overline" />
                    <TextBlock Text="{Binding Info?.ChipId, TargetNullValue='-'}" Classes="value mono" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="icon small" VerticalAlignment="Center"
                          b:CopyToClipboard.Text="{Binding Info?.ChipId}">
                    <PathIcon Data="{StaticResource Icon.copy}" />
                  </Button>
                </Grid>
              </Border>
              <Border Classes="inset">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Static loc:Strings.Chameleon_BleAddressHeader}" Classes="overline" />
                    <TextBlock Text="{Binding Info?.Address, TargetNullValue='-'}" Classes="value mono" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="icon small" VerticalAlignment="Center"
                          b:CopyToClipboard.Text="{Binding Info?.Address}">
                    <PathIcon Data="{StaticResource Icon.copy}" />
                  </Button>
                </Grid>
              </Border>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- Firmware updates -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="iconwell blue" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.upload}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Static loc:Strings.Chameleon_FirmwareUpdateHeader}" Classes="overline" />
                <TextBlock Text="{Binding Firmware.CurrentVersion, StringFormat={x:Static loc:Strings.Chameleon_FirmwareInstalled}}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Firmware.CheckMessage}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center"
                      Command="{Binding Firmware.CheckCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_CheckGitHubForANewerRelease}">
                <PathIcon Data="{StaticResource Icon.refresh}" />
              </Button>
            </Grid>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="accent" Command="{Binding Firmware.InstallLatestCommand}"
                      IsVisible="{Binding Firmware.CanInstallLatest}">
                <TextBlock Text="{Binding Firmware.Latest?.Version, StringFormat={x:Static loc:Strings.Chameleon_FirmwareUpdateTo}}" />
              </Button>
              <Button Content="{x:Static loc:Strings.Chameleon_ReleaseNotes}" Command="{Binding Firmware.OpenReleaseCommand}"
                      IsVisible="{Binding Firmware.IsUpdateAvailable}" />
              <Button Content="{x:Static loc:Strings.Chameleon_InstallFromFile}" Command="{Binding Firmware.InstallFromFileCommand}"
                      IsVisible="{Binding Firmware.CanInstall}"
                      ToolTip.Tip="{x:Static loc:Strings.Chameleon_InstallADFUPackageUltraDfu}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Device settings: edited here, sent to the device by the save bar. -->
        <Border Classes="card">
          <StackPanel>
            <StackPanel Spacing="2" Margin="0,0,0,14">
              <TextBlock Text="{x:Static loc:Strings.Chameleon_DeviceSettingsHeader}" Classes="overline" />
              <TextBlock Classes="caption hint" TextWrapping="Wrap"
                         Text="{x:Static loc:Strings.Chameleon_BehaviorAndControlsSaveSendsYour}" />
            </StackPanel>
            <!-- LED animation -->
            <c:SettingRow Classes="setting">
              <Border Classes="iconwell amber">
                <PathIcon Data="{StaticResource Icon.led}" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_LEDAnimation}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_LightPatternOnWakeUp}" />
              <ComboBox Classes="control"
                        ItemsSource="{Binding AnimationModes}"
                        SelectedItem="{Binding AnimationMode}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </c:SettingRow>

            <Separator Classes="row" />

            <!-- Sleep timeout -->
            <c:SettingRow Classes="setting">
              <Border Classes="iconwell blue">
                <PathIcon Data="{StaticResource Icon.sleep}" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_SleepTimeout}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_IdleSecondsBeforeSleep560}" />
              <NumericUpDown Classes="control stepper" Minimum="5" Maximum="60" Increment="1"
                             FormatString="0" Value="{Binding SleepTimeout}" />
            </c:SettingRow>

            <Separator Classes="row" />

            <!-- Button A -->
            <c:SettingRow Classes="setting">
              <Border Classes="iconwell green">
                <TextBlock Text="A" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_ButtonA}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_ActionOnAShortPress}" />
              <ComboBox Classes="control"
                        ItemsSource="{Binding ButtonFunctions}" SelectedItem="{Binding ButtonAShort}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </c:SettingRow>

            <Separator Classes="row" />

            <!-- Button A (long press) -->
            <c:SettingRow Classes="setting">
              <Border Classes="iconwell green">
                <TextBlock Text="A" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_ButtonALongPress}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_ActionOnALongPress}" />
              <ComboBox Classes="control"
                        ItemsSource="{Binding ButtonFunctions}" SelectedItem="{Binding ButtonALong}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </c:SettingRow>

            <Separator Classes="row" />

            <!-- Button B -->
            <c:SettingRow Classes="setting">
              <Border Classes="iconwell green">
                <TextBlock Text="B" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_ButtonB}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_ActionOnAShortPress}" />
              <ComboBox Classes="control"
                        ItemsSource="{Binding ButtonFunctions}" SelectedItem="{Binding ButtonBShort}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </c:SettingRow>

            <Separator Classes="row" />

            <!-- Button B (long press) -->
            <c:SettingRow Classes="setting">
              <Border Classes="iconwell green">
                <TextBlock Text="B" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_ButtonBLongPress}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_ActionOnALongPress}" />
              <ComboBox Classes="control"
                        ItemsSource="{Binding ButtonFunctions}" SelectedItem="{Binding ButtonBLong}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </c:SettingRow>

            <Separator Classes="row" IsVisible="{Binding SupportsLongPressThreshold}" />

            <!-- Long-press threshold -->
            <c:SettingRow Classes="setting" IsVisible="{Binding SupportsLongPressThreshold}">
              <Border Classes="iconwell blue">
                <PathIcon Data="{StaticResource Icon.button}" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_LongPressThreshold}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_HoldTimeForALongPress}" />
              <NumericUpDown Classes="control stepper" Minimum="100" Maximum="2000" Increment="50"
                             FormatString="0" Value="{Binding LongPressThreshold}" />
            </c:SettingRow>

            <Separator Classes="row" IsVisible="{Binding SupportsBle}" />

            <!-- BLE pairing -->
            <c:SettingRow Classes="setting" IsVisible="{Binding SupportsBle}">
              <Border Classes="iconwell blue">
                <PathIcon Data="{StaticResource Icon.ble}" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_BluetoothPairing}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_RequireAPINToConnectOver}" />
              <ToggleSwitch VerticalAlignment="Center" OnContent="" OffContent=""
                            IsChecked="{Binding BlePairingEnabled}" />
            </c:SettingRow>

            <Separator Classes="row" IsVisible="{Binding SupportsBle}" />

            <!-- BLE PIN -->
            <c:SettingRow Classes="setting" IsVisible="{Binding SupportsBle}">
              <Border Classes="iconwell blue">
                <PathIcon Data="{StaticResource Icon.key}" />
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Chameleon_PairingPIN}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_6DigitsBlankKeepsTheCurrent}" />
              <TextBox Classes="control mono" MaxLength="6" Text="{Binding BlePin}"
                       PlaceholderText="••••••" ToolTip.Tip="{x:Static loc:Strings.Chameleon_TheDefaultPINIs123456}" />
            </c:SettingRow>
          </StackPanel>
        </Border>

        <!-- Danger zone: rows laid out like settings, without icons (hidden placeholders). -->
        <Border Classes="card" BorderBrush="{actipro:ThemeResource ControlBackgroundBrushSoftDanger}">
          <StackPanel>
            <!-- Bonded BLE devices -->
            <c:SettingRow IsVisible="{Binding SupportsBle}">
              <Panel IsVisible="False" />
              <TextBlock Text="{x:Static loc:Strings.Chameleon_ClearBondedDevices}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_ForgetsEveryPhoneAndTabletPaired}" />
              <Button x:Name="ClearBondsButton" Classes="danger">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.ble}" />
                  <TextBlock Text="{x:Static loc:Strings.Chameleon_ClearBonds2}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel Spacing="12" MaxWidth="280">
                      <TextBlock Text="{x:Static loc:Strings.Chameleon_ClearAllBondedBLEDevices}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_PairedPhonesAndTabletsWillHave}" />
                      <Button Classes="danger solid" HorizontalAlignment="Right" Content="{x:Static loc:Strings.Chameleon_ClearBonds}"
                              Command="{Binding ClearBondsCommand}" Click="OnCloseFlyout" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </c:SettingRow>

            <Separator Classes="row" IsVisible="{Binding SupportsBle}" />

            <c:SettingRow>
              <Panel IsVisible="False" />
              <TextBlock Text="{x:Static loc:Strings.Chameleon_ResetToDefaults}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_RestoresFactorySettingsForLEDsSleep}" />
              <Button x:Name="ResetButton" Classes="danger">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.reset}" />
                  <TextBlock Text="{x:Static loc:Strings.Chameleon_Reset}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel Spacing="12" MaxWidth="260">
                      <TextBlock Text="{x:Static loc:Strings.Chameleon_ResetAllSettings}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_CurrentDeviceSettingsWillBeReplaced}" />
                      <Button Classes="danger solid" HorizontalAlignment="Right" Content="{x:Static loc:Strings.Chameleon_ResetSettings}"
                              Command="{Binding ResetCommand}" Click="OnCloseFlyout" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </c:SettingRow>

            <Separator Classes="row" />

            <!-- Factory reset (wipe) -->
            <c:SettingRow>
              <Panel IsVisible="False" />
              <TextBlock Text="{x:Static loc:Strings.Chameleon_FactoryReset}" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_WipesALLDataEverySlotNickname}" />
              <Button x:Name="WipeButton" Classes="danger">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.delete}" />
                  <TextBlock Text="{x:Static loc:Strings.Chameleon_FactoryReset2}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel Spacing="12" MaxWidth="280">
                      <TextBlock Text="{x:Static loc:Strings.Chameleon_FactoryResetTheChameleon}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption" Text="{x:Static loc:Strings.Chameleon_AllSlotsNicknamesEmulatorDataAnd}" />
                      <Button Classes="danger solid" HorizontalAlignment="Right" Content="{x:Static loc:Strings.Chameleon_EraseEverything}"
                              Command="{Binding FactoryResetCommand}" Click="OnCloseFlyout" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </c:SettingRow>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===================== Save bar (stays in view) ===================== -->
    <!-- Appears only once a device setting changed. -->
    <Border Grid.Row="1" Classes="savebar pagebar" IsVisible="{Binding IsDirty}">
      <StackPanel>
        <DockPanel Classes="saveerror" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <PathIcon Data="{StaticResource Icon.error}" />
          <TextBlock Text="{Binding SaveError}" />
        </DockPanel>
        <c:ActionBar>
          <TextBlock Text="{x:Static loc:Strings.Common_UnsavedChanges}" VerticalAlignment="Center" FontWeight="SemiBold" />
          <Button Content="{x:Static loc:Strings.Common_Discard}" Command="{Binding DiscardCommand}" />
          <Button Classes="accent" Command="{Binding SaveCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Chameleon_SendTheseValuesToTheDevice}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.save}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </c:ActionBar>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
