<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:t="using:ChameLab.Transport"
             xmlns:conv="using:ChameLab.Converters"
             xmlns:c="using:ChameLab.Controls"
             xmlns:b="using:ChameLab.Behaviors"
             x:Class="ChameLab.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

  <!-- As the window gets shorter, the device list gives up height first (it scrolls by itself),
       then the hero shrinks and puts the device beside the title (code-behind); only after that
       does the page scroll. -->
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="Page" Classes="page" MaxWidth="540" VerticalAlignment="Center" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

      <!-- Hero: device above the title, or beside it on short windows. -->
      <Grid x:Name="Hero" Grid.Row="0" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto"
            IsVisible="{Binding !IsSharing}"
            HorizontalAlignment="Center" Margin="0,8,0,4">
        <Image x:Name="HeroImage" Grid.ColumnSpan="2" Source="/Assets/chameleon-ultra.png" Height="120"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality">
          <Image.Effect>
            <DropShadowEffect OffsetX="0" OffsetY="8" BlurRadius="24" Color="#59000000" />
          </Image.Effect>
        </Image>
        <StackPanel x:Name="HeroText" Grid.Row="1" Grid.ColumnSpan="2" Spacing="8" Margin="0,16,0,0"
                    VerticalAlignment="Center">
          <TextBlock x:Name="HeroTitle" Text="{x:Static loc:Strings.Connect_ConnectYourChameleon}" Classes="h1" HorizontalAlignment="Center" />
          <TextBlock x:Name="HeroCaption" Classes="caption" HorizontalAlignment="Center" TextAlignment="Center"
                     MaxWidth="380" TextWrapping="Wrap"
                     Text="{Binding IntroHint}" />
        </StackPanel>
      </Grid>

      <!-- Detected devices. While a device is shared, only the share tile stays. -->
      <Border Grid.Row="1" Classes="card" IsVisible="{Binding !IsSharing}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <!-- Laid out like a setting: on a narrow card the title takes the full width and the hint
               shares the next line with the button. No icon (hidden placeholder). -->
          <c:SettingRow Grid.Row="0">
            <Panel IsVisible="False" />
            <TextBlock Text="{x:Static loc:Strings.Connect_DetectedDevices}" Classes="h2" />
            <TextBlock Classes="caption" Text="{Binding ScanHint}" />
            <Button Command="{Binding ScanCommand}" ToolTip.Tip="{x:Static loc:Strings.Connect_ScanAgain}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.refresh}" />
                <TextBlock Text="{x:Static loc:Strings.Connect_Rescan}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:SettingRow>

          <!-- Rows like the other lists (cards, slots); one column, and pulled out by the rows' own
               padding so they line up with the card's content. -->
          <ListBox Grid.Row="1" x:Name="DeviceList" Classes="cards devices" Margin="-4,0"
                   ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected}"
                   MaxHeight="260" IsVisible="{Binding HasCandidates}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="t:TransportCandidate">
                <Border Classes="cardrow">
                  <Grid ColumnDefinitions="Auto,*" Margin="12">
                    <!-- Every listed candidate is a Chameleon, so show the device rather than a port glyph. -->
                    <Panel Grid.Column="0" Width="36" Height="44" Margin="0,0,12,0">
                      <Image Source="/Assets/chameleon-ultra.png" Height="42"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Classes="iconwell" Width="20" Height="20" CornerRadius="10" Padding="0"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-2">
                        <PathIcon Width="11" Height="11"
                                  Data="{Binding Kind, Converter={x:Static conv:IconGeometryConverter.Instance}}" />
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty state -->
          <Border Grid.Row="1" Classes="inset" Padding="18" IsVisible="{Binding !HasCandidates}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <PathIcon Data="{Binding PrimaryKind, Converter={x:Static conv:IconGeometryConverter.Instance}}"
                        Width="28" Height="28" Opacity="0.5"
                        HorizontalAlignment="Center" />
              <TextBlock Text="{x:Static loc:Strings.Connect_NoDevicesDetected}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="320"
                         Text="{Binding EmptyHint}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="2" Spacing="10">
            <!-- Web Bluetooth: a new device can only be picked in the browser's own chooser. -->
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding PickCommand}" IsVisible="{Binding CanPick}"
                    ToolTip.Tip="{x:Static loc:Strings.Connect_PickAChameleonInTheBrowsers}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.ble}" />
                <TextBlock Text="{x:Static loc:Strings.Connect_PairOverBluetooth}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="accent" Height="56" HorizontalAlignment="Center" Padding="24,0"
                    Command="{Binding ConnectCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource Icon.link}" Width="24" Height="24" />
                <TextBlock Text="{x:Static loc:Strings.Connect_Connect}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Manual TCP endpoint, tucked away as an advanced option. -->
      <Expander Grid.Row="2" HorizontalAlignment="Stretch" CornerRadius="14" IsVisible="{Binding !IsSharing}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource Icon.tcp}" Width="16" Height="16" />
            <TextBlock Text="{x:Static loc:Strings.Connect_NetworkBridgeTCP}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="10">
          <TextBlock Classes="caption"
                     Text="{x:Static loc:Strings.Connect_ConnectThroughAUSBSerialTCP}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding ManualEndpoint}" PlaceholderText="host:port"
                     Classes="mono" />
            <Button Grid.Column="1" Classes="soft accent" Command="{Binding ConnectManualCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.link}" />
                <TextBlock Text="{x:Static loc:Strings.Connect_Connect}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Expander>

      <!-- A device someone shares over the internet, joined with the code they pass on. -->
      <Expander Grid.Row="3" HorizontalAlignment="Stretch" CornerRadius="14" IsVisible="{Binding ShowJoinShared}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource Icon.remote}" Width="16" Height="16" />
            <TextBlock Text="{x:Static loc:Strings.Connect_SharedDevice}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="10">
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static loc:Strings.Connect_SharedDeviceHint}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding SharedCode}" PlaceholderText="TR1-ABCD-1234" Classes="mono" />
            <Button Grid.Column="1" Classes="soft accent" Command="{Binding ConnectSharedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.link}" />
                <TextBlock Text="{x:Static loc:Strings.Connect_Connect}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Expander>

      <!-- Sharing the selected device of this computer (desktop only). -->
      <Expander Grid.Row="4" HorizontalAlignment="Stretch" CornerRadius="14" IsVisible="{Binding ShowShareTile}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource Icon.remote}" Width="16" Height="16" />
            <TextBlock Text="{x:Static loc:Strings.Share_Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="10">
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static loc:Strings.Share_Hint}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" FontWeight="SemiBold" Text="{x:Static loc:Strings.Share_Warning}" />
          <Button Classes="soft accent" HorizontalAlignment="Center" Command="{Binding ShareCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.share}" />
              <TextBlock Text="{x:Static loc:Strings.Share_Start}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Expander>

      <!-- While sharing, the only tile: the shared Chameleon, the code to pass on, who is connected,
           the traffic so far, and Stop sharing. -->
      <Border Grid.Row="4" Classes="card" IsVisible="{Binding IsSharing}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource Icon.remote}" Width="16" Height="16" />
            <TextBlock Text="{x:Static loc:Strings.Share_Title}" Classes="h2" VerticalAlignment="Center" />
          </StackPanel>

          <Border Classes="inset" Padding="12" DataContext="{Binding SharedDevice}">
            <Grid ColumnDefinitions="Auto,*" x:DataType="t:TransportCandidate">
              <Panel Grid.Column="0" Width="36" Height="44" Margin="0,0,12,0">
                <Image Source="/Assets/chameleon-ultra.png" Height="42"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <Border Classes="iconwell" Width="20" Height="20" CornerRadius="10" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-2">
                  <PathIcon Width="11" Height="11"
                            Data="{Binding Kind, Converter={x:Static conv:IconGeometryConverter.Instance}}" />
                </Border>
              </Panel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Spacing="4" IsVisible="{Binding ShareCode, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{x:Static loc:Strings.Share_CodeLabel}" Classes="overline" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <SelectableTextBlock Text="{Binding ShareCode}" Classes="mono" FontSize="28" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
              <Button Classes="icon small" VerticalAlignment="Center" b:CopyToClipboard.Text="{Binding ShareCode}">
                <PathIcon Data="{StaticResource Icon.copy}" />
              </Button>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{Binding ShareStatus}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Classes="inset">
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Static loc:Strings.Share_TrafficToDevice}" Classes="overline" />
                <TextBlock Text="{Binding TrafficToDevice}" Classes="value mono" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="inset">
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Static loc:Strings.Share_TrafficFromDevice}" Classes="overline" />
                <TextBlock Text="{Binding TrafficFromDevice}" Classes="value mono" />
              </StackPanel>
            </Border>
          </Grid>

          <Button Classes="soft danger" HorizontalAlignment="Center" Command="{Binding StopSharingCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.close}" />
              <TextBlock Text="{x:Static loc:Strings.Share_Stop}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
