<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:c="using:ChameLab.Controls"
             xmlns:conv="using:ChameLab.Converters"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Views.SlotsView"
             x:DataType="vm:SlotsViewModel">

  <!-- Laid out like the Cards page; the shared styles are under "Library pages" in ControlStyles. -->
  <UserControl.Styles>
    <!-- The color the slot LED shows for a card. -->
    <Style Selector="Ellipse.led">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Round LED swatch that opens the palette (the header color strip is Button.colorpick). -->
    <Style Selector="Button.ledpick">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ledpick:pointerover > Border.swatch">
      <Setter Property="BorderBrush" Value="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- Slot number in the list rows and the editor header. -->
    <Style Selector="Border.slotnum.small">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <!-- A frequency without a card: its tile and "Empty" fade back. -->
    <Style Selector="Border.chip.off">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- The hidden name and type lines of an empty frequency: they only hold its height. -->
    <Style Selector="StackPanel.ghost">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- Line between the HF and LF cards of a slot tile. -->
    <Style Selector="Border.tilesep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{actipro:ThemeResource Container1BorderBrush}" />
    </Style>
    <!-- The picker lists one card per row and is wider than the save questions. -->
    <Style Selector="Border.savebar.dialog.picker">
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.cards.picker">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- Content of a saved card row, as in the Cards list. -->
    <DataTemplate x:Key="CardTile" x:DataType="vm:CardItemViewModel">
      <Border Classes="cardrow"><Border Classes="cardclip">
        <Grid ColumnDefinitions="8,*" ColumnSpacing="14">
          <Border Grid.Column="0" Background="{Binding ColorBrush}" />
          <StackPanel Grid.Column="1" Margin="0,10" Spacing="0">
            <c:Marquee><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" /></c:Marquee>
            <TextBlock Text="{Binding Summary}" Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border></Border>
    </DataTemplate>

    <!-- A slot: its number, then the HF card above the LF card (name, type below), a line between them.
         An LF side that cycles through several cards lists all their names on its line.
         The list rows and the editor header. An empty frequency keeps its two lines, hidden, so every
         slot is the same height; "Empty" sits centered over them. -->
    <DataTemplate x:Key="SlotTile" x:DataType="vm:SlotItemViewModel">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="2">
        <Border Grid.Column="0" Grid.RowSpan="3" Classes="slotnum small" Classes.active="{Binding IsActive}"
                VerticalAlignment="Top">
          <TextBlock Text="{Binding Index}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <Border Classes="chip hf" Classes.off="{Binding !HasHf}" VerticalAlignment="Center">
            <TextBlock Text="HF" />
          </Border>
          <Panel Grid.Column="1">
            <StackPanel Classes.ghost="{Binding !HasHf}">
              <c:Marquee><TextBlock Text="{Binding HfLabel}" FontWeight="SemiBold" /></c:Marquee>
              <TextBlock Text="{Binding HfTypeLabel}" Classes="caption" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{x:Static loc:Strings.Common_Empty}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding !HasHf}" />
          </Panel>
        </Grid>
        <Border Grid.Row="1" Grid.Column="1" Classes="tilesep" />
        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <Border Classes="chip lf" Classes.off="{Binding !HasLf}" VerticalAlignment="Center">
            <TextBlock Text="LF" />
          </Border>
          <Panel Grid.Column="1">
            <StackPanel Classes.ghost="{Binding !HasLf}">
              <c:Marquee><TextBlock Text="{Binding LfNames}" FontWeight="SemiBold" /></c:Marquee>
              <TextBlock Text="{Binding LfTypeLabel}" Classes="caption" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{x:Static loc:Strings.Common_Empty}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding !HasLf}" />
          </Panel>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SlotLed" x:DataType="vm:SlotSideViewModel">
        <!-- LED color -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" IsVisible="{Binding HasCard}">
          <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Slots_LEDColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="1" Classes="segmented compact">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment" IsChecked="{Binding IsColorDefault}"
                           ToolTip.Tip="{x:Static loc:Strings.Slots_TheFirmwaresOwnColorGreenFor}">
                <TextBlock Text="{x:Static loc:Strings.Slots_Default}" FontWeight="SemiBold" />
              </RadioButton>
              <RadioButton Classes="segment" IsChecked="{Binding IsColorCard}" IsEnabled="{Binding CanUseCardColor}"
                           ToolTip.Tip="{x:Static loc:Strings.Slots_TheColorOfTheSavedCard}">
                <TextBlock Text="{x:Static loc:Strings.Common_Card}" FontWeight="SemiBold" />
              </RadioButton>
              <RadioButton Classes="segment" IsChecked="{Binding IsColorCustom}" IsEnabled="{Binding SupportsColors}"
                           ToolTip.Tip="{x:Static loc:Strings.Slots_AColorOfYourChoiceNeeds}">
                <TextBlock Text="{x:Static loc:Strings.Slots_Custom}" FontWeight="SemiBold" />
              </RadioButton>
            </StackPanel>
          </Border>
          <Panel Grid.Column="2" VerticalAlignment="Center">
            <Border Classes="swatch" IsVisible="{Binding !IsColorCustom}" ToolTip.Tip="{x:Static loc:Strings.Slots_TheColorTheSlotLEDShows}"
                    Background="{Binding LedPreview, Converter={x:Static conv:HexBrushConverter.Instance}}" />
            <Button Classes="ledpick" IsVisible="{Binding IsColorCustom}" ToolTip.Tip="{x:Static loc:Strings.Slots_PickTheLEDColor}">
              <Border Classes="swatch" Background="{Binding LedPreview, Converter={x:Static conv:HexBrushConverter.Instance}}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ListBox Classes="swatches" ItemsSource="{x:Static vm:CardEditorViewModel.Palette}"
                           SelectedItem="{Binding CustomColor}" Background="Transparent" BorderThickness="0"
                           Tapped="OnSwatchTapped">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="8" ColumnSpacing="2" RowSpacing="2" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="swatch" Background="{Binding Converter={x:Static conv:HexBrushConverter.Instance}}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Panel>
        </Grid>

    </DataTemplate>

    <!-- One frequency of the slot: its card, choose / clear, and the LED color. -->
    <DataTemplate x:Key="SlotSide" x:DataType="vm:SlotSideViewModel">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Classes="chip" Classes.hf="{Binding IsHf}" Classes.lf="{Binding IsLf}">
            <TextBlock Text="{Binding Label}" />
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Band}" Classes="caption" VerticalAlignment="Center" />
        </Grid>

        <!-- A saved card: its tile opens it in Cards. -->
        <Button Classes="cardtile" IsVisible="{Binding HasMatch}" Command="{Binding OpenCardCommand}"
                ToolTip.Tip="{x:Static loc:Strings.Slots_OpenThisCardInCards}">
          <Border Classes="cardclip">
            <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="14"
                  DataContext="{Binding Match}" x:DataType="vm:CardItemViewModel">
              <Border Grid.Column="0" Background="{Binding ColorBrush}" />
              <StackPanel Grid.Column="1" Margin="0,10" Spacing="0">
                <c:Marquee><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" /></c:Marquee>
                <TextBlock Text="{Binding Summary}" Classes="caption" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <PathIcon Grid.Column="2" Data="{StaticResource Icon.edit}" Width="16" Height="16" Opacity="0.6"
                        VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Button>

        <!-- A card that is not in Saved cards. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding IsUnmatched}">
          <StackPanel VerticalAlignment="Center">
            <c:Marquee><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /></c:Marquee>
            <TextBlock Classes="caption" Text="{Binding UnmatchedSummary}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding SaveToLibraryCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Slots_ReadTheCardFromTheSlot}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.save}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- No card: "Empty" on the line of the buttons. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Common_Empty}" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding PickCommand}" ToolTip.Tip="{x:Static loc:Strings.Slots_PutOneOfYourSavedCards}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.cards}" />
                <TextBlock Text="{x:Static loc:Strings.Slots_ChooseSaved}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="danger" Command="{Binding ClearCommand}" IsVisible="{Binding HasCard}"
                    ToolTip.Tip="{x:Static loc:Strings.Slots_RemoveTheCardFromThisFrequency}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Clear}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SlotLed}" />

      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Name="Split" Classes="page cardsplit" ColumnDefinitions="*,Auto" Classes.open="{Binding HasPane}"
        b:SplitLayout.DetailWidth="400,460">

    <!-- ==================== Slot list ==================== -->
    <Grid Grid.Column="0" Classes="listpane panestack" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Spacing="2">
        <TextBlock Text="{x:Static loc:Strings.Slots_EmulationSlots}" Classes="h1" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="caption" Text="{Binding CountText}" />
      </StackPanel>

      <!-- No device / not read yet -->
      <Border Grid.Row="1" Classes="card" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,12">
          <PathIcon Data="{StaticResource Icon.slots}" Width="40" Height="40" Opacity="0.4"
                    HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static loc:Strings.Slots_NoSlotsToShow}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                     Text="{x:Static loc:Strings.Slots_ConnectAChameleonToSeeAnd}" />
        </StackPanel>
      </Border>

      <!-- Opened by a click (ListReorder, see SlotsView.axaml.cs); the slots keep the device's order,
           and a slot dropped onto another swaps contents with it. Reaches past the column by as much
           as the list is padded, like the Cards list, so a dragged row's shadow is not clipped. -->
      <ScrollViewer Grid.Row="1" Name="ListScroll" IsVisible="{Binding !IsEmpty}" Margin="-12,0,-12,-16">
        <ListBox Name="SlotList" Classes="cards" ItemsSource="{Binding Slots}" Padding="8,0,8,12"
                 SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SlotItemViewModel">
              <Panel>
                <Border Classes="cardrow" ToolTip.Tip="{Binding Summary}"><Border Classes="cardclip">
                  <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                    <!-- The LED colors of the slot's cards, HF above LF. -->
                    <UniformGrid Grid.Column="0" Columns="1">
                      <Border IsVisible="{Binding HasHf}"
                              Background="{Binding HfLed, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                      <Border IsVisible="{Binding HasLf}"
                              Background="{Binding LfLed, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                    </UniformGrid>
                    <ContentControl Grid.Column="1" Margin="0,10" Content="{Binding}"
                                    ContentTemplate="{StaticResource SlotTile}" />
                  </Grid>
                </Border></Border>
                <Border Classes="dragframe" />
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
    </Grid>

    <!-- ==================== Slot editor ==================== -->
    <Grid Classes="detailpane" RowDefinitions="Auto,*,Auto">
      <!-- Header + actions (stays in view); disabled under the lightbox so Tab can't reach it. -->
      <Border Grid.Row="0" Classes="card" Margin="0,0,0,12" IsVisible="{Binding HasPane}"
              IsEnabled="{Binding !IsAsking}">
        <StackPanel>
          <!-- The back arrow sits under the slot number, centered on it (36 wide against 30). -->
          <Panel>
            <ContentControl Content="{Binding Selected}" ContentTemplate="{StaticResource SlotTile}" />
            <Button Classes="icon backonly" Margin="-3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_BackToTheList}"
                    b:DialogKeys.IsBack="True">
              <PathIcon Data="{StaticResource Icon.back}" />
            </Button>
          </Panel>
        </StackPanel>
      </Border>

      <!-- Nothing open (desktop only) -->
      <Border Grid.Row="1" Classes="card" VerticalAlignment="Top" IsVisible="{Binding !HasPane}">
        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,20">
          <PathIcon Data="{StaticResource Icon.slots}" Width="34" Height="34" Opacity="0.4"
                    HorizontalAlignment="Center" />
          <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="280" TextWrapping="Wrap"
                     Text="{x:Static loc:Strings.Slots_SelectASlotToMakeIt}" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" IsVisible="{Binding HasPane}" IsEnabled="{Binding !IsAsking}">
        <StackPanel Classes="panestack" DataContext="{Binding Editor}" x:DataType="vm:SlotEditorViewModel">

          <!-- ===================== HF (with the emulator settings of its card) ===================== -->
          <Border Classes="card">
            <StackPanel Spacing="14">
              <ContentControl Content="{Binding Hf}" ContentTemplate="{StaticResource SlotSide}" />

              <!-- MIFARE Classic emulator settings -->
              <StackPanel Spacing="10" IsVisible="{Binding ShowMfcSettings}">
                <TextBlock Text="{x:Static loc:Strings.Slots_MifareClassicEmulatorHeader}" Classes="overline" />
                <StackPanel Margin="20,0,0,0" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{x:Static loc:Strings.Slots_Gen1AMagicMode}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                    IsChecked="{Binding Gen1a}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{x:Static loc:Strings.Slots_Gen2MagicMode}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                    IsChecked="{Binding Gen2}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{x:Static loc:Strings.Slots_UseUIDSAKATQAFromBlock}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                    IsChecked="{Binding BlockAntiColl}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{x:Static loc:Strings.Slots_ResetOnFieldOff}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                    IsChecked="{Binding FieldOffReset}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                      <TextBlock Text="{x:Static loc:Strings.Slots_WriteMode}" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                ItemsSource="{x:Static vm:SlotEditorViewModel.WriteModes}" SelectedItem="{Binding MfcWriteMode}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.Slots_PRNGType}" VerticalAlignment="Center" />
                      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                ItemsSource="{x:Static vm:SlotEditorViewModel.PrngTypes}" SelectedItem="{Binding Prng}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                </StackPanel>
              </StackPanel>

              <!-- Ultralight / NTAG emulator settings -->
              <StackPanel Spacing="10" IsVisible="{Binding ShowUlSettings}">
                <TextBlock Text="{x:Static loc:Strings.Slots_UltralightNtagEmulatorHeader}" Classes="overline" />
                <StackPanel Margin="20,0,0,0" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{x:Static loc:Strings.Slots_UIDMagicMode}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                      IsChecked="{Binding UlUidMagic}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{x:Static loc:Strings.Slots_PasswordDetection}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                      IsChecked="{Binding UlDetection}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <TextBlock Text="{x:Static loc:Strings.Slots_WriteMode}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static vm:SlotEditorViewModel.WriteModes}" SelectedItem="{Binding UlWriteMode}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ===================== LF ===================== -->
          <Border Classes="card">
            <StackPanel>
              <ContentControl Content="{Binding Lf}" ContentTemplate="{StaticResource SlotSide}"
                              IsVisible="{Binding !SupportsMultiLf}" />
              <StackPanel Spacing="12" IsVisible="{Binding SupportsMultiLf}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Classes="chip lf"><TextBlock Text="LF" /></Border>
                <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Common_125KHz}" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding LfCards.CountLabel}" Classes="caption" VerticalAlignment="Center" />
              </Grid>
              <ListBox Classes="cards" DataContext="{Binding LfCards}" x:DataType="vm:LfSlotListViewModel"
                       ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                       b:BringIntoViewOnShow.Item="{Binding RevealCard}"
                       Loaded="OnLfCardListLoaded" Background="Transparent" BorderThickness="0"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LfSlotCardViewModel">
                    <Border Classes="cardrow"><Border Classes="cardclip">
                      <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="14">
                        <Border Background="{Binding Item.ColorBrush}" />
                        <StackPanel Grid.Column="1" Margin="0,10">
                          <c:Marquee><TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="15" /></c:Marquee>
                          <TextBlock Text="{Binding Item.Summary}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Classes="icon small" Command="{Binding SaveCommand}" IsVisible="{Binding !HasMatch}"
                                  b:ListReorder.IsAction="True" ToolTip.Tip="{x:Static loc:Strings.Slots_AddThisCardToSavedCards}" AutomationProperties.Name="{x:Static loc:Strings.Slots_SaveCard}">
                            <PathIcon Data="{StaticResource Icon.save}" />
                          </Button>
                          <Button Classes="icon small danger" Command="{Binding RemoveCommand}" b:ListReorder.IsAction="True"
                                  ToolTip.Tip="{x:Static loc:Strings.Slots_RemoveCardFromSlot}" AutomationProperties.Name="{x:Static loc:Strings.Slots_RemoveCardFromSlot}">
                            <PathIcon Data="{StaticResource Icon.delete}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border></Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{x:Static loc:Strings.Common_Empty}" Classes="caption" IsVisible="{Binding !LfCards.HasCards}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static loc:Strings.Slots_DragCardsToChangeTheOrder}"
                           Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding LfCards.CanReorder}" />
                <Button Grid.Column="1" Command="{Binding Lf.PickCommand}" IsEnabled="{Binding LfCards.CanAdd}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.cards}" />
                    <TextBlock Text="{Binding LfCards.ChooseLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <ContentControl Content="{Binding Lf}" ContentTemplate="{StaticResource SlotLed}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Lightbox: dims and blocks the editor while a question waits for an answer. -->
      <Border Grid.Row="0" Grid.RowSpan="2" Classes="lightbox" Classes.on="{Binding IsAsking}" CornerRadius="12" />

      <!-- ===================== Save bar (stays in view) ===================== -->
      <!-- Appears only once something changed. -->
      <Border Grid.Row="2" Classes="savebar">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsDirty" />
            <Binding Path="!IsAsking" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel>
          <DockPanel Classes="saveerror" IsVisible="{Binding Editor?.SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource Icon.error}" />
            <TextBlock Text="{Binding Editor?.SaveError}" />
          </DockPanel>
          <c:ActionBar>
            <TextBlock Text="{x:Static loc:Strings.Common_UnsavedChanges}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Content="{x:Static loc:Strings.Common_Discard}" Command="{Binding DiscardCommand}" />
            <Button Classes="accent" Command="{Binding SaveSlotCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Slots_WriteTheSlotToTheDevice}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Slots_SaveSlot}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionBar>
        </StackPanel>
      </Border>
      <!-- Switching slot, closing or swapping with unsaved edits: save, drop them, or stay. -->
      <Border Grid.Row="0" Grid.RowSpan="3" Classes="savebar dialog" IsVisible="{Binding IsConfirmingLeave}">
        <c:ActionBar>
          <TextBlock Text="{Binding LeaveText}" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding StayCommand}" b:DialogKeys.IsCancel="True"
                  ToolTip.Tip="{x:Static loc:Strings.Slots_KeepEditingThisSlot}" />
          <Button Content="{x:Static loc:Strings.Common_Discard}" Command="{Binding DiscardAndLeaveCommand}" />
          <Button Classes="accent" Command="{Binding SaveAndLeaveCommand}" b:DialogKeys.IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.save}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </c:ActionBar>
      </Border>
      <!-- Choosing a saved card for a frequency: search, then click one. -->
      <Border Grid.Row="0" Grid.RowSpan="3" Name="PickerDialog" Classes="savebar dialog picker"
              DataContext="{Binding Editor}" x:DataType="vm:SlotEditorViewModel" IsVisible="{Binding IsPicking}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding PickerTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="icon small" Command="{Binding ClosePickerCommand}"
                    b:DialogKeys.IsCancel="True" ToolTip.Tip="{x:Static loc:Strings.Common_Close}">
              <PathIcon Data="{StaticResource Icon.close}" />
            </Button>
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding PickerFilter}" Name="PickerSearch"
                   PlaceholderText="{x:Static loc:Strings.Common_SearchByNameTypeOrUID}">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource Icon.search}" Width="16" Height="16" Margin="10,0,2,0" Opacity="0.6" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <TextBlock Grid.Row="2" Classes="caption" Text="{Binding PickerEmptyText}"
                     IsVisible="{Binding PickerHasNoCards}" />
          <ScrollViewer Grid.Row="2" MaxHeight="360" Margin="-4,0,-4,0">
            <ListBox Classes="cards picker" ItemsSource="{Binding PickerCards}" Padding="0"
                     SelectedItem="{Binding PickerSelected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CardItemViewModel">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardTile}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
