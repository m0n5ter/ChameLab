<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="720"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:conv="using:ChameLab.Converters"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:c="using:ChameLab.Controls"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Views.DictionariesView"
             x:DataType="vm:DictionariesViewModel">

  <UserControl.Styles>
    <!-- React to the list pane's own width, including when details use most of the window. -->
    <Style Selector="Grid.dictionary-list TextBox.library-search">
      <Setter Property="Grid.Column" Value="2" />
    </Style>
    <Style Selector="Grid.dictionary-list.narrow TextBox.library-search">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="Grid.dictionary-list Button.library-clear">
      <Setter Property="Grid.Row" Value="0" />
    </Style>
    <Style Selector="Grid.dictionary-list.narrow Button.library-clear">
      <Setter Property="Grid.Row" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- Laid out like the Cards page; the shared styles are under "Library pages" in ControlStyles. -->
  <Grid Classes="page cardsplit" ColumnDefinitions="*,Auto" Classes.open="{Binding HasPane}"
        b:SplitLayout.DetailWidth="380,420">

    <!-- ==================== Dictionary list ==================== -->
    <!-- Locked while a new dictionary is open: save it or discard it to get back to the list. -->
    <Grid Grid.Column="0" Classes="listpane panestack dictionary-list" RowDefinitions="Auto,*"
          SizeChanged="OnListPaneSizeChanged"
          IsEnabled="{Binding !IsNew}">
      <!-- Measure the title first; give actions the remaining finite width so they collapse by priority. -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{x:Static loc:Strings.Common_KeyDictionaries}" Classes="h1" TextWrapping="NoWrap" />
          <TextBlock Classes="caption" Text="{Binding CountText}" TextWrapping="NoWrap" />
        </StackPanel>
        <c:ActionRow Grid.Column="1" Classes="library-actions" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Command="{Binding ImportCommand}" IsEnabled="{Binding CanUseFiles}"
                VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.Dictionaries_ImportADicKeysTxtJson}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.import}" />
            <TextBlock Text="{x:Static loc:Strings.Common_Import}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="accent" Command="{Binding NewCommand}" VerticalAlignment="Center" c:ActionRow.Priority="1"
                ToolTip.Tip="{x:Static loc:Strings.Dictionaries_StartANewDictionary}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.add}" />
            <TextBlock Text="{x:Static loc:Strings.Dictionaries_NewDictionary}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        </c:ActionRow>
      </Grid>

      <!-- Under the title everything scrolls together once the window is too short for the list's
           minimum; until then the list fills the rest and scrolls on its own. The scroller reaches past
           the column like the list used to, so a dragged row's shadow is not clipped. -->
      <ScrollViewer Grid.Row="1" Name="ListPaneScroll" Margin="-12,0,-12,-16" HorizontalScrollBarVisibility="Disabled">
        <c:FillStack Classes="panestack" Margin="12,0,12,16">
          <StackPanel Spacing="10">
            <Button Classes="accent theme-outline" Command="{Binding OpenKnownKeysCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Height="NaN" Padding="16,12"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_EditKnownKeysGroupedByCard}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.key}" Width="22" Height="22" VerticalAlignment="Center" />
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static loc:Strings.Dictionaries_KnownCardKeys}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="{Binding KnownKeysCountText}" Classes="caption" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Separator />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8"
                IsVisible="{Binding !IsEmpty}">
            <ComboBox Grid.Column="0" ItemsSource="{Binding SortModes}" SelectedItem="{Binding Sort}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{x:Static loc:Strings.Dictionaries_OrderOfTheListInManual}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Classes="library-search" Text="{Binding Filter}" PlaceholderText="{x:Static loc:Strings.Dictionaries_SearchByNameOrKey}">
              <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource Icon.search}" Width="16" Height="16" Margin="10,0,2,0" Opacity="0.6" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="3" Classes="icon library-clear" Command="{Binding ResetFiltersCommand}"
                    VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.Dictionaries_ClearSearch}">
              <PathIcon Data="{StaticResource Icon.close}" />
            </Button>
            <ComboBox Grid.Column="1" ItemsSource="{Binding KeyLengthFilters}"
                      SelectedItem="{Binding KeyLengthFilter}" VerticalAlignment="Center"
                      AutomationProperties.Name="{x:Static loc:Strings.Dictionaries_KeyLength}"
                      ToolTip.Tip="{x:Static loc:Strings.Dictionaries_KeyLength}">
              <ComboBox.Styles>
                <Style Selector="ComboBoxItem" x:DataType="vm:DictionaryLengthFilter">
                  <Setter Property="IsEnabled" Value="{Binding !IsSeparator}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="ComboBoxItem:disabled">
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Padding" Value="0,4" />
                </Style>
              </ComboBox.Styles>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DictionaryLengthFilter">
                  <Panel>
                    <Separator IsVisible="{Binding IsSeparator}" />
                    <TextBlock Text="{Binding Label}" IsVisible="{Binding !IsSeparator}" />
                  </Panel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Panel c:FillStack.Fill="True" MinHeight="180">
          <!-- Empty library -->
          <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
            <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,12">
              <PathIcon Data="{StaticResource Icon.key}" Width="40" Height="40" Opacity="0.4" HorizontalAlignment="Center" />
              <TextBlock Text="{x:Static loc:Strings.Dictionaries_NoDictionariesYet}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="360"
                         Text="{x:Static loc:Strings.Dictionaries_PressToStartADictionaryOf}" />
            </StackPanel>
          </Border>

          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Dictionaries_NoDictionariesMatchTheSearch}"
                     IsVisible="{Binding NoMatches}" VerticalAlignment="Top" />

          <!-- In manual order the dictionaries can be dragged into place (ListReorder). Reaches past the
               column by as much as the list is padded, so a dragged row's shadow is not clipped. -->
          <ScrollViewer Name="ListScroll" IsVisible="{Binding !IsEmpty}" Margin="-12,0,-12,-16">
            <ListBox Name="DictList" Classes="cards" ItemsSource="{Binding Dictionaries}" Padding="8,0,8,12"
                     SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DictionaryItemViewModel">
                  <Panel>
                    <Border Classes="cardrow"><Border Classes="cardclip">
                      <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0" Background="{Binding ColorBrush}" />
                        <StackPanel Grid.Column="1" Margin="0,10" Spacing="0">
                          <c:Marquee><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" /></c:Marquee>
                          <TextBlock Text="{Binding CountLabel}" Classes="caption" TextWrapping="NoWrap" />
                        </StackPanel>
                        <PathIcon Grid.Column="2" Data="{StaticResource Icon.key}" Width="16" Height="16"
                                  VerticalAlignment="Center" Opacity="0.5" />
                      </Grid>
                    </Border></Border>
                    <Border Classes="dragframe" />
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
          </Panel>
        </c:FillStack>
      </ScrollViewer>
    </Grid>

    <!-- ==================== Dictionary pane ==================== -->
    <Grid Classes="detailpane" RowDefinitions="Auto,*,Auto">
      <!-- Header + actions (stays in view); disabled under the lightbox so Tab can't reach it. -->
      <Border Grid.Row="0" Classes="card panehead" IsVisible="{Binding IsEditorPane}"
              IsEnabled="{Binding !IsAsking}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <Button Grid.Column="0" Classes="icon backonly" Margin="-8,0,6,0"
                    Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_BackToTheList}"
                    b:DialogKeys.IsBack="True">
              <PathIcon Data="{StaticResource Icon.back}" />
            </Button>
            <Button Grid.Column="1" Classes="colorpick" Margin="0,0,12,0" ToolTip.Tip="{x:Static loc:Strings.Dictionaries_DictionaryColor}">
              <Border Background="{Binding Form?.Color, Converter={x:Static conv:HexBrushConverter.Instance}}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ListBox Classes="swatches" ItemsSource="{x:Static vm:DictionariesViewModel.Palette}"
                           SelectedItem="{Binding Form?.Color}" Background="Transparent" BorderThickness="0"
                           Tapped="OnSwatchTapped">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="8" ColumnSpacing="2" RowSpacing="2" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="swatch" Background="{Binding Converter={x:Static conv:HexBrushConverter.Instance}}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Flyout>
              </Button.Flyout>
            </Button>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
              <TextBox Classes="titlebox" Text="{Binding Form?.Name}" MaxLength="64" PlaceholderText="{x:Static loc:Strings.Dictionaries_DictionaryName}" />
              <TextBlock Text="{Binding FormSource}" Classes="caption" TextWrapping="Wrap"
                         IsVisible="{Binding IsNew}" />
              <TextBlock Text="{Binding Form?.KeyCountText}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <c:ActionRow>
            <Button Command="{Binding DuplicateCommand}" IsVisible="{Binding IsOpen}"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_SaveACopyOfThisDictionary}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.copy}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Duplicate}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ExportCommand}" IsEnabled="{Binding CanUseFiles}" c:ActionRow.Priority="1"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_SaveAsADicFileOne}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.export}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Export}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="danger" Command="{Binding DeleteCommand}" IsVisible="{Binding IsOpen}"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_DeleteThisDictionary}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Delete}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionRow>
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.RowSpan="2" Classes="card" IsVisible="{Binding IsKnownKeys}"
              IsEnabled="{Binding !IsAsking}">
        <!-- Keep the header and search fixed; cards and keys share the rest of the height, and the working
             area scrolls only once the pane is shorter than their minimums. -->
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Classes="icon backonly" Margin="-8,0,6,0"
                    Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_BackToTheList}"
                    b:DialogKeys.IsBack="True">
              <PathIcon Data="{StaticResource Icon.back}" />
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Dictionaries_KnownCardKeys}" Classes="h1" VerticalAlignment="Center" />
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding KnownEditor.Filter}" PlaceholderText="{x:Static loc:Strings.Dictionaries_SearchByUIDOrCardName}">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource Icon.search}" Width="16" Height="16" Margin="10,0,2,0" Opacity="0.6" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ScrollViewer Grid.Row="2" Name="KnownScroll" Classes="reservebar" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
          <c:BalancedSplit MinHeight="{Binding #KnownScroll.Bounds.Height}">
          <!-- MinHeight: three rows, kept in step with the theme's row height by the code-behind. -->
          <Grid Name="KnownCards" MinHeight="104">
            <ListBox Name="KnownList" ItemsSource="{Binding KnownEditor.Uids}" SelectedItem="{Binding KnownEditor.Selected}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:KnownUidViewModel">
                  <!-- One line: the UID, then the card names sliding along when they don't fit. -->
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <TextBlock Text="{Binding DisplayUid}" FontWeight="Bold" TextWrapping="NoWrap" />
                    <c:Marquee Grid.Column="1" IsVisible="{Binding HasCardNames}" ToolTip.Tip="{Binding CardNames}">
                      <TextBlock Text="{Binding CardNamesText}" TextWrapping="NoWrap" />
                    </c:Marquee>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{x:Static loc:Strings.Dictionaries_NoCardsMatchTheSearch}" Classes="caption" Margin="8"
                       IsVisible="{Binding KnownEditor.NoMatches}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                IsVisible="{Binding KnownEditor.Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding KnownEditor.Selected?.DisplayUid}" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding KnownEditor.Selected?.KnownKeyCountText}" Classes="caption" />
              </StackPanel>
              <Button Grid.Column="1" Classes="danger" Command="{Binding KnownEditor.DeleteUidCommand}"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.delete}" />
                  <TextBlock Text="{x:Static loc:Strings.Dictionaries_ForgetCard}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
          </Grid>
          <Border Name="KnownKeysBox" Classes="inset" Padding="8,6" MinHeight="80"
                  IsVisible="{Binding KnownEditor.Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <c:HexEditor Name="KnownKeysEditor" Buffer="{Binding KnownEditor.Selected?.Form.Keys}" />
            </ScrollViewer>
          </Border>
        </c:BalancedSplit>
        </ScrollViewer>
        </Grid>
      </Border>

      <!-- Nothing open (desktop only) -->
      <Border Grid.Row="1" Classes="card" VerticalAlignment="Top" IsVisible="{Binding !HasPane}">
        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,20">
          <PathIcon Data="{StaticResource Icon.key}" Width="34" Height="34" Opacity="0.4" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="280" TextWrapping="Wrap"
                     Text="{x:Static loc:Strings.Dictionaries_SelectADictionaryToSeeAnd}" />
        </StackPanel>
      </Border>

      <!-- Keys: one per row in the hex editor, as card memory is; fills the pane and scrolls on its own.
           On a window too short for the editor's minimum, the card scrolls under the header instead. -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding IsEditorPane}" IsEnabled="{Binding !IsAsking}"
                    HorizontalScrollBarVisibility="Disabled">
        <c:FillStack>
          <Border Classes="card" c:FillStack.Fill="True" MinHeight="260">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
              <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="{x:Static loc:Strings.Dictionaries_KeysHeader}" Classes="overline" />
                <TextBlock Classes="caption hint" TextWrapping="Wrap"
                           Text="{x:Static loc:Strings.Dictionaries_OneKeyPerRowTypeHex}" />
              </StackPanel>
              <WrapPanel Grid.Row="1" Classes="hexlegend">
                <TextBlock Classes="access" Text="{x:Static loc:Strings.Dictionaries_Repeated}" />
                <TextBlock Classes="changed" Text="{x:Static loc:Strings.Common_Modified}" />
              </WrapPanel>
              <!-- Fixed-width position/value part, then the meaning (as under card memory). -->
              <TextBlock Grid.Row="2" Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding #KeysEditor.StatusDetail}"
                         IsVisible="{Binding #KeysEditor.StatusText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Run FontFamily="{x:Static c:AppFonts.Mono}" Text="{Binding #KeysEditor.StatusText}" />
                <Run Text="  " />
                <Run Text="{Binding #KeysEditor.StatusDetail}" />
              </TextBlock>
              <Border Grid.Row="3" Classes="inset" Padding="8,6">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <c:HexEditor x:Name="KeysEditor" Buffer="{Binding Form?.Keys}" />
                </ScrollViewer>
              </Border>
            </Grid>
          </Border>
        </c:FillStack>
      </ScrollViewer>

      <!-- Lightbox: dims and blocks the editor while a question waits for an answer. -->
      <Border Grid.Row="0" Grid.RowSpan="2" Classes="lightbox" Classes.on="{Binding IsAsking}" CornerRadius="12" />

      <!-- ===================== Save bars (stay in view) ===================== -->
      <!-- New: offered at once; Discard drops it and unlocks the list. -->
      <Border Grid.Row="2" Classes="savebar">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsNew" />
            <Binding Path="!IsConfirmingLeave" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel>
          <DockPanel Classes="saveerror" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource Icon.error}" />
            <TextBlock Text="{Binding SaveError}" />
          </DockPanel>
          <c:ActionBar>
            <!-- No message here, but ActionBar takes its first child as one; keep the slot empty. -->
            <TextBlock IsVisible="False" />
            <Button Content="{x:Static loc:Strings.Common_Discard}" Command="{Binding CancelNewCommand}" />
            <Button Classes="accent" Command="{Binding SaveCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionBar>
        </StackPanel>
      </Border>
      <!-- Saved dictionary: appears only once something changed. -->
      <Border Grid.Row="2" Classes="savebar">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsDirty" />
            <Binding Path="!IsConfirmingLeave" />
            <Binding Path="!IsConfirmingDelete" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel>
          <DockPanel Classes="saveerror" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource Icon.error}" />
            <TextBlock Text="{Binding SaveError}" />
          </DockPanel>
          <c:ActionBar>
            <TextBlock Text="{x:Static loc:Strings.Common_UnsavedChanges}" VerticalAlignment="Center" FontWeight="SemiBold" IsVisible="{Binding IsDirty}" />
            <Button Content="{x:Static loc:Strings.Common_Discard}" Command="{Binding DiscardCommand}" />
            <Button Classes="accent" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionBar>
        </StackPanel>
      </Border>
      <!-- Switching, closing or starting another with unsaved work: save, drop it, or stay. -->
      <Border Grid.Row="0" Grid.RowSpan="3" Classes="savebar dialog" IsVisible="{Binding IsConfirmingLeave}">
        <c:ActionBar>
          <TextBlock Text="{Binding LeaveText}" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
          <!-- Short of room, Cancel gives up its label first, then Discard; Save keeps it longest. -->
          <c:ActionRow>
            <Button Command="{Binding StayCommand}" b:DialogKeys.IsCancel="True"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_KeepEditingThisDictionary}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.close}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Cancel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding DiscardAndLeaveCommand}" c:ActionRow.Priority="1"
                    ToolTip.Tip="{x:Static loc:Strings.Common_Discard}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Discard}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding SaveAndLeaveCommand}" b:DialogKeys.IsDefault="True"
                    c:ActionRow.Priority="2" ToolTip.Tip="{x:Static loc:Strings.Common_Save}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionRow>
        </c:ActionBar>
      </Border>
      <Border Grid.Row="0" Grid.RowSpan="3" Classes="savebar dialog">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConfirmingDelete" />
            <Binding Path="!IsConfirmingLeave" />
          </MultiBinding>
        </Border.IsVisible>
        <c:ActionBar>
          <TextBlock Text="{x:Static loc:Strings.Dictionaries_DeleteThisDictionaryPermanently}" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelDeleteCommand}" b:DialogKeys.IsCancel="True" />
          <Button Classes="danger solid" Command="{Binding ConfirmDeleteCommand}" b:DialogKeys.IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.delete}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Delete}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </c:ActionBar>
      </Border>
    </Grid>
  </Grid>
</UserControl>
