<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="720"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:conv="using:ChameLab.Converters"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:c="using:ChameLab.Controls"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Views.DictionariesView"
             x:DataType="vm:DictionariesViewModel">

  <UserControl.Styles>
    <!-- React to the list pane's own width, including when details use most of the window. -->
    <Style Selector="Grid.dictionary-list TextBox.library-search">
      <Setter Property="Grid.Column" Value="2" />
    </Style>
    <Style Selector="Grid.dictionary-list.narrow TextBox.library-search">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Grid.Row" Value="1" />
    </Style>
    <Style Selector="Grid.dictionary-list Button.library-clear">
      <Setter Property="Grid.Row" Value="0" />
    </Style>
    <Style Selector="Grid.dictionary-list.narrow Button.library-clear">
      <Setter Property="Grid.Row" Value="1" />
    </Style>
  </UserControl.Styles>

  <!-- Laid out like the Cards page; the shared styles are under "Library pages" in ControlStyles. -->
  <Grid Classes="page cardsplit" ColumnDefinitions="*,Auto" Classes.open="{Binding HasPane}"
        b:SplitLayout.DetailWidth="380,420">

    <!-- ==================== Dictionary list ==================== -->
    <!-- Always usable: leaving a new or edited dictionary asks to save or discard it first. -->
    <Grid Grid.Column="0" Classes="listpane panestack dictionary-list" RowDefinitions="Auto,*"
          SizeChanged="OnListPaneSizeChanged">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
        <!-- Up from a folder to the one that holds it (or Dictionaries), also when the navigation pane is
             hidden (narrow, or closed). -->
        <Button Grid.Column="0" Classes="icon" Margin="-8,0,6,0" VerticalAlignment="Center"
                IsVisible="{Binding FolderTree.IsInFolder}" Command="{Binding FolderTree.ShowParentCommand}"
                ToolTip.Tip="{Binding FolderTree.BackTip}" b:DialogKeys.IsBack="True">
          <PathIcon Data="{StaticResource Icon.back}" />
        </Button>
        <!-- Short of room, the buttons drop their labels (New dictionary last); then the title trims. -->
        <c:TitleRow Grid.Column="1">
        <StackPanel Spacing="2">
          <!-- Dictionaries, or a folder's title, renamed in place by a click on it. -->
          <!-- Renaming: the title stays, unseen, so the header keeps its size; the field lies over it. -->
          <Panel Classes.renaming="{Binding FolderTree.IsRenamingFolder}">
            <TextBlock Text="{x:Static loc:Strings.Common_KeyDictionaries}" Classes="h1" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !FolderTree.IsInFolder}" />
            <TextBlock Text="{Binding FolderTree.Title}" Classes="h1" TextTrimming="CharacterEllipsis"
                       Classes.renamable="{Binding FolderTree.IsInFolder}" Tapped="OnFolderTitleTapped"
                       ToolTip.Tip="{Binding FolderTree.Current}" IsVisible="{Binding FolderTree.IsInFolder}" />
            <TextBox Classes="titlebox foldertitle" Text="{Binding FolderTree.FolderRenameText}" MaxLength="64"
                     IsVisible="{Binding FolderTree.IsRenamingFolder}" b:FocusOnShow.IsEnabled="True"
                     KeyDown="OnFolderTitleKeyDown" LostFocus="OnFolderTitleLostFocus" />
          </Panel>
          <TextBlock Classes="caption" Text="{Binding CountText}" TextWrapping="NoWrap" />
        </StackPanel>
        <c:ActionRow Classes="library-actions">
        <Button ToolTip.Tip="{x:Static loc:Strings.Common_MoveFolder}" IsVisible="{Binding FolderTree.IsInFolder}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.folder}" />
            <TextBlock Text="{x:Static loc:Strings.Common_Move}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <!-- Dictionaries (the top) or any folder outside the open one; folders in others are indented. -->
              <ScrollViewer Width="260" MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding FolderTree.MoveOptions}" SelectedItem="{Binding FolderTree.MoveTarget}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Tapped="OnFlyoutPickTapped">
                  <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FolderOption">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="{Binding Indent}">
                          <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.75" VerticalAlignment="Center"
                                    Data="{StaticResource Icon.key}" IsVisible="{Binding IsRoot}" />
                          <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.75" VerticalAlignment="Center"
                                    Data="{StaticResource Icon.folder}" IsVisible="{Binding !IsRoot}" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                     TextWrapping="Wrap" MaxLines="2" LineSpacing="-2" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Classes="danger" ToolTip.Tip="{x:Static loc:Strings.Common_DeleteFolder}"
                IsVisible="{Binding FolderTree.IsInFolder}" Command="{Binding FolderTree.DeleteCurrentCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.delete}" />
            <TextBlock Text="{x:Static loc:Strings.Common_Delete}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding FolderTree.OpenNewFolderCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_NewFolder}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.folderAdd}" />
            <TextBlock Text="{x:Static loc:Strings.Common_NewFolder}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="accent" Command="{Binding AddCommand}" VerticalAlignment="Center" c:ActionRow.Priority="1"
                ToolTip.Tip="{x:Static loc:Strings.Dictionaries_AddTip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.add}" />
            <TextBlock Text="{x:Static loc:Strings.Dictionaries_AddDictionary}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        </c:ActionRow>
        </c:TitleRow>
      </Grid>

      <!-- Under the title everything scrolls together once the window is too short for the list's
           minimum; until then the list fills the rest and scrolls on its own. The scroller reaches past
           the column like the list used to, so a dragged row's shadow is not clipped. -->
      <ScrollViewer Grid.Row="1" Name="ListPaneScroll" Margin="-12,0,-12,-16" HorizontalScrollBarVisibility="Disabled">
        <c:FillStack Classes="panestack" Margin="12,0,12,16">
          <StackPanel Spacing="10">
            <Button Classes="accent theme-outline" Command="{Binding OpenKnownKeysCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Height="NaN" Padding="16,12"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_EditKnownKeysGroupedByCard}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource Icon.key}" Width="22" Height="22" VerticalAlignment="Center" />
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static loc:Strings.Dictionaries_KnownCardKeys}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="{Binding KnownKeysCountText}" Classes="caption" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Separator />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8"
                IsVisible="{Binding !IsEmpty}">
            <ComboBox Grid.Column="0" ItemsSource="{Binding SortModes}" SelectedItem="{Binding Sort}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{x:Static loc:Strings.Dictionaries_OrderOfTheListInManual}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverter.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Classes="library-search" Text="{Binding Filter}" PlaceholderText="{x:Static loc:Strings.Dictionaries_SearchByNameOrKey}">
              <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource Icon.search}" Width="16" Height="16" Margin="10,0,2,0" Opacity="0.6" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="3" Classes="icon library-clear" Command="{Binding ResetFiltersCommand}"
                    VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.Dictionaries_ClearSearch}">
              <PathIcon Data="{StaticResource Icon.close}" />
            </Button>
            <ComboBox Grid.Column="1" ItemsSource="{Binding KeyLengthFilters}"
                      SelectedItem="{Binding KeyLengthFilter}" VerticalAlignment="Center"
                      AutomationProperties.Name="{x:Static loc:Strings.Dictionaries_KeyLength}"
                      ToolTip.Tip="{x:Static loc:Strings.Dictionaries_KeyLength}">
              <ComboBox.Styles>
                <Style Selector="ComboBoxItem" x:DataType="vm:DictionaryLengthFilter">
                  <Setter Property="IsEnabled" Value="{Binding !IsSeparator}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="ComboBoxItem:disabled">
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Padding" Value="0,4" />
                </Style>
              </ComboBox.Styles>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DictionaryLengthFilter">
                  <Panel>
                    <Separator IsVisible="{Binding IsSeparator}" />
                    <TextBlock Text="{Binding Label}" IsVisible="{Binding !IsSeparator}" />
                  </Panel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <Panel c:FillStack.Fill="True" MinHeight="180">
          <!-- Empty library -->
          <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
            <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,12">
              <PathIcon Data="{StaticResource Icon.key}" Width="40" Height="40" Opacity="0.4" HorizontalAlignment="Center" />
              <TextBlock Text="{x:Static loc:Strings.Dictionaries_NoDictionariesYet}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="360"
                         Text="{x:Static loc:Strings.Dictionaries_PressToStartADictionaryOf}" />
            </StackPanel>
          </Border>

          <!-- In manual order the dictionaries can be dragged into place, and in any order onto a folder
               (ListReorder). Reaches past the column by as much as the list is padded, so a dragged row's
               shadow is not clipped. -->
          <ScrollViewer Name="ListScroll" IsVisible="{Binding !IsEmpty}" Margin="-12,0,-12,-16">
            <StackPanel>
            <!-- In the flow above the list, so they never overlap the folder tiles below it. -->
            <TextBlock Classes="caption" Margin="12,0,12,8" Text="{x:Static loc:Strings.Dictionaries_NoDictionariesMatchTheSearch}"
                       IsVisible="{Binding NoMatches}" />
            <TextBlock Classes="caption" Margin="12,0,12,8" TextWrapping="Wrap" IsVisible="{Binding IsFolderEmpty}"
                       Text="{x:Static loc:Strings.Dictionaries_NoDictionariesInThisFolderYet}" />
            <ListBox Name="DictList" Classes="cards" ItemsSource="{Binding Dictionaries}" Padding="8,0,8,12"
                     SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DictionaryItemViewModel">
                  <Panel>
                    <Border Classes="cardrow"><Border Classes="cardclip">
                      <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0" Background="{Binding ColorBrush}" />
                        <StackPanel Grid.Column="1" Margin="0,10" Spacing="0">
                          <c:Marquee><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" /></c:Marquee>
                          <TextBlock Text="{Binding CountLabel}" Classes="caption" TextWrapping="NoWrap" />
                        </StackPanel>
                        <PathIcon Grid.Column="2" Data="{StaticResource Icon.key}" Width="16" Height="16"
                                  VerticalAlignment="Center" Opacity="0.5" />
                      </Grid>
                    </Border></Border>
                    <Border Classes="dragframe" />
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- The folders in the one shown (or in Dictionaries), after its own dictionaries. A tile opens its
                 folder, and dictionaries are dragged onto it like onto a folder in the navigation pane. -->
            <StackPanel Spacing="4" Margin="8,4,8,12" IsVisible="{Binding FolderTree.ShowsTiles}">
              <TextBlock Text="{x:Static loc:Strings.Cards_FoldersHeader}" Classes="overline" Margin="4,0" />
              <ItemsControl ItemsSource="{Binding FolderTree.Subfolders}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <c:TileGrid MinItemWidth="280" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderViewModel">
                    <Button Classes="foldertile" Classes.empty="{Binding IsEmpty}"
                            Command="{Binding OpenCommand}" b:ListReorder.IsDropTarget="True"
                            ToolTip.Tip="{Binding Name}">
                      <Border Classes="cardrow">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="14,8,14,8" MinHeight="36">
                          <PathIcon Grid.Column="0" Classes="foldericon" Width="20" Height="20"
                                    Data="{StaticResource Icon.folder}" />
                          <TextBlock Grid.Column="1" Classes="foldername" Text="{Binding Name}" FontWeight="SemiBold"
                                     FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                     LineSpacing="-2" TextTrimming="CharacterEllipsis" />
                          <!-- Just the number, in a frame; the open folder's header words it (“3 cards”). -->
                          <Border Grid.Column="2" Classes="foldercount" ToolTip.Tip="{Binding CountText}">
                            <TextBlock Classes="caption" Text="{Binding Count}" />
                          </Border>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </StackPanel>
          </ScrollViewer>
          </Panel>
        </c:FillStack>
      </ScrollViewer>
    </Grid>

    <!-- ==================== Dictionary pane ==================== -->
    <Grid Classes="detailpane" RowDefinitions="Auto,*,Auto">
      <!-- Header + actions (stays in view); disabled under the lightbox so Tab can't reach it. -->
      <Border Grid.Row="0" Classes="card panehead" IsVisible="{Binding IsEditorPane}"
              IsEnabled="{Binding !IsAsking}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <Button Grid.Column="0" Classes="icon backonly" Margin="-8,0,6,0"
                    Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_BackToTheList}"
                    b:DialogKeys.IsBack="True">
              <PathIcon Data="{StaticResource Icon.back}" />
            </Button>
            <Button Grid.Column="1" Classes="colorpick" Margin="0,0,12,0" ToolTip.Tip="{x:Static loc:Strings.Dictionaries_DictionaryColor}">
              <Border Background="{Binding Form?.Color, Converter={x:Static conv:HexBrushConverter.Instance}}" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ListBox Classes="swatches" ItemsSource="{x:Static vm:DictionariesViewModel.Palette}"
                           SelectedItem="{Binding Form?.Color}" Background="Transparent" BorderThickness="0"
                           Tapped="OnFlyoutPickTapped">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="8" ColumnSpacing="2" RowSpacing="2" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="swatch" Background="{Binding Converter={x:Static conv:HexBrushConverter.Instance}}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Flyout>
              </Button.Flyout>
            </Button>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
              <TextBox Classes="titlebox" Text="{Binding Form?.Name}" MaxLength="64" PlaceholderText="{x:Static loc:Strings.Dictionaries_DictionaryName}" />
              <TextBlock Text="{Binding FormSource}" Classes="caption" TextWrapping="Wrap"
                         IsVisible="{Binding IsNew}" />
              <TextBlock Text="{Binding Form?.KeyCountText}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <c:ActionRow>
            <Button Command="{Binding DuplicateCommand}" IsVisible="{Binding IsOpen}"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_SaveACopyOfThisDictionary}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.copy}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Duplicate}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding ExportCommand}" IsEnabled="{Binding CanUseFiles}" c:ActionRow.Priority="1"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_SaveAsADicFileOne}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.export}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Export}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button IsVisible="{Binding IsOpen}" ToolTip.Tip="{x:Static loc:Strings.Dictionaries_MoveThisDictionaryToAFolder}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.folder}" />
                <TextBlock Text="{Binding DictionaryFolderLabel}" VerticalAlignment="Center"
                           MaxWidth="140" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <!-- Fixed width: long names wrap onto a second line, tightly spaced, then trim; folders in
                       others are indented. No folder stands apart above the folders; one choice across both lists. -->
                  <StackPanel Width="260">
                    <ListBox ItemsSource="{Binding FolderTree.RootOptions}" SelectedItem="{Binding SelectedDictionaryFolder}"
                             Background="Transparent" BorderThickness="0" Tapped="OnFlyoutPickTapped">
                      <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FolderOption">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="{Binding Indent}">
                          <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.75" VerticalAlignment="Center"
                                    Data="{StaticResource Icon.key}" IsVisible="{Binding IsRoot}" />
                          <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.75" VerticalAlignment="Center"
                                    Data="{StaticResource Icon.folder}" IsVisible="{Binding !IsRoot}" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                     TextWrapping="Wrap" MaxLines="2" LineSpacing="-2" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Separator Margin="0,4" IsVisible="{Binding FolderTree.HasFolders}" />
                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                      <ListBox ItemsSource="{Binding FolderTree.Options}" SelectedItem="{Binding SelectedDictionaryFolder}"
                               Background="Transparent" BorderThickness="0"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled" Tapped="OnFlyoutPickTapped">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:FolderOption">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="{Binding Indent}">
                              <PathIcon Grid.Column="0" Width="16" Height="16" Opacity="0.75" VerticalAlignment="Center"
                                        Data="{StaticResource Icon.folder}" />
                              <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                         TextWrapping="Wrap" MaxLines="2" LineSpacing="-2"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="caption"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </ScrollViewer>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="danger" Command="{Binding DeleteCommand}" IsVisible="{Binding IsOpen}"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_DeleteThisDictionary}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Delete}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionRow>
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.RowSpan="2" Classes="card" IsVisible="{Binding IsKnownKeys}"
              IsEnabled="{Binding !IsAsking}">
        <!-- Keep the header and search fixed; cards and keys share the rest of the height, and the working
             area scrolls only once the pane is shorter than their minimums. -->
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Classes="icon backonly" Margin="-8,0,6,0"
                    Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_BackToTheList}"
                    b:DialogKeys.IsBack="True">
              <PathIcon Data="{StaticResource Icon.back}" />
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Dictionaries_KnownCardKeys}" Classes="h1" VerticalAlignment="Center" />
          </Grid>
          <!-- Search, then the card type: the filter keeps its natural width beside the search. -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding KnownEditor.Filter}" PlaceholderText="{x:Static loc:Strings.Dictionaries_SearchByUIDOrCardName}">
              <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource Icon.search}" Width="16" Height="16" Margin="10,0,2,0" Opacity="0.6" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding KnownEditor.FamilyOptions}"
                      SelectedItem="{Binding KnownEditor.FamilyFilter}" VerticalAlignment="Stretch"
                      ToolTip.Tip="{x:Static loc:Strings.Dictionaries_FilterByCardType}"
                      AutomationProperties.Name="{x:Static loc:Strings.Dictionaries_FilterByCardType}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:KnownCardFamilyOption">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <ScrollViewer Grid.Row="2" Name="KnownScroll" Classes="reservebar" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
          <c:BalancedSplit MinHeight="{Binding #KnownScroll.Bounds.Height}">
          <!-- MinHeight: three rows, kept in step with the theme's row height by the code-behind. -->
          <Grid Name="KnownCards" MinHeight="104">
            <ListBox Name="KnownList" ItemsSource="{Binding KnownEditor.Cards}" SelectedItem="{Binding KnownEditor.Selected}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:KnownCardViewModel">
                  <!-- One line: the UID, its type, then the card names sliding along when they don't fit. -->
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                    <TextBlock Text="{Binding DisplayUid}" FontWeight="Bold" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ShortTypeText}" Classes="caption" TextWrapping="NoWrap"
                               VerticalAlignment="Center" ToolTip.Tip="{Binding TypeText}" />
                    <c:Marquee Grid.Column="2" IsVisible="{Binding HasCardNames}" ToolTip.Tip="{Binding CardNames}">
                      <TextBlock Text="{Binding CardNamesText}" TextWrapping="NoWrap" />
                    </c:Marquee>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{x:Static loc:Strings.Dictionaries_NoCardsMatchTheSearch}" Classes="caption" Margin="8"
                       TextWrapping="Wrap" IsVisible="{Binding KnownEditor.NoMatches}" />
            <TextBlock Text="{x:Static loc:Strings.Dictionaries_KnownKeysEmpty}" Classes="caption" Margin="8"
                       TextWrapping="Wrap" IsVisible="{Binding KnownEditor.HasNoCards}" />
          </Grid>
          <StackPanel Spacing="10"
                      IsVisible="{Binding KnownEditor.Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding KnownEditor.Selected?.DisplayUid}" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding KnownEditor.Selected?.SummaryText}" Classes="caption" />
              </StackPanel>
              <Button Grid.Column="1" Classes="danger" Command="{Binding KnownEditor.DeleteCardCommand}"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.delete}" />
                  <TextBlock Text="{x:Static loc:Strings.Dictionaries_ForgetCard}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
            <!-- The stored type; cards learned before types were kept can be given one here. -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <TextBlock Text="{x:Static loc:Strings.Dictionaries_CardType}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding KnownEditor.Selected?.TagOptions}"
                        SelectedItem="{Binding KnownEditor.Selected?.SelectedTag}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Static loc:Strings.Dictionaries_CardType}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:KnownCardTagOption">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <!-- NTAG / T55XX: one 4-byte password instead of a list of keys. -->
            <StackPanel Spacing="4" IsVisible="{Binding KnownEditor.Selected?.HasPassword, FallbackValue=False}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Text="{x:Static loc:Strings.Dictionaries_KnownPassword}" VerticalAlignment="Center" />
                <c:HexBox Grid.Column="1" Text="{Binding KnownEditor.Selected?.Password}" ByteLengths="4"
                          PlaceholderText="00 00 00 00"
                          AutomationProperties.Name="{x:Static loc:Strings.Dictionaries_KnownPassword}" />
              </Grid>
              <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{Binding KnownEditor.Selected?.PasswordError}"
                         IsVisible="{Binding KnownEditor.Selected?.PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
          <Border Name="KnownKeysBox" Classes="inset" Padding="8,6" MinHeight="80"
                  IsVisible="{Binding KnownEditor.Selected?.IsClassic, FallbackValue=False}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <c:HexEditor Name="KnownKeysEditor" Buffer="{Binding KnownEditor.Selected?.Form.Keys}" />
            </ScrollViewer>
          </Border>
        </c:BalancedSplit>
        </ScrollViewer>
        </Grid>
      </Border>

      <!-- ===================== Add a dictionary ===================== -->
      <!-- Where a new dictionary comes from; it then opens in the editor to be reviewed and saved. -->
      <Border Grid.Row="0" Grid.RowSpan="2" Classes="card" VerticalAlignment="Top" IsVisible="{Binding IsPickingSource}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Classes="icon backonly" Margin="-8,0,6,0"
                    Command="{Binding CloseCommand}" ToolTip.Tip="{x:Static loc:Strings.Common_BackToTheList}"
                    b:DialogKeys.IsBack="True">
              <PathIcon Data="{StaticResource Icon.back}" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Dictionaries_AddADictionary}" Classes="h2" />
              <TextBlock Classes="caption hint" TextWrapping="Wrap" Text="{x:Static loc:Strings.Dictionaries_AddHint}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" Command="{Binding CloseCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Common_Cancel}" VerticalAlignment="Top">
              <PathIcon Data="{StaticResource Icon.close}" />
            </Button>
          </Grid>
          <c:FitGrid Columns="2" ColumnSpacing="8" RowSpacing="8">
                <Button Classes="tile source" Command="{Binding ImportCommand}" IsEnabled="{Binding CanUseFiles}"
                        ToolTip.Tip="{x:Static loc:Strings.Dictionaries_ImportADicKeysTxtJson}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="iconwell green" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.import}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static loc:Strings.Cards_ImportFile}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text=".dic, .keys, .txt, .json" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Classes="tile source" Command="{Binding NewCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.Dictionaries_StartANewDictionary}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="iconwell" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.edit}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static loc:Strings.Cards_EnterManually}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Static loc:Strings.Dictionaries_TypeKeysByHand}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Classes="tile source" Command="{Binding ShowDownloadsCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.Dictionaries_DownloadTip}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="iconwell blue" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.download}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static loc:Strings.Dictionaries_Download}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="Proxmark3, Flipper Zero" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
          </c:FitGrid>
        </StackPanel>
      </Border>

      <!-- ===================== Download a known dictionary ===================== -->
      <Border Grid.Row="0" Grid.RowSpan="2" Classes="card" IsVisible="{Binding IsPickingDownload}">
        <Grid RowDefinitions="Auto,*" RowSpacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Classes="icon" Margin="-8,0,6,0"
                    Command="{Binding BackToAddCommand}" ToolTip.Tip="{Binding DownloadBackTip}"
                    b:DialogKeys.IsBack="True">
              <PathIcon Data="{StaticResource Icon.back}" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Dictionaries_DownloadTitle}" Classes="h2" />
              <TextBlock Classes="caption hint" TextWrapping="Wrap" Text="{x:Static loc:Strings.Dictionaries_DownloadHint}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" Command="{Binding CloseCommand}"
                    ToolTip.Tip="{x:Static loc:Strings.Common_Cancel}" VerticalAlignment="Top">
              <PathIcon Data="{StaticResource Icon.close}" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <TextBlock Text="PROXMARK3" Classes="overline" />
                <ItemsControl ItemsSource="{Binding Proxmark3Downloads}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="1" RowSpacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KnownDictionaryItemViewModel">
                      <Button Classes="tile source" Command="{Binding DownloadCommand}"
                              IsEnabled="{Binding !$parent[UserControl].((vm:DictionariesViewModel)DataContext).IsBusy}"
                              ToolTip.Tip="{Binding Source.Url}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" ColumnSpacing="10">
                          <Border Classes="iconwell blue" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.download}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FileName}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" MinHeight="3"
                                       Margin="0,6,0,0" IsVisible="{Binding IsDownloading}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="6" />
                <TextBlock Text="FLIPPER ZERO" Classes="overline" />
                <ItemsControl ItemsSource="{Binding FlipperDownloads}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="1" RowSpacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KnownDictionaryItemViewModel">
                      <Button Classes="tile source" Command="{Binding DownloadCommand}"
                              IsEnabled="{Binding !$parent[UserControl].((vm:DictionariesViewModel)DataContext).IsBusy}"
                              ToolTip.Tip="{Binding Source.Url}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" ColumnSpacing="10">
                          <Border Classes="iconwell blue" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.download}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FileName}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" MinHeight="3"
                                       Margin="0,6,0,0" IsVisible="{Binding IsDownloading}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Nothing open (desktop only) -->
      <Border Grid.Row="1" Classes="card" VerticalAlignment="Top" IsVisible="{Binding !HasPane}">
        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,20">
          <PathIcon Data="{StaticResource Icon.key}" Width="34" Height="34" Opacity="0.4" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="280" TextWrapping="Wrap"
                     Text="{x:Static loc:Strings.Dictionaries_SelectADictionaryToSeeAnd}" />
        </StackPanel>
      </Border>

      <!-- Keys: one per row in the hex editor, as card memory is; fills the pane and scrolls on its own.
           On a window too short for the editor's minimum, the card scrolls under the header instead. -->
      <ScrollViewer Grid.Row="1" IsVisible="{Binding IsEditorPane}" IsEnabled="{Binding !IsAsking}"
                    HorizontalScrollBarVisibility="Disabled">
        <c:FillStack>
          <Border Classes="card" c:FillStack.Fill="True" MinHeight="260">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
              <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="{x:Static loc:Strings.Dictionaries_KeysHeader}" Classes="overline" />
                <TextBlock Classes="caption hint" TextWrapping="Wrap"
                           Text="{x:Static loc:Strings.Dictionaries_OneKeyPerRowTypeHex}" />
              </StackPanel>
              <WrapPanel Grid.Row="1" Classes="hexlegend">
                <TextBlock Classes="access" Text="{x:Static loc:Strings.Dictionaries_Repeated}" />
                <TextBlock Classes="changed" Text="{x:Static loc:Strings.Common_Modified}" />
              </WrapPanel>
              <!-- Fixed-width position/value part, then the meaning (as under card memory). -->
              <TextBlock Grid.Row="2" Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding #KeysEditor.StatusDetail}"
                         IsVisible="{Binding #KeysEditor.StatusText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Run FontFamily="{x:Static c:AppFonts.Mono}" Text="{Binding #KeysEditor.StatusText}" />
                <Run Text="  " />
                <Run Text="{Binding #KeysEditor.StatusDetail}" />
              </TextBlock>
              <Border Grid.Row="3" Classes="inset" Padding="8,6">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <c:HexEditor x:Name="KeysEditor" Buffer="{Binding Form?.Keys}" />
                </ScrollViewer>
              </Border>
            </Grid>
          </Border>
        </c:FillStack>
      </ScrollViewer>

      <!-- Lightbox: dims and blocks the editor while a question waits for an answer. -->
      <Border Grid.Row="0" Grid.RowSpan="2" Classes="lightbox" Classes.on="{Binding IsAsking}" CornerRadius="12" />

      <!-- ===================== Save bars (stay in view) ===================== -->
      <!-- New: offered at once; Discard drops it and unlocks the list. -->
      <Border Grid.Row="2" Classes="savebar">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsNew" />
            <Binding Path="!IsConfirmingLeave" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel>
          <DockPanel Classes="saveerror" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource Icon.error}" />
            <TextBlock Text="{Binding SaveError}" />
          </DockPanel>
          <c:ActionBar>
            <!-- No message here, but ActionBar takes its first child as one; keep the slot empty. -->
            <TextBlock IsVisible="False" />
            <Button Classes="danger" Command="{Binding CancelNewCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Discard}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding SaveCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionBar>
        </StackPanel>
      </Border>
      <!-- Saved dictionary: appears only once something changed. -->
      <Border Grid.Row="2" Classes="savebar">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsDirty" />
            <Binding Path="!IsConfirmingLeave" />
            <Binding Path="!IsConfirmingDelete" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel>
          <DockPanel Classes="saveerror" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource Icon.error}" />
            <TextBlock Text="{Binding SaveError}" />
          </DockPanel>
          <c:ActionBar>
            <!-- No message, but ActionBar takes its first child as one; keep the slot empty. -->
            <TextBlock IsVisible="False" />
            <Button Classes="danger" Command="{Binding DiscardCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Discard}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionBar>
        </StackPanel>
      </Border>
      <!-- Switching, closing or starting another with unsaved work: save, drop it, or stay. -->
      <Border Grid.Row="0" Grid.RowSpan="3" Classes="savebar dialog" IsVisible="{Binding IsConfirmingLeave}">
        <c:ActionBar>
          <TextBlock Text="{Binding LeaveText}" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
          <!-- Short of room, Cancel gives up its label first, then Discard; Save keeps it longest. -->
          <c:ActionRow>
            <Button Command="{Binding StayCommand}" b:DialogKeys.IsCancel="True"
                    ToolTip.Tip="{x:Static loc:Strings.Dictionaries_KeepEditingThisDictionary}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.close}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Cancel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="danger" Command="{Binding DiscardAndLeaveCommand}" c:ActionRow.Priority="1"
                    ToolTip.Tip="{x:Static loc:Strings.Common_Discard}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.delete}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Discard}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding SaveAndLeaveCommand}" b:DialogKeys.IsDefault="True"
                    c:ActionRow.Priority="2" ToolTip.Tip="{x:Static loc:Strings.Common_Save}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.save}" />
                <TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:ActionRow>
        </c:ActionBar>
      </Border>
      <Border Grid.Row="0" Grid.RowSpan="3" Classes="savebar dialog">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsConfirmingDelete" />
            <Binding Path="!IsConfirmingLeave" />
          </MultiBinding>
        </Border.IsVisible>
        <c:ActionBar>
          <TextBlock Text="{x:Static loc:Strings.Dictionaries_DeleteThisDictionaryPermanently}" VerticalAlignment="Center"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelDeleteCommand}" b:DialogKeys.IsCancel="True" />
          <Button Classes="danger solid" Command="{Binding ConfirmDeleteCommand}" b:DialogKeys.IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.delete}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Delete}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </c:ActionBar>
      </Border>
    </Grid>
  </Grid>
</UserControl>
