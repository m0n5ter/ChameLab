<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">

  <ScrollViewer>
    <StackPanel Classes="page" MaxWidth="860">

      <StackPanel Spacing="2">
        <TextBlock Text="Tools" Classes="h1" />
        <TextBlock Classes="caption" Text="Recover MIFARE Classic keys from a reader with mfkey32." />
      </StackPanel>

      <!-- ===================== mfkey32 wizard ===================== -->
      <Border Classes="card">
        <StackPanel Spacing="16">

          <!-- Header (always shown) -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="iconwell amber"><PathIcon Data="{StaticResource Icon.key}" /></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="mfkey32 key recovery" FontWeight="SemiBold" />
              <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="620"
                         Text="Capture a reader's login attempts on an emulated card and recover the sector key — the wizard sets everything up and puts it back when you're done." />
            </StackPanel>
          </StackPanel>

          <!-- ========== Step 1: Intro ========== -->
          <StackPanel Spacing="14" IsVisible="{Binding IsIntro}">
            <Border Classes="inset">
              <StackPanel Spacing="8">
                <TextBlock Text="WHAT THE WIZARD DOES" Classes="overline" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="1.  Switches the device to tag mode and puts a blank MIFARE Classic card on a free slot." />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="2.  Captures the reader's authentication attempts as you present the device." />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="3.  Recovers the key in-app as soon as it has enough, and lets you save it." />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="4.  Restores the device mode, active slot and the slot it used when you finish." />
              </StackPanel>
            </Border>
            <Button Classes="accent" HorizontalAlignment="Left" Command="{Binding StartCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.bolt}" />
                <TextBlock Text="Start wizard" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- ========== Step 2: Collecting ========== -->
          <StackPanel Spacing="14" IsVisible="{Binding IsCollecting}">
            <Border Classes="inset">
              <StackPanel Spacing="10">
                <TextBlock Text="HOLD THE DEVICE TO THE READER" Classes="overline" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Present your Chameleon to the reader as if it were the card, and let the reader try to read it a few times. Each attempt is captured automatically." />
                <ProgressBar IsIndeterminate="True" Height="3" />
                <TextBlock Text="{Binding CaptureText}" TextWrapping="Wrap" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Button HorizontalAlignment="Left" Command="{Binding FinishCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.close}" />
                <TextBlock Text="Cancel" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- ========== Step 3: Done ========== -->
          <StackPanel Spacing="14" IsVisible="{Binding IsDone}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.success}" Width="20" Height="20"
                        Foreground="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding KeyCountText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Keys}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecoveredKeyViewModel">
                  <Border Classes="inset" Margin="0,4">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Header}" Classes="caption" />
                        <SelectableTextBlock Text="{Binding KeyHex}" Classes="mono" FontWeight="SemiBold" FontSize="15" />
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                  VerticalAlignment="Center">
                        <Button b:CopyToClipboard.Text="{Binding KeyHex}" ToolTip.Tip="Copy the key">
                          <PathIcon Data="{StaticResource Icon.copy}" />
                        </Button>
                        <Button Classes="accent" Command="{Binding SaveCommand}"
                                ToolTip.Tip="Add the key to the “Recovered keys” dictionary">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.save}" IsVisible="{Binding !Saved}" />
                            <PathIcon Data="{StaticResource Icon.check}" IsVisible="{Binding Saved}" />
                            <TextBlock Text="Save" VerticalAlignment="Center" IsVisible="{Binding !Saved}" />
                            <TextBlock Text="Saved" VerticalAlignment="Center" IsVisible="{Binding Saved}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Command="{Binding FinishCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.check}" />
                  <TextBlock Text="Finish" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding RestartCommand}" ToolTip.Tip="Clear the captures and collect again">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.refresh}" />
                  <TextBlock Text="Scan again" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Saved keys go to the “Recovered keys” dictionary on the Dictionaries page." />
          </StackPanel>

        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
