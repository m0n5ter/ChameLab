<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:b="using:ChameLab.Behaviors"
             xmlns:c="using:ChameLab.Controls"
             xmlns:m="using:ChameLab.Models"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">

  <UserControl.Styles>
    <!-- Tool tiles, like the Add card sources: icon beside a label and a one-line hint. -->
    <Style Selector="Button.tile.source">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.tile.source Border.iconwell">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.tile.source Border.iconwell > PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <!-- Legend swatches under the waveform. -->
    <Style Selector="StackPanel.legend > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
    </Style>

    <!-- Short of room: icon only (the tooltip names the action), as in the card editor. -->
    <Style Selector="c|ActionRow > :is(Control).iconic > StackPanel > TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Label / value rows of the summaries. -->
    <Style Selector="Grid.facts > TextBlock.caption">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A recovered key. -->
    <Style Selector="Border.keybadge">
      <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidSuccess}" />
      <Setter Property="TextElement.Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSolidSuccess}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Frames: who sent each one; the card's answers are indented under the reader's commands. -->
    <Style Selector="ListBox.frames ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBlock.dir">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BrandBlueBrush}" />
    </Style>
    <Style Selector="TextBlock.dir.card">
      <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineSuccess}" />
    </Style>
    <Style Selector="ListBox.frames">
      <Setter Property="Height" Value="460" />
    </Style>
    <Style Selector=".compact ListBox.frames">
      <Setter Property="Height" Value="380" />
    </Style>


    <!-- The console's options: toggles shaped like the buttons beside them; on, they look like the checked
         All / HF / LF segment (a soft accent fill framed by a thin accent outline). A template of their own,
         since the theme's toggle draws a thick gray frame when checked. The 1px frame is always there
         (the button's own border until checked), so checking never resizes anything. -->
    <Style Selector="ToggleButton.option">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Background" Value="{actipro:ThemeResource ButtonBackgroundBrushSoft}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{actipro:ThemeResource ButtonForegroundBrush}" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.option:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{actipro:ThemeResource ButtonBackgroundBrushSoftPointerOver}" />
    </Style>
    <Style Selector="ToggleButton.option:pressed /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{actipro:ThemeResource ButtonBackgroundBrushSoftPressed}" />
    </Style>
    <Style Selector="ToggleButton.option:checked">
      <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSoftAccent}" />
    </Style>
    <Style Selector="ToggleButton.option:checked /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccent}" />
      <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
    </Style>
    <Style Selector="ToggleButton.option:checked:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccentPointerOver}" />
    </Style>
    <Style Selector="ToggleButton.option:checked:pressed /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccentPressed}" />
    </Style>
    <Style Selector="ToggleButton.option > StackPanel > PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <!-- The path and the command line: as tall as the buttons beside them. -->
    <Style Selector="TextBox.consoleline">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A word the console's hint line offers: a small badge, tinted toward the accent on hover, that puts it in
         the line when clicked. -->
    <Style Selector="Button.hintword">
      <Setter Property="Background" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
      <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSoftAccent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.hintword:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccentPointerOver}" />
      <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSoftAccent}" />
    </Style>
    <Style Selector="Button.hintword:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccentPressed}" />
      <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSoftAccent}" />
    </Style>

    <Style Selector="ScrollViewer.samples">
      <Setter Property="Height" Value="320" />
    </Style>

    <!-- Pages keep a readable width; the console uses the whole window for long output lines. -->
    <Style Selector="Grid.page.tools">
      <Setter Property="MaxWidth" Value="980" />
    </Style>
    <Style Selector="Grid.page.tools.fullwidth">
      <Setter Property="MaxWidth" Value="Infinity" />
    </Style>
    <!-- Dump comparison: a side's card, as a tile with the side's letter in a badge. -->
    <Style Selector="Button.compareside">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.sidebadge">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccent}" />
    </Style>
    <Style Selector="Border.sidebadge > TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSoftAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid Classes="page tools" Classes.fullwidth="{Binding IsConsole}" IsEnabled="{Binding !IsGen4Confirming}" RowDefinitions="Auto,*">

    <!-- ==================== Header: stays put while the results scroll ==================== -->
    <StackPanel Grid.Row="0" Spacing="10">
      <!-- The list of tools -->
      <StackPanel Spacing="2" IsVisible="{Binding IsHome}">
        <TextBlock Text="{x:Static loc:Strings.Tools_Tools}" Classes="h1" />
        <TextBlock Classes="caption hint" TextWrapping="Wrap"
                   Text="{x:Static loc:Strings.Tools_LookAtWhatGoesOverThe}" />
      </StackPanel>
      <!-- Two tiles to a row while both fit untrimmed, else one under the other. -->
      <c:FitGrid Columns="2" ColumnSpacing="8" RowSpacing="8" IsVisible="{Binding IsHome}">
        <Button Classes="tile source" Command="{Binding OpenHfCommand}"
                ToolTip.Tip="{x:Static loc:Strings.Tools_AnswerAReaderAsACard}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="iconwell blue" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.sniff}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Tools_SniffHF}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Static loc:Strings.Tools_1356MHzISO14443A}" Classes="caption" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Classes="tile source" Command="{Binding OpenLfCommand}"
                ToolTip.Tip="{x:Static loc:Strings.Tools_RecordTheRawSignalAtThe}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="iconwell amber" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.sniff}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Tools_SniffLF}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Static loc:Strings.Tools_125KHzRawSignal}" Classes="caption" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
        <!-- Gen4 configuration needs a Chameleon Ultra, so the tile shows only with a device connected. -->
        <Button Classes="tile source" Command="{Binding OpenGen4Command}" IsVisible="{Binding IsConnected}"
                ToolTip.Tip="{x:Static loc:Strings.Tools_Gen4Hint}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="iconwell blue" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.card}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Tools_Gen4Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Static loc:Strings.Tools_Gen4Hint}" Classes="caption" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
        <!-- T55xx recovery needs a device, so the tile shows only with one connected. -->
        <Button Classes="tile source" Command="{Binding OpenT55xxCommand}" IsVisible="{Binding IsConnected}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="iconwell amber" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.key}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Tools_T55xxPassword}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Static loc:Strings.Tools_T55xxDictionaryHint}" Classes="caption" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Classes="tile source" Command="{Binding OpenConsoleCommand}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="iconwell" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.console}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Tools_Console}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Static loc:Strings.Tools_ConsoleHint}" Classes="caption" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Classes="tile source" Command="{Binding OpenCompareCommand}"
                ToolTip.Tip="{x:Static loc:Strings.Compare_Hint}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="iconwell blue" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource Icon.compare}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static loc:Strings.Compare_Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Static loc:Strings.Compare_TileHint}" Classes="caption" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
      </c:FitGrid>

      <!-- A tool: Back to the list, as in Add card. -->
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" IsVisible="{Binding !IsHome}">
        <Button Classes="icon" Margin="-8,0,0,0" Command="{Binding BackCommand}"
                ToolTip.Tip="{x:Static loc:Strings.Tools_BackToTheTools}" b:DialogKeys.IsBack="True" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.back}" />
        </Button>
        <Border Grid.Column="1" Classes="iconwell" Classes.blue="{Binding IsHf}" Classes.amber="{Binding IsLf}"
                VerticalAlignment="Center">
          <Panel>
            <PathIcon Data="{StaticResource Icon.sniff}" IsVisible="{Binding IsHf}" />
            <PathIcon Data="{StaticResource Icon.sniff}" IsVisible="{Binding IsLf}" />
            <PathIcon Data="{StaticResource Icon.key}" IsVisible="{Binding IsT55xx}" />
            <PathIcon Data="{StaticResource Icon.card}" IsVisible="{Binding IsGen4}" />
            <PathIcon Data="{StaticResource Icon.console}" IsVisible="{Binding IsConsole}" />
            <PathIcon Data="{StaticResource Icon.compare}" IsVisible="{Binding IsCompare}" />
          </Panel>
        </Border>
        <!-- One line; short of width (long titles in some languages), it scales down to fit. -->
        <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="{Binding CurrentToolTitle}" />
        </Viewbox>
      </Grid>

      <!-- Compare dumps: the two cards -->
      <StackPanel Spacing="10" IsVisible="{Binding IsCompare}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Classes="caption hint" TextWrapping="Wrap" Text="{x:Static loc:Strings.Compare_Hint}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Command="{Binding CompareClearCommand}" IsVisible="{Binding HasCompareSide}"
                  VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.Compare_ClearTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.close}" />
              <TextBlock Text="{x:Static loc:Strings.Common_Clear}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <!-- Side by side while both fit, else one under the other. -->
        <c:FitGrid Columns="2" ColumnSpacing="8" RowSpacing="8">
          <Button Classes="compareside" Command="{Binding ChooseCompareACommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Classes="sidebadge" VerticalAlignment="Center">
                <TextBlock Text="A" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding HasCompareA}">
                <c:Marquee><TextBlock Text="{Binding CompareItemA?.Name}" FontWeight="SemiBold" /></c:Marquee>
                <c:Marquee><TextBlock Text="{Binding CompareItemA?.Summary}" Classes="caption" /></c:Marquee>
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding !HasCompareA}"
                         Text="{x:Static loc:Strings.Compare_ChooseA}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button Classes="compareside" Command="{Binding ChooseCompareBCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Classes="sidebadge" VerticalAlignment="Center">
                <TextBlock Text="B" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding HasCompareB}">
                <c:Marquee><TextBlock Text="{Binding CompareItemB?.Name}" FontWeight="SemiBold" /></c:Marquee>
                <c:Marquee><TextBlock Text="{Binding CompareItemB?.Summary}" Classes="caption" /></c:Marquee>
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding !HasCompareB}"
                         Text="{x:Static loc:Strings.Compare_ChooseB}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
        </c:FitGrid>
      </StackPanel>

      <!-- Console -->
      <StackPanel Spacing="2" IsVisible="{Binding IsConsole}">
        <TextBlock Classes="caption hint" TextWrapping="Wrap" Text="{x:Static loc:Strings.Tools_ConsoleIntro}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static vm:ToolsViewModel.ConsoleFilesNote}"
                   IsVisible="{x:Static vm:ToolsViewModel.HasConsoleFilesNote}" />
      </StackPanel>

      <!-- HF -->
      <StackPanel Spacing="10" IsVisible="{Binding IsHf}">
        <TextBlock Classes="caption hint" TextWrapping="Wrap"
                   Text="{x:Static loc:Strings.Tools_TheChameleonAnswersAReaderAs}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsConnected}"
                   Text="{x:Static loc:Strings.Tools_ConnectAChameleonToCaptureA}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsHfUnsupported}"
                   Foreground="{DynamicResource BrandAmberBrush}"
                   Text="{x:Static loc:Strings.Tools_ThisFirmwareHasNoHFSniffing}" />
        <!-- One line; when it gets tight, Save and Load drop their labels first, then Capture. -->
        <c:ActionRow>
          <ComboBox ItemsSource="{Binding HfDurations}" SelectedItem="{Binding HfSeconds}"
                    VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.Tools_HowLongToListen}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Int32">
                <TextBlock Text="{Binding StringFormat={x:Static loc:Strings.Tools_Seconds}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="accent" Command="{Binding HfCaptureCommand}" IsEnabled="{Binding IsConnected}"
                  c:ActionRow.Priority="2" ToolTip.Tip="{x:Static loc:Strings.Tools_ListenToTheReaderNow}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.sniff}" />
              <TextBlock Text="{Binding IsHfCapturing, Converter={x:Static vm:ToolsViewModel.CaptureLabel}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding HfLoadCommand}" IsEnabled="{Binding CanUseFiles}" c:ActionRow.Priority="1"
                  ToolTip.Tip="{x:Static loc:Strings.Tools_OpenAProxmark3TraceTrace}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.import}" /><TextBlock Text="{x:Static loc:Strings.Tools_Load}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding HfSaveCommand}" IsEnabled="{Binding CanUseFiles}"
                  ToolTip.Tip="{x:Static loc:Strings.Tools_SaveTheFramesAsAProxmark3}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.export}" /><TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </c:ActionRow>
        <TextBlock Classes="caption" Text="{Binding HfSource}"
                   IsVisible="{Binding HfSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- LF -->
      <StackPanel Spacing="10" IsVisible="{Binding IsLf}">
        <TextBlock Classes="caption hint" TextWrapping="Wrap"
                   Text="{x:Static loc:Strings.Tools_TurnsTheFieldOnAndRecords}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsConnected}"
                   Text="{x:Static loc:Strings.Tools_ConnectAChameleonToCaptureA2}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsUnsupported}"
                   Foreground="{DynamicResource BrandAmberBrush}"
                   Text="{x:Static loc:Strings.Tools_ThisFirmwareHasNoLFSniffing}" />
        <c:ActionRow>
          <Button Classes="accent" Command="{Binding CaptureCommand}" IsEnabled="{Binding IsConnected}"
                  c:ActionRow.Priority="2" ToolTip.Tip="{x:Static loc:Strings.Tools_RecordTheLFFieldNow}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.sniff}" /><TextBlock Text="{x:Static loc:Strings.Tools_Capture}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding LoadCommand}" IsEnabled="{Binding CanUseFiles}" c:ActionRow.Priority="1"
                  ToolTip.Tip="{x:Static loc:Strings.Tools_OpenARawCaptureBinOne}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.import}" /><TextBlock Text="{x:Static loc:Strings.Tools_Load}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding SaveCommand}" IsEnabled="{Binding CanUseFiles}"
                  ToolTip.Tip="{x:Static loc:Strings.Tools_SaveEverySampleAsARaw}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.export}" /><TextBlock Text="{x:Static loc:Strings.Common_Save}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </c:ActionRow>
        <TextBlock Classes="caption" Text="{Binding Source}"
                   IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </StackPanel>

    <!-- ==================== Results ==================== -->
    <!-- Fills the height so the console can take what the window has. -->
    <ScrollViewer Grid.Row="1" Margin="0,4,0,0">
      <c:FillStack Classes="panestack">

        <StackPanel Spacing="12" IsVisible="{Binding IsT55xx}">
          <TextBlock Classes="caption hint" TextWrapping="Wrap" Text="{x:Static loc:Strings.Tools_T55xxDescription}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsConnected}"
                     Text="{x:Static loc:Strings.Common_ConnectFirst}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsT55xxUnsupported}"
                     Foreground="{DynamicResource BrandAmberBrush}" Text="{x:Static loc:Strings.Tools_T55xxUnsupported}" />
          <Border Classes="card">
            <StackPanel Spacing="14">

              <Panel IsEnabled="{Binding !IsBusy}">
                <c:T55xxPasswordSettingsPanel DataContext="{Binding T55xxSettings}" />
              </Panel>

              <!-- Start runs the recovery; while it runs it becomes Cancel, with the progress to its right.
                   Once a key is recovered, Save keys sits beside Start. -->
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <!-- Start: shown only with a Chameleon connected, and not while a run is on. -->
                  <Button Classes="accent" Command="{Binding TryT55xxCommand}">
                    <Button.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsT55xxRunning" />
                        <Binding Path="IsConnected" />
                      </MultiBinding>
                    </Button.IsVisible>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.key}" />
                      <TextBlock Text="{x:Static loc:Strings.Common_Start}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <!-- Stop takes the Start spot while running, and answers Esc; styled like the dump's Stop. -->
                  <Button Classes="danger" Command="{Binding CancelT55xxCommand}"
                          IsVisible="{Binding IsT55xxRunning}" b:DialogKeys.IsCancel="True"
                          AutomationProperties.Name="{x:Static loc:Strings.Common_Stop}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.close}" />
                      <TextBlock Text="{x:Static loc:Strings.Common_Stop}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <!-- Save the recovered key, the same way the card editor saves its keys. -->
                  <DropDownButton IsVisible="{Binding CanSaveT55xxKey}"
                                  ToolTip.Tip="{x:Static loc:Strings.Cards_SaveTheCardsKeys}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.key}" />
                      <TextBlock Text="{x:Static loc:Strings.Cards_SaveKeys}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="{x:Static loc:Strings.Cards_KeysToClipboard}" Click="OnCopyT55xxKey">
                          <MenuItem.Icon><PathIcon Data="{StaticResource Icon.copy}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Classes="keystargets" Header="{x:Static loc:Strings.Cards_KeysToDictionary}"
                                  IsVisible="{Binding HasT55xxKeysTargets}" ItemsSource="{Binding T55xxKeysTargets}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource Icon.key}" /></MenuItem.Icon>
                          <MenuItem.Styles>
                            <Style Selector="MenuItem.keystargets > MenuItem" x:DataType="vm:KeysTargetViewModel">
                              <Setter Property="Command" Value="{Binding SaveCommand}" />
                              <Setter Property="Cursor" Value="Hand" />
                              <Setter Property="Template">
                                <ControlTemplate>
                                  <Border Name="PART_Row" Width="260" Margin="4,0" Padding="8,3" CornerRadius="6"
                                          Background="Transparent" x:DataType="vm:KeysTargetViewModel">
                                    <c:DictionaryRow Color="{Binding Item.ColorBrush}" Title="{Binding Item.Name}"
                                                     Count="{Binding Item.Dictionary.Count}" />
                                  </Border>
                                </ControlTemplate>
                              </Setter>
                            </Style>
                            <Style Selector="MenuItem.keystargets > MenuItem:pointerover /template/ Border#PART_Row, MenuItem.keystargets > MenuItem:selected /template/ Border#PART_Row">
                              <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPointerOver}" />
                            </Style>
                            <Style Selector="MenuItem.keystargets > MenuItem:pressed /template/ Border#PART_Row">
                              <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPressed}" />
                            </Style>
                          </MenuItem.Styles>
                        </MenuItem>
                        <MenuItem Header="{x:Static loc:Strings.Cards_KeysToNewDictionary}"
                                  Command="{Binding SaveT55xxKeyToNewDictionaryCommand}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource Icon.add}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static loc:Strings.Cards_KeysToFile}" Command="{Binding SaveT55xxKeyToFileCommand}"
                                  IsEnabled="{Binding CanUseFiles}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource Icon.export}" /></MenuItem.Icon>
                        </MenuItem>
                      </MenuFlyout>
                    </DropDownButton.Flyout>
                  </DropDownButton>
                </StackPanel>
                <!-- Progress bar and its label, to the right; gone once nothing runs (after Cancel or success). -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"
                            IsVisible="{Binding T55xxProgressText, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding T55xxProgress}" />
                  <TextBlock Text="{Binding T55xxProgressText}" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <!-- Result: the UID, the matching key and the new key, as hex. -->
              <StackPanel Spacing="6" Margin="30,0,0,0">
                <Grid ColumnDefinitions="72,*" ColumnSpacing="8"
                      IsVisible="{Binding T55xxUid, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{x:Static loc:Strings.Tools_T55xxUid}" Classes="caption" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding T55xxUid}" FontFamily="{x:Static c:AppFonts.Mono}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="72,*" ColumnSpacing="8"
                      IsVisible="{Binding T55xxFoundKey, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{x:Static loc:Strings.Tools_T55xxFound}" Classes="caption" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding T55xxFoundKey}" FontFamily="{x:Static c:AppFonts.Mono}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Classes.danger="{Binding T55xxNoMatch}" Classes.success="{Binding !T55xxNoMatch}" />
                </Grid>
                <Grid ColumnDefinitions="72,*" ColumnSpacing="8"
                      IsVisible="{Binding T55xxSetKey, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{x:Static loc:Strings.Tools_T55xxNew}" Classes="caption" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding T55xxSetKey}" FontFamily="{x:Static c:AppFonts.Mono}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Classes.danger="{Binding T55xxNoMatch}" Classes.success="{Binding !T55xxNoMatch}" />
                </Grid>
                <SelectableTextBlock Text="{Binding T55xxResult}" TextWrapping="Wrap" Margin="0,2,0,0"
                                     IsVisible="{Binding T55xxResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ========== Gen4 ========== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsGen4}">
          <TextBlock Classes="caption hint" TextWrapping="Wrap" Text="{x:Static loc:Strings.Tools_Gen4Intro}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsConnected}"
                     Text="{x:Static loc:Strings.Common_ConnectFirst}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsGen4Unsupported}"
                     Foreground="{DynamicResource BrandAmberBrush}" Text="{x:Static loc:Strings.Tools_Gen4UltraRequired}" />

          <!-- Password + Read configuration -->
          <Border Classes="card">
            <StackPanel Spacing="12">
              <Panel IsEnabled="{Binding !IsBusy}">
                <c:FormColumns ColumnSpacing="14" RowSpacing="10" LabelSpacing="6">
                  <TextBlock Classes="caption" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Tools_Gen4CurrentPassword}" />
                  <c:HexBox Text="{Binding Gen4Password}" ByteLengths="4" PlaceholderText="00 00 00 00"
                            AutomationProperties.Name="{x:Static loc:Strings.Tools_Gen4CurrentPassword}" />
                  <Panel />
                  <TextBlock Classes="caption danger" Margin="0,-6,0,0" TextWrapping="Wrap" c:FormColumns.Free="True"
                             Text="{Binding Gen4PasswordError}"
                             IsVisible="{Binding Gen4PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </c:FormColumns>
              </Panel>
              <WrapPanel ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center">
                <Button Classes="accent" Command="{Binding Gen4ReadCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.import}" />
                    <TextBlock Text="{x:Static loc:Strings.Tools_Gen4Read}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <SelectableTextBlock VerticalAlignment="Center" Classes="caption mono"
                                     IsVisible="{Binding Gen4HasVersion}"
                                     Text="{Binding Gen4Version, StringFormat={x:Static loc:Strings.Tools_Gen4VersionFormat}}" />
              </WrapPanel>
              <SelectableTextBlock TextWrapping="Wrap"
                                   Text="{Binding Gen4Status}"
                                   Classes.danger="{Binding Gen4Failed}"
                                   Classes.success="{Binding !Gen4Failed}">
                <SelectableTextBlock.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="Gen4HasStatus" />
                    <Binding Path="!Gen4HasConfig" />
                  </MultiBinding>
                </SelectableTextBlock.IsVisible>
              </SelectableTextBlock>
            </StackPanel>
          </Border>

          <!-- Configuration fields -->
          <Border Classes="card" IsVisible="{Binding Gen4HasConfig}">
            <StackPanel Spacing="14">
              <Panel IsEnabled="{Binding !IsBusy}">
                <c:FormColumns ColumnSpacing="14" RowSpacing="10" LabelSpacing="6">
                  <TextBlock Classes="caption" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Tools_Gen4Protocol}" />
                  <ComboBox ItemsSource="{Binding Gen4ProtocolOptions}" SelectedItem="{Binding Gen4ProtocolOption}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:Gen4Option">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Classes="caption" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Tools_Gen4UidLength}" />
                  <ComboBox ItemsSource="{Binding Gen4UidSizeOptions}" SelectedItem="{Binding Gen4UidSizeOption}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:Gen4Option">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Classes="caption" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Tools_Gen4Shadow}" />
                  <ComboBox ItemsSource="{Binding Gen4ShadowOptions}" SelectedItem="{Binding Gen4ShadowOption}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:Gen4Option">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <Panel />
                  <TextBlock Classes="caption hint" Margin="0,-6,0,0" TextWrapping="Wrap" c:FormColumns.Free="True"
                             Text="{x:Static loc:Strings.Tools_Gen4ShadowWarning}"
                             IsVisible="{Binding Gen4ShowShadowWarning}" />

                  <TextBlock Classes="caption" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Tools_Gen4NewPassword}" />
                  <c:HexBox Text="{Binding Gen4NewPassword}" ByteLengths="4" PlaceholderText="00 00 00 00"
                            AutomationProperties.Name="{x:Static loc:Strings.Tools_Gen4NewPassword}" />
                  <Panel />
                  <StackPanel Spacing="2" Margin="0,-6,0,0" c:FormColumns.Free="True">
                    <TextBlock Classes="caption hint" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Tools_Gen4PasswordHelp}" />
                    <TextBlock Classes="caption danger" TextWrapping="Wrap"
                               Text="{Binding Gen4NewPasswordError}"
                               IsVisible="{Binding Gen4NewPasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>

                  <TextBlock Classes="caption" VerticalAlignment="Center" Text="ATS" />
                  <c:HexBox Text="{Binding Gen4Ats}" PlaceholderText="{x:Static loc:Strings.Cards_Optional2}"
                            TextWrapping="Wrap" AutomationProperties.Name="ATS" />
                  <Panel />
                  <StackPanel Spacing="2" Margin="0,-6,0,0" c:FormColumns.Free="True">
                    <TextBlock Classes="caption hint" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Tools_Gen4AtsHelp}" />
                    <TextBlock Classes="caption danger" TextWrapping="Wrap"
                               Text="{Binding Gen4AtsError}"
                               IsVisible="{Binding Gen4AtsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>

                  <TextBlock Classes="caption" VerticalAlignment="Center" Text="ATQA" />
                  <c:HexBox Text="{Binding Gen4Atqa}" ByteLengths="2" PlaceholderText="00 04"
                            AutomationProperties.Name="ATQA" />
                  <Panel />
                  <TextBlock Classes="caption danger" Margin="0,-6,0,0" TextWrapping="Wrap" c:FormColumns.Free="True"
                             Text="{Binding Gen4AtqaError}"
                             IsVisible="{Binding Gen4AtqaError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <TextBlock Classes="caption" VerticalAlignment="Center" Text="SAK" />
                  <c:HexBox Text="{Binding Gen4Sak}" ByteLengths="1" PlaceholderText="08"
                            AutomationProperties.Name="SAK" />
                  <Panel />
                  <StackPanel Spacing="2" Margin="0,-6,0,0" c:FormColumns.Free="True">
                    <TextBlock Classes="caption hint" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Tools_Gen4SakHelp}" />
                    <TextBlock Classes="caption danger" TextWrapping="Wrap"
                               Text="{Binding Gen4SakError}"
                               IsVisible="{Binding Gen4SakError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>

                  <TextBlock Classes="caption" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Tools_Gen4UlMode}" />
                  <ComboBox ItemsSource="{Binding Gen4UlModeOptions}" SelectedItem="{Binding Gen4UlModeOption}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:Gen4Option">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Classes="caption" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Tools_Gen4MaxBlock}" />
                  <c:HexBox Text="{Binding Gen4MaxBlock}" ByteLengths="1" PlaceholderText="3F"
                            AutomationProperties.Name="{x:Static loc:Strings.Tools_Gen4MaxBlock}" />
                  <Panel />
                  <StackPanel Spacing="2" Margin="0,-6,0,0" c:FormColumns.Free="True">
                    <TextBlock Classes="caption hint" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Tools_Gen4MaxBlockHelp}" />
                    <TextBlock Classes="caption danger" TextWrapping="Wrap"
                               Text="{Binding Gen4MaxBlockError}"
                               IsVisible="{Binding Gen4MaxBlockError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>

                  <TextBlock Classes="caption" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Tools_Gen4Block0}" />
                  <ComboBox ItemsSource="{Binding Gen4Block0Options}" SelectedItem="{Binding Gen4Block0Option}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:Gen4Option">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </c:FormColumns>
              </Panel>
              <Button Classes="accent" Command="{Binding Gen4ApplyCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.save}" />
                  <TextBlock Text="{x:Static loc:Strings.Tools_Gen4Apply}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- UID and advanced memory access -->
          <Expander Classes="card" IsVisible="{Binding Gen4HasConfig}" HorizontalAlignment="Stretch">
            <Expander.Header>
              <TextBlock Text="{x:Static loc:Strings.Tools_Gen4UidAndMemory}" FontWeight="SemiBold" />
            </Expander.Header>
            <StackPanel Spacing="14" IsEnabled="{Binding !IsBusy}">
              <c:FormColumns ColumnSpacing="14" RowSpacing="10" LabelSpacing="6">
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="UID" />
                <c:HexBox Text="{Binding Gen4Uid}" ByteLengths="{Binding Gen4UidByteLengths}"
                          PlaceholderText="{Binding Gen4UidPlaceholder}" AutomationProperties.Name="UID" />
                <Panel />
                <TextBlock Classes="caption hint" Margin="0,-6,0,0" TextWrapping="Wrap" c:FormColumns.Free="True"
                           Text="{x:Static loc:Strings.Tools_Gen4UidHelp}" />
              </c:FormColumns>
              <Button Command="{Binding Gen4WriteUidCommand}" HorizontalAlignment="Left"
                      Content="{x:Static loc:Strings.Tools_Gen4WriteUid}" />

              <Separator />

              <c:FormColumns ColumnSpacing="14" RowSpacing="10" LabelSpacing="6">
                <TextBlock Classes="caption" VerticalAlignment="Center"
                           Text="{x:Static loc:Strings.Tools_Gen4MemorySetting}" />
                <ComboBox ItemsSource="{Binding Gen4MemorySettingOptions}" SelectedItem="{Binding Gen4MemorySettingOption}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:Gen4Option">
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Classes="caption" VerticalAlignment="Center"
                           Text="{x:Static loc:Strings.Tools_Gen4PackPage}"
                           IsVisible="{Binding Gen4IsPackSelected}" />
                <ComboBox ItemsSource="{Binding Gen4PackPageOptions}" SelectedItem="{Binding Gen4PackPageOption}"
                          IsVisible="{Binding Gen4IsPackSelected}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:Gen4Option">
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Panel IsVisible="{Binding Gen4IsPackSelected}" />
                <TextBlock Classes="caption hint" Margin="0,-6,0,0" TextWrapping="Wrap" c:FormColumns.Free="True"
                           IsVisible="{Binding Gen4IsPackSelected}"
                           Text="{x:Static loc:Strings.Tools_Gen4PackPageHelp}" />

                <TextBlock Classes="caption" VerticalAlignment="Center"
                           Text="{Binding Gen4MemorySettingOption?.Label, TargetNullValue=''}" />
                <c:HexBox Text="{Binding Gen4MemoryData}" TextWrapping="Wrap" />
                <Panel />
                <TextBlock Classes="caption hint" Margin="0,-6,0,0" TextWrapping="Wrap" c:FormColumns.Free="True"
                           Text="{Binding Gen4MemoryValueHelp}" />
              </c:FormColumns>
              <WrapPanel ItemSpacing="10" LineSpacing="8">
                <Button Command="{Binding Gen4ReadMemoryCommand}" Content="{x:Static loc:Strings.Tools_Gen4ReadSetting}" />
                <Button Command="{Binding Gen4WriteMemoryCommand}" Content="{x:Static loc:Strings.Tools_Gen4WriteSetting}" />
              </WrapPanel>

              <Separator />

              <c:FormColumns ColumnSpacing="14" RowSpacing="10" LabelSpacing="6">
                <TextBlock Classes="caption" VerticalAlignment="Center"
                           Text="{x:Static loc:Strings.Tools_Gen4BlockAddress}" />
                <c:HexBox Text="{Binding Gen4BlockAddress}" ByteLengths="1" PlaceholderText="00"
                          AutomationProperties.Name="{x:Static loc:Strings.Tools_Gen4BlockAddress}" />

                <TextBlock Classes="caption" VerticalAlignment="Center"
                           Text="{x:Static loc:Strings.Tools_Gen4BlockData}" />
                <c:HexBox Text="{Binding Gen4BlockData}" TextWrapping="Wrap"
                          AutomationProperties.Name="{x:Static loc:Strings.Tools_Gen4BlockData}" />
              </c:FormColumns>
              <WrapPanel ItemSpacing="10" LineSpacing="8">
                <Button Command="{Binding Gen4ReadBlockCommand}" Content="{x:Static loc:Strings.Tools_Gen4ReadBlock}" />
                <Button Command="{Binding Gen4WriteBlockCommand}" Content="{x:Static loc:Strings.Tools_Gen4WriteBlock}" />
              </WrapPanel>
            </StackPanel>
          </Expander>

          <!-- Permanently lock configuration -->
          <Expander Classes="card" IsVisible="{Binding Gen4HasConfig}" HorizontalAlignment="Stretch"
                    BorderBrush="{actipro:ThemeResource ControlBackgroundBrushSoftDanger}">
            <Expander.Header>
              <TextBlock Text="{x:Static loc:Strings.Tools_Gen4PermanentLock}" FontWeight="SemiBold" />
            </Expander.Header>
            <StackPanel Spacing="10">
              <TextBlock Classes="caption hint" TextWrapping="Wrap" Text="{x:Static loc:Strings.Tools_Gen4FuseWarning}" />
              <Button Classes="danger" Command="{Binding Gen4PermanentLockCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.lock}" />
                  <TextBlock Text="{x:Static loc:Strings.Tools_Gen4PermanentLock}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Expander>

          <!-- Status / verification outcome -->
          <Border Classes="card">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="Gen4HasStatus" />
                <Binding Path="Gen4HasConfig" />
              </MultiBinding>
            </Border.IsVisible>
            <SelectableTextBlock TextWrapping="Wrap"
                                 Text="{Binding Gen4Status}"
                                 Classes.danger="{Binding Gen4Failed}"
                                 Classes.success="{Binding !Gen4Failed}" />
          </Border>
        </StackPanel>

        <!-- ========== HF ========== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsHf}">
          <Border Classes="card" IsVisible="{Binding HfHasCapture}">
            <StackPanel Spacing="10">
              <TextBlock Text="{x:Static loc:Strings.Tools_Summary}" Classes="h2" />
              <Grid Classes="facts" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="16" RowSpacing="6">
                <TextBlock Grid.Row="0" Classes="caption" Text="{x:Static loc:Strings.Tools_Frames}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HfCountsText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static loc:Strings.Common_Card}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HfCardText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static loc:Strings.Tools_Session}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HfSessionText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Classes="caption" Text="AIDs" IsVisible="{Binding HfHasAids}" />
                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HfAidsText}" TextWrapping="Wrap"
                                     IsVisible="{Binding HfHasAids}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- MIFARE Classic keys from the reader's authentications -->
          <Border Classes="card" IsVisible="{Binding HfHasAuths}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static loc:Strings.Tools_MIFAREClassicKeys}" Classes="h2" />
                  <TextBlock Classes="caption hint" TextWrapping="Wrap"
                             Text="{x:Static loc:Strings.Tools_TheReadersKeyFromItsAuthentications}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static loc:Strings.Tools_RecoverAll}"
                        Command="{Binding HfRecoverAllCommand}" IsVisible="{Binding HfCanRecoverAll}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding HfAuthGroups}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HfAuthGroupViewModel">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <SelectableTextBlock Classes="mono" FontSize="12" Text="{Binding Exchanges}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding Hint}" TextWrapping="Wrap"
                                 IsVisible="{Binding !CanRecover}" />
                      <!-- The key once found, else the actions to find it. -->
                      <StackPanel Orientation="Horizontal" Spacing="10"
                                  IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Border Classes="keybadge" VerticalAlignment="Center">
                          <SelectableTextBlock Classes="mono" FontSize="15" FontWeight="SemiBold" Text="{Binding Key}"
                                               VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Classes="caption" VerticalAlignment="Center"
                                   Text="{Binding Method, StringFormat={x:Static loc:Strings.Tools_ViaMethod}}" />
                        <Button Classes="icon" VerticalAlignment="Center" b:CopyToClipboard.Text="{Binding Key}">
                          <PathIcon Data="{StaticResource Icon.copy}" />
                        </Button>
                      </StackPanel>
                      <c:ActionRow IsVisible="{Binding Key, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                        <Button Classes="accent" Command="{Binding RecoverCommand}" IsVisible="{Binding CanRecover}"
                                c:ActionRow.Priority="1" ToolTip.Tip="{x:Static loc:Strings.Tools_ComputeTheKeyFromTheseAuthentications}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.key}" /><TextBlock Text="{x:Static loc:Strings.Tools_RecoverKey}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button IsVisible="{Binding Mfkey32Command, Converter={x:Static ObjectConverters.IsNotNull}}"
                                b:CopyToClipboard.Text="{Binding Mfkey32Command}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.copy}" /><TextBlock Text="{x:Static loc:Strings.Tools_Mfkey32v2Command}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </c:ActionRow>
                      <TextBlock Classes="caption" Text="{Binding Result}" TextWrapping="Wrap"
                                 IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Frames: their own scroll, virtualized; a range can be selected and copied. -->
          <Border Classes="card" IsVisible="{Binding HfHasCapture}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static loc:Strings.Tools_Frames}" Classes="h2" />
                  <TextBlock Classes="caption" Name="FramesHint" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Name="CopyFramesButton" VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static loc:Strings.Tools_CopyTheSelectedFramesOrAll}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.copy}" /><TextBlock Name="CopyFramesLabel" Text="{x:Static loc:Strings.Tools_CopyAll}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <ListBox Name="FramesList" Classes="frames" ItemsSource="{Binding HfAnnotated}" SelectionMode="Multiple"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="m:HfAnnotatedFrame">
                    <!-- Number, sender, then the bytes with their meaning beside them, or under the bytes when
                         there is no room. -->
                    <Grid ColumnDefinitions="36,54,*" Classes.dim="{Binding IsEncrypted}">
                      <TextBlock Classes="caption" Text="{Binding Index}" VerticalAlignment="Top" Margin="0,1,0,0" />
                      <TextBlock Grid.Column="1" Classes="dir" Classes.card="{Binding !Frame.IsReader}" VerticalAlignment="Top"
                                 Text="{Binding Frame.IsReader, Converter={x:Static vm:ToolsViewModel.DirectionLabel}}" />
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Classes="caption mono" Text="{Binding TimingText}" IsVisible="{Binding HasTiming}"
                                   ToolTip.Tip="{x:Static loc:Strings.Tools_FrameTimingHint}" TextWrapping="Wrap" />
                        <c:InlineStack Spacing="14">
                          <TextBlock Classes="mono" FontSize="12" Text="{Binding Frame.Hex}" TextWrapping="Wrap" />
                          <TextBlock Classes="caption" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Top" />
                        </c:InlineStack>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ========== Compare dumps ========== -->
        <!-- As tall as the window allows: the summary and differing fields, then both dumps in one hex view. -->
        <Border Classes="card" c:FillStack.Fill="True" MinHeight="300">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsCompare" />
              <Binding Path="HasComparison" />
            </MultiBinding>
          </Border.IsVisible>
          <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <TextBlock Text="{Binding CompareSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding CompareFields}" IsVisible="{Binding HasCompareFields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CompareFieldRow">
                  <Grid ColumnDefinitions="56,16,*" RowDefinitions="Auto,Auto" Margin="0,2">
                    <TextBlock Grid.RowSpan="2" Text="{Binding Label}" Classes="caption" />
                    <TextBlock Grid.Column="1" Text="A" Classes="caption" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding A}" FontFamily="{x:Static c:AppFonts.Mono}"
                                         TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="B" Classes="caption" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="2" Text="{Binding B}"
                                         FontFamily="{x:Static c:AppFonts.Mono}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox Grid.Row="2" Content="{x:Static loc:Strings.Compare_OnlyDifferences}"
                      IsChecked="{Binding CompareOnlyDifferences}" />
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasCompareMemory}">
              <c:HexEditor Buffer="{Binding CompareMemory}" />
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- ========== Console ========== -->
        <!-- As tall as the window allows: the folder and options, the output, a hint line, the command line. -->
        <Border Classes="card" IsVisible="{Binding IsConsole}" c:FillStack.Fill="True" MinHeight="300">
          <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
            <!-- The folder button, then the path (read-only, to select and copy); short of room, the options
                 drop their labels before the path gets narrow. -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <!-- Only where a folder can be picked (the desktop); elsewhere just the options. -->
              <Button Command="{Binding ChooseConsoleFolderCommand}" ToolTip.Tip="{x:Static loc:Strings.Tools_ConsoleChooseFolder}"
                      IsVisible="{x:Static vm:ToolsViewModel.CanChooseConsoleFolder}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.folder}" />
                </StackPanel>
              </Button>
              <c:SideDock Grid.Column="1">
                <TextBox Classes="consoleline" Text="{Binding ConsoleFolder, Mode=OneWay}" IsReadOnly="True" MinWidth="140" VerticalAlignment="Center"
                         IsVisible="{x:Static vm:ToolsViewModel.CanChooseConsoleFolder}"
                         ToolTip.Tip="{Binding ConsoleFolderText}">
                  <TextBox.InnerRightContent>
                    <Button Classes="icon small" Command="{Binding ResetConsoleFolderCommand}" Margin="0,0,4,0"
                            IsVisible="{Binding IsConsoleFolderChosen}" ToolTip.Tip="{x:Static loc:Strings.Tools_ConsoleDefaultFolder}">
                      <PathIcon Data="{StaticResource Icon.reset}" />
                    </Button>
                  </TextBox.InnerRightContent>
                </TextBox>
                <c:ActionRow>
                  <ToggleButton Classes="option" IsChecked="{Binding ConsoleWrap}" ToolTip.Tip="{x:Static loc:Strings.Tools_ConsoleWrap}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.wrap}" />
                      <TextBlock Text="{x:Static loc:Strings.Tools_ConsoleWrap}" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton Classes="option" IsChecked="{Binding ConsoleAutoscroll}" ToolTip.Tip="{x:Static loc:Strings.Tools_ConsoleAutoscroll}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.autoscroll}" />
                      <TextBlock Text="{x:Static loc:Strings.Tools_ConsoleAutoscroll}" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                </c:ActionRow>
              </c:SideDock>
            </Grid>

            <Border Grid.Row="1" Classes="inset" Padding="10,8">
              <ScrollViewer Name="ConsoleScroller">
                <SelectableTextBlock Name="ConsoleOutput" FontFamily="{x:Static c:AppFonts.Mono}" FontSize="12" />
              </ScrollViewer>
            </Border>

            <!-- What may come next in the line, a badge per word (Tab takes it); else what the command does. -->
            <Panel Grid.Row="2" MinHeight="22" ClipToBounds="True">
              <ItemsControl Name="ConsoleHints" ItemsSource="{Binding ConsoleHintWords}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="hintword" Content="{Binding}" Focusable="False" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="caption" Text="{Binding ConsoleHint}" ToolTip.Tip="{Binding ConsoleHint}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
            </Panel>

            <!-- Short of room, Clear and then Run / Cancel drop their labels before the line gets narrow. -->
            <c:SideDock Grid.Row="3">
              <TextBox Name="ConsoleInput" Classes="consoleline" Text="{Binding ConsoleInput}" FontFamily="{x:Static c:AppFonts.Mono}"
                       FontSize="14" MinWidth="160" VerticalAlignment="Center"
                       PlaceholderText="{x:Static vm:ToolsViewModel.ConsolePlaceholder}"
                       TextInputOptions.AutoCapitalization="False" TextInputOptions.ReturnKeyType="Go">
                <TextBox.InnerLeftContent>
                  <TextBlock Text="&gt;" FontFamily="{x:Static c:AppFonts.Mono}" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrandBlueBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <c:ActionRow>
                <Button Classes="accent" Command="{Binding RunConsoleCommand}" IsVisible="{Binding !IsConsoleRunning}"
                        c:ActionRow.Priority="2" ToolTip.Tip="{x:Static vm:ToolsViewModel.ConsoleRunTip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.play}" />
                    <TextBlock Text="{x:Static loc:Strings.Tools_ConsoleRun}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="danger" Command="{Binding CancelConsoleCommand}" IsVisible="{Binding IsConsoleRunning}"
                        c:ActionRow.Priority="2" ToolTip.Tip="{x:Static vm:ToolsViewModel.ConsoleCancelTip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.stop}" />
                    <TextBlock Text="{Binding ConsoleCancelLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding ClearConsoleCommand}" c:ActionRow.Priority="1"
                        ToolTip.Tip="{x:Static vm:ToolsViewModel.ConsoleClearTip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.eraser}" />
                    <TextBlock Text="{x:Static loc:Strings.Common_Clear}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </c:ActionRow>
            </c:SideDock>
          </Grid>
        </Border>

        <!-- ========== LF ========== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsLf}">
          <Border Classes="card" IsVisible="{Binding HasCapture}">
            <StackPanel Spacing="10">
              <TextBlock Text="{x:Static loc:Strings.Tools_Summary}" Classes="h2" />
              <Grid Classes="facts" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="16" RowSpacing="6">
                <TextBlock Grid.Row="0" Classes="caption" Text="{x:Static loc:Strings.Tools_Samples}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SamplesText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static loc:Strings.Tools_Range}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RangeText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static loc:Strings.Tools_Gaps}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GapsText}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Classes="caption" Text="{x:Static loc:Strings.Tools_Modulation}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModulationText}" TextWrapping="Wrap"
                           ToolTip.Tip="{x:Static loc:Strings.Tools_AGuessFromTheLengthsOf}" />
                <TextBlock Grid.Row="4" Classes="caption" Text="{x:Static loc:Strings.Tools_Clock}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ClockText}" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasCapture}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="{x:Static loc:Strings.Tools_Waveform}" Classes="h2" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Width="160" Minimum="1" Maximum="{x:Static c:LfWaveform.MaxZoom}"
                        Value="{Binding Zoom}" VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.Tools_Zoom}" />
                <TextBlock Grid.Column="2" Text="{Binding ZoomText}" MinWidth="36" VerticalAlignment="Center" />
              </Grid>
              <Border CornerRadius="6" ClipToBounds="True"
                      Background="{actipro:ThemeResource Container2BackgroundBrush}">
                <c:LfWaveform Height="224" Margin="0,0,0,4" Samples="{Binding Samples}" Zoom="{Binding Zoom}"
                              CursorIndex="{Binding CursorIndex}"
                              Threshold="{Binding Summary?.Threshold, TargetNullValue=0}"
                              GapThreshold="{Binding Summary?.GapThreshold, TargetNullValue=0}" />
              </Border>
              <TextBlock Classes="caption" Text="{Binding CursorText}" TextWrapping="Wrap" />
              <WrapPanel ItemSpacing="16" LineSpacing="4">
                <StackPanel Classes="legend" Orientation="Horizontal" Spacing="6">
                  <Border Width="14" Height="8" CornerRadius="2" Background="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
                  <TextBlock Text="{x:Static loc:Strings.Tools_Signal}" />
                </StackPanel>
                <StackPanel Classes="legend" Orientation="Horizontal" Spacing="6">
                  <Line StartPoint="0,0" EndPoint="16,0" StrokeThickness="1.5" StrokeDashArray="2,2"
                        Stroke="{actipro:ThemeResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Summary?.Threshold, StringFormat={x:Static loc:Strings.Tools_DecodeThreshold}, TargetNullValue=''}" />
                </StackPanel>
                <StackPanel Classes="legend" Orientation="Horizontal" Spacing="6">
                  <Line StartPoint="0,0" EndPoint="16,0" StrokeThickness="1.5" StrokeDashArray="1,2"
                        Stroke="{actipro:ThemeResource ControlBackgroundBrushSolidDanger}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Summary?.GapThreshold, StringFormat={x:Static loc:Strings.Tools_GapThreshold}, TargetNullValue=''}" />
                </StackPanel>
                <StackPanel Classes="legend" Orientation="Horizontal" Spacing="6">
                  <Border Width="14" Height="10" CornerRadius="2" Background="{actipro:ThemeResource ControlBackgroundBrushSolidDanger}" Opacity="0.3" />
                  <TextBlock Text="{x:Static loc:Strings.Tools_FieldGap}" />
                </StackPanel>
                <StackPanel Classes="legend" Orientation="Horizontal" Spacing="6">
                  <Border Width="2" Height="12" Background="{DynamicResource BrandAmberBrush}" />
                  <TextBlock Text="{x:Static loc:Strings.Tools_Cursor}" />
                </StackPanel>
                <StackPanel Classes="legend" Orientation="Horizontal" Spacing="6">
                  <Border Width="14" Height="10" CornerRadius="2" BorderThickness="1.5"
                          BorderBrush="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
                  <TextBlock Text="{x:Static loc:Strings.Tools_ViewInTheCapture}" />
                </StackPanel>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasCapture}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{x:Static loc:Strings.Tools_ManchesterDecode}" Classes="h2" />
                  <TextBlock Classes="caption" Text="{Binding DecodeText}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ClockDivisors}" SelectedItem="{Binding ClockDivisor}"
                          VerticalAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.Tools_CarrierCyclesPerBit}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                      <TextBlock Text="{Binding StringFormat='RF/{0}'}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Grid.Column="2" Content="{x:Static loc:Strings.Tools_Invert}" IsChecked="{Binding Invert}" VerticalAlignment="Center"
                          ToolTip.Tip="{x:Static loc:Strings.Tools_SwapHighAndLowDecodesThe}" />
              </Grid>
              <Grid Classes="facts" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"
                    RowSpacing="2" IsVisible="{Binding HasBits}">
                <TextBlock Grid.Row="0" Classes="caption" Text="{x:Static loc:Strings.Tools_Bits}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding Bits}"
                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="2" Classes="icon" VerticalAlignment="Top"
                        b:CopyToClipboard.Text="{Binding BitsPlain}">
                  <PathIcon Data="{StaticResource Icon.copy}" />
                </Button>
                <TextBlock Grid.Row="1" Classes="caption" Text="Hex" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding BitsHex}"
                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="2" Classes="icon" b:CopyToClipboard.Text="{Binding BitsHex}">
                  <PathIcon Data="{StaticResource Icon.copy}" />
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Every sample: a read-only hex view that draws only the rows in sight. -->
          <Border Classes="card" IsVisible="{Binding HasCapture}">
            <StackPanel Spacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Static loc:Strings.Tools_Samples}" Classes="h2" />
                <TextBlock Classes="caption hint" TextWrapping="Wrap"
                           Text="{x:Static loc:Strings.Tools_OneBytePerCarrierCycleSelect}" />
              </StackPanel>
              <ScrollViewer Classes="samples" HorizontalScrollBarVisibility="Disabled">
                <c:HexEditor Buffer="{Binding SamplesBuffer}" ShowGroupHeaders="False" />
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>
      </c:FillStack>
    </ScrollViewer>
    <!-- Choosing the card of one side: search, then click one, or open a dump file. -->
    <Border Grid.Row="0" Grid.RowSpan="2" Classes="lightbox" Classes.on="{Binding IsComparePicking}" CornerRadius="12" />
    <Border Grid.Row="0" Grid.RowSpan="2" Name="ComparePickerDialog" Classes="savebar dialog picker"
            IsVisible="{Binding IsComparePicking}">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ComparePickerTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1" Classes="icon small" Command="{Binding CloseComparePickerCommand}"
                  b:DialogKeys.IsCancel="True" ToolTip.Tip="{x:Static loc:Strings.Common_Close}">
            <PathIcon Data="{StaticResource Icon.close}" />
          </Button>
        </Grid>
        <c:CardPicker Grid.Row="1" Name="ComparePicker" ItemsSource="{Binding ComparePickerCards}"
                      SelectedCard="{Binding ComparePickerSelected}" EmptyText="{Binding ComparePickerEmptyText}" />
        <Button Grid.Row="2" Command="{Binding CompareFileCommand}" IsEnabled="{Binding CanUseFiles}"
                HorizontalAlignment="Left" ToolTip.Tip="{x:Static loc:Strings.Compare_OpenFileTip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.import}" />
            <TextBlock Text="{x:Static loc:Strings.Compare_OpenFile}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
