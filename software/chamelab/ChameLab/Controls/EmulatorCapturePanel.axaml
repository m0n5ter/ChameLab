<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:c="using:ChameLab.Controls"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Controls.EmulatorCapturePanel"
             x:DataType="vm:EmulatorCaptureViewModel">
  <StackPanel Spacing="10">
    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" MinHeight="42">
      <TextBlock Text="{Binding CountLabel}" TextWrapping="Wrap" MaxLines="2" MaxWidth="120"
                 VerticalAlignment="Center" ToolTip.Tip="{Binding CountLabel}" />
      <Border Grid.Column="1" BorderThickness="1" CornerRadius="6" Padding="10,0" MinWidth="44" Height="40"
              Background="{actipro:ThemeResource Container3BackgroundBrush}"
              BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
              HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="{Binding CountValue}" FontSize="22" FontWeight="SemiBold"
                   FontFamily="{x:Static c:AppFonts.Mono}" TextAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <c:ActionRow Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
        <DropDownButton IsVisible="{Binding HasKeys}" c:ActionRow.Priority="2" ToolTip.Tip="{x:Static loc:Strings.Cards_SaveKeys}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.key}" />
            <TextBlock Text="{x:Static loc:Strings.Cards_SaveKeys}" VerticalAlignment="Center" />
          </StackPanel>
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnSaveMenuOpening">
              <MenuItem Header="{x:Static loc:Strings.Cards_KeysToClipboard}" Click="OnCopyKeys">
                <MenuItem.Icon><PathIcon Data="{StaticResource Icon.copy}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Classes="keystargets" Header="{x:Static loc:Strings.Cards_KeysToDictionary}"
                        IsVisible="{Binding HasKeysTargets}" ItemsSource="{Binding KeysTargets}">
                <MenuItem.Icon><PathIcon Data="{StaticResource Icon.key}" /></MenuItem.Icon>
                <MenuItem.Styles>
                  <Style Selector="MenuItem.keystargets > MenuItem" x:DataType="vm:KeysTargetViewModel">
                    <Setter Property="Command" Value="{Binding SaveCommand}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                      <ControlTemplate>
                        <Border Name="PART_Row" Width="260" Margin="4,0" Padding="8,3" CornerRadius="6"
                                Background="Transparent" x:DataType="vm:KeysTargetViewModel">
                          <c:DictionaryRow Color="{Binding Item.ColorBrush}" Title="{Binding Item.Name}"
                                           Count="{Binding Item.Dictionary.Count}" />
                        </Border>
                      </ControlTemplate>
                    </Setter>
                  </Style>
                  <Style Selector="MenuItem.keystargets > MenuItem:pointerover /template/ Border#PART_Row, MenuItem.keystargets > MenuItem:selected /template/ Border#PART_Row">
                    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPointerOver}" />
                  </Style>
                  <Style Selector="MenuItem.keystargets > MenuItem:pressed /template/ Border#PART_Row">
                    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPressed}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <MenuItem Header="{x:Static loc:Strings.Cards_KeysToNewDictionary}" Command="{Binding SaveToNewDictionaryCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource Icon.add}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{x:Static loc:Strings.Cards_KeysToFile}" Command="{Binding SaveToFileCommand}"
                        IsEnabled="{Binding CanUseFiles}">
                <MenuItem.Icon><PathIcon Data="{StaticResource Icon.export}" /></MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </c:ActionRow>
    </Grid>
    <ItemsControl ItemsSource="{Binding KeyRows}" IsVisible="{Binding HasKeys}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:EmulatorCaptureKey">
          <SelectableTextBlock FontFamily="{x:Static c:AppFonts.Mono}">
            <SelectableTextBlock.Inlines>
              <Run Text="{Binding Prefix}" />
              <Run Text="{Binding Key}" Foreground="{actipro:ThemeResource ControlForegroundBrushOutlineSuccess}" />
            </SelectableTextBlock.Inlines>
          </SelectableTextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding ResultNote}" TextWrapping="Wrap" Classes="caption"
               IsVisible="{Binding ResultNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Classes="caption"
               IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Classes="danger"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </StackPanel>
</UserControl>
