<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:c="using:ChameLab.Controls"
             x:Class="ChameLab.Controls.ProtectionSettingsPanel"
             x:DataType="vm:IProtectionSettings">
  <!-- Password settings of an Ultralight EV1 / NTAG21x card: the card's own, or what the writer puts on a target. -->
  <StackPanel Spacing="10">
    <WrapPanel ItemSpacing="24" LineSpacing="6">
      <CheckBox Content="Protect with a password" IsChecked="{Binding IsProtected}"
                ToolTip.Tip="Pages from the chosen one on need the password (AUTH0)" />
      <CheckBox Classes="danger" Content="Protect reading" IsChecked="{Binding ReadProtected}"
                IsEnabled="{Binding IsProtected}"
                ToolTip.Tip="PROT: without the password the protected pages can't even be read" />
    </WrapPanel>
    <!-- The settings below only take effect with protection on. -->
    <StackPanel Spacing="10" IsEnabled="{Binding IsProtected}">
      <c:FlowGrid MinItemWidth="150" ColumnSpacing="10" RowSpacing="10">
        <StackPanel Spacing="4">
          <TextBlock Text="Password (PWD)" Classes="caption" />
          <c:HexBox Text="{Binding Password}" ByteLengths="4" PlaceholderText="FF FF FF FF" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Answer (PACK)" Classes="caption" />
          <c:HexBox Text="{Binding Pack}" ByteLengths="2" PlaceholderText="00 00"
                    ToolTip.Tip="What the card answers to the right password; readers may check it" />
        </StackPanel>
      </c:FlowGrid>
      <c:FlowGrid MinItemWidth="150" ColumnSpacing="10" RowSpacing="10">
        <StackPanel Spacing="4">
          <TextBlock Text="From page (AUTH0)" Classes="caption" />
          <NumericUpDown Value="{Binding ProtectFrom}" Minimum="0" Maximum="{Binding LastPage}" Increment="1"
                         FormatString="0" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Attempt limit (AUTHLIM)" Classes="caption" />
          <!-- A limit can lock the card for good, so every limit is shown in red. -->
          <ComboBox ItemsSource="{Binding AuthLimitOptions}" SelectedItem="{Binding SelectedAuthLimit}"
                    HorizontalAlignment="Stretch" ToolTip.Tip="Wrong passwords before the card locks for good">
            <ComboBox.Styles>
              <Style Selector="ComboBoxItem" x:DataType="vm:AuthLimitOption">
                <Setter Property="IsEnabled" Value="{Binding !IsSeparator}" />
              </Style>
            </ComboBox.Styles>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AuthLimitOption">
                <Panel>
                  <TextBlock Text="{Binding Label}" Classes.danger="{Binding IsLimited}"
                             IsVisible="{Binding !IsSeparator}" />
                  <Separator Margin="0" IsVisible="{Binding IsSeparator}" />
                </Panel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </c:FlowGrid>
    </StackPanel>
    <StackPanel Spacing="2">
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ProtectionSummary}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding ProtectionNote}"
                 IsVisible="{Binding ProtectionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
