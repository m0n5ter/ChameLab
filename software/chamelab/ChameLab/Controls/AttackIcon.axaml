<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ChameLab.Controls"
             x:Class="ChameLab.Controls.AttackIcon"
             x:DataType="c:AttackIcon"
             x:Name="IconRoot"
             Width="28" Height="28" VerticalAlignment="Center"
             IsHitTestVisible="False">
  <Viewbox>
    <Grid Width="28" Height="28">
      <Border Margin="1,4,1,4" CornerRadius="2.5"
              Background="{Binding Foreground, ElementName=IconRoot}" Opacity="0.1" />
      <Path Data="M3.5,4H24.5A2.5,2.5 0 0,1 27,6.5V21.5A2.5,2.5 0 0,1 24.5,24H3.5A2.5,2.5 0 0,1 1,21.5V6.5A2.5,2.5 0 0,1 3.5,4Z M1,9H27"
            Stroke="{Binding Foreground, ElementName=IconRoot}" StrokeThickness="1.5"
            StrokeLineCap="Round" StrokeJoin="Round" />
      <TextBlock Margin="2,9,2,4" Text="{Binding Label, ElementName=IconRoot}"
                 FontSize="10.5" FontWeight="Bold" LineHeight="14"
                 Foreground="{Binding Foreground, ElementName=IconRoot}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Viewbox>
</UserControl>
