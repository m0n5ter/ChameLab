<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ChameLab.Localization"
             xmlns:vm="using:ChameLab.ViewModels"
             xmlns:c="using:ChameLab.Controls"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="ChameLab.Controls.T55xxPasswordSettingsPanel"
             x:DataType="vm:T55xxPasswordSettingsViewModel">
  <UserControl.Styles>
    <!-- Keep the dictionary count badge styled wherever this panel is hosted. -->
    <Style Selector="Border.countbadge">
      <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container3BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.countbadge > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <c:FormColumns ColumnSpacing="14" RowSpacing="10" LabelSpacing="6">

    <!-- Current key and the mode switch. -->
    <TextBlock Classes="caption" VerticalAlignment="Center"
               Text="{x:Static loc:Strings.Tools_T55xxCurrentKey}" />
    <!-- Segments size to their labels and share any extra width the column gives them. -->
    <Border Classes="segmented compact">
      <c:SpreadStack>
        <RadioButton Classes="segment" IsChecked="{Binding KnowKey}"
                     Content="{x:Static loc:Strings.Tools_T55xxKnowKey}" />
        <RadioButton Classes="segment" IsChecked="{Binding UseDictionary}"
                     Content="{x:Static loc:Strings.Tools_T55xxDictionaryAttack}" />
      </c:SpreadStack>
    </Border>

    <!-- The input for the chosen mode. Both alternatives are rows of their own, one Shown at a
         time, and the hidden one still counts toward the column width, so switching never resizes
         the column; equal heights keep it from nudging the layout. -->
    <!-- Known password: a 4-byte editor. -->
    <Panel />
    <Panel Height="40" VerticalAlignment="Center" c:FormColumns.Shown="{Binding KnowKey}">
      <c:HexBox Text="{Binding KnownKey}" ByteLengths="4"
                VerticalAlignment="Top" PlaceholderText="20 20 66 66"
                AutomationProperties.Name="{x:Static loc:Strings.Tools_T55xxKnownKey}" />
    </Panel>
    <!-- Dictionary attack: pick the dictionaries; the count rides on the button as a framed badge. -->
    <Panel />
    <Panel Height="40" VerticalAlignment="Center" c:FormColumns.Shown="{Binding UseDictionary}">
      <Button VerticalAlignment="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              AutomationProperties.Name="{x:Static loc:Strings.Common_KeyDictionaries}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.key}" Width="16" Height="16" VerticalAlignment="Center" />
          <TextBlock Text="{x:Static loc:Strings.Common_KeyDictionaries}" VerticalAlignment="Center" />
          <Border Classes="countbadge">
            <TextBlock Text="{Binding KeyCount}" Classes="caption" />
          </Border>
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <StackPanel Spacing="10" MinWidth="240" MaxWidth="340" Margin="12">
              <TextBlock Text="{x:Static loc:Strings.KeyRecovery_KeyDictionariesHeader}" Classes="overline" />
              <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Keys.Sources}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DumpKeySourceViewModel">
                      <c:DictionaryToggle Margin="0,2" IsChecked="{Binding IsSelected}" Color="{Binding ColorBrush}"
                                            Title="{Binding Name}" Count="{Binding KeyCount}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Separator />
              <TextBlock Text="{Binding KeyCountText}" FontWeight="SemiBold" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Panel>
    <!-- The negative top margin pulls each error up to sit close under its input. -->
    <Panel />
    <TextBlock Classes="caption danger" Margin="0,-6,0,0" TextWrapping="Wrap" c:FormColumns.Free="True"
               Text="{Binding KnownKeyError}"
               IsVisible="{Binding KnownKeyError, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- New key: Clear writes the default key, Set takes the one typed below. Only Set is bound
         two-way: picking Clear unchecks it through the group, which clears the flag. -->
    <TextBlock Classes="caption" VerticalAlignment="Center"
               Text="{x:Static loc:Strings.Tools_T55xxNewKeyTitle}" />
    <Border Classes="segmented compact">
      <c:SpreadStack>
        <RadioButton Classes="segment" IsChecked="{Binding !SetNewKey, Mode=OneWay}"
                     Content="{x:Static loc:Strings.Common_Clear}" />
        <RadioButton Classes="segment" IsChecked="{Binding SetNewKey}"
                     Content="{x:Static loc:Strings.Tools_T55xxSetNewKey}" />
      </c:SpreadStack>
    </Border>

    <!-- Under the choice: the editor for Set, or what Clear will write. Each takes a row of its
         own (only one shows), both 40 high so switching does not nudge the layout. The editor
         counts toward the column width even while hidden; the note is Free, so it wraps to the
         pane instead of the column. -->
    <Panel />
    <Panel Height="40" VerticalAlignment="Center" c:FormColumns.Shown="{Binding SetNewKey}">
      <c:HexBox Text="{Binding NewKey}" ByteLengths="4"
                VerticalAlignment="Top" PlaceholderText="{Binding DefaultKeyText}"
                AutomationProperties.Name="{x:Static loc:Strings.Tools_T55xxNewKey}" />
    </Panel>
    <Panel />
    <Border MinHeight="40" c:FormColumns.Free="True" IsVisible="{Binding !SetNewKey}">
      <TextBlock Classes="caption hint" VerticalAlignment="Top" TextWrapping="Wrap"
                 Text="{Binding DefaultKeyText, StringFormat={x:Static loc:Strings.Tools_T55xxDefaultKeyWillBeSet}}" />
    </Border>
    <Panel />
    <TextBlock Classes="caption danger" Margin="0,-6,0,0" TextWrapping="Wrap" c:FormColumns.Free="True"
               Text="{Binding NewKeyError}"
               IsVisible="{Binding NewKeyError, Converter={x:Static ObjectConverters.IsNotNull}}" />
  </c:FormColumns>
</UserControl>
