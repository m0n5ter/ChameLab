<Styles xmlns="https://github.com/avaloniaui"
        xmlns:c="using:ChameLab.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui">

  <!-- ==================== Shell ==================== -->

  <!-- The theme shows the light-dismiss layer by an :overlay:open animation and hides it only on
       :closed, so switching Overlay -> Inline with the pane open leaves it over the content,
       invisible but swallowing every click. Inline modes never light-dismiss. -->
  <Style Selector="SplitView:inline /template/ Rectangle#LightDismissLayer,
                   SplitView:compactinline /template/ Rectangle#LightDismissLayer">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- ==================== Surfaces ==================== -->

  <!-- Card surface used across pages. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{actipro:ThemeResource Container1BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- Collapsible card: the whole section folds under its header. -->
  <Style Selector="Expander.card">
    <Setter Property="CornerRadius" Value="14" />
    <!-- Same inset as Border.card, so headers and content line up with the other cards. -->
    <Setter Property="Padding" Value="20,0,20,20" />
  </Style>
  <Style Selector="Expander.card /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Padding" Value="20,14" />
  </Style>

  <!-- Inset tile inside a card (stat values, empty states). -->
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <!-- Rounded square that holds an icon. -->
  <Style Selector="Border.iconwell">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccent}" />
    <Setter Property="TextElement.Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSoftAccent}" />
  </Style>
  <Style Selector="Border.iconwell.green">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccent}" />
    <Setter Property="TextElement.Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSoftAccent}" />
  </Style>
  <Style Selector="Border.iconwell.blue">
    <Setter Property="Background" Value="{DynamicResource BrandBlueSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource BrandBlueBrush}" />
  </Style>
  <Style Selector="Border.iconwell.amber">
    <Setter Property="Background" Value="{DynamicResource BrandAmberSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource BrandAmberBrush}" />
  </Style>
  <Style Selector="Border.iconwell > PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <!-- Small pill label (HF / LF / ACTIVE). -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- Band labels read a little larger than the other pills. -->
  <Style Selector="Border.chip.hf, Border.chip.lf">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinWidth" Value="34" />
  </Style>
  <Style Selector="Border.chip.hf > TextBlock, Border.chip.lf > TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.chip.hf">
    <Setter Property="Background" Value="{DynamicResource BrandBlueSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource BrandBlueBrush}" />
  </Style>
  <Style Selector="Border.chip.lf">
    <Setter Property="Background" Value="{DynamicResource BrandAmberSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource BrandAmberBrush}" />
  </Style>
  <Style Selector="Border.chip.active">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidSuccess}" />
    <Setter Property="TextElement.Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSolidSuccess}" />
  </Style>

  <!-- ==================== Typography ==================== -->

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrushTertiary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="c|MarkdownView">
    <Setter Property="LinkForeground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
    <Setter Property="CodeBackground" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector=":is(Control).dim">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ==================== Page layout ==================== -->

  <Style Selector="StackPanel.page">
    <Setter Property="Margin" Value="28,24,28,88" />
    <Setter Property="Spacing" Value="12" />
    <Setter Property="MaxWidth" Value="980" />
  </Style>
  <!-- Grid variant for pages that fit the viewport instead of scrolling (rows flex). -->
  <Style Selector="Grid.page">
    <!-- Fits the viewport and scrolls inside, so no room is kept for the status banner. -->
    <Setter Property="Margin" Value="28,24,28,24" />
    <Setter Property="RowSpacing" Value="12" />
  </Style>
  <!-- Columns of a split page (list / details) stack their blocks with the same gap as a page. -->
  <Style Selector="Grid.panestack">
    <Setter Property="RowSpacing" Value="12" />
  </Style>
  <Style Selector="StackPanel.panestack">
    <Setter Property="Spacing" Value="12" />
  </Style>
  <Style Selector="UniformGrid.cols2">
    <Setter Property="Columns" Value="2" />
    <Setter Property="ColumnSpacing" Value="16" />
    <Setter Property="RowSpacing" Value="16" />
  </Style>
  <Style Selector="UniformGrid.cols3">
    <Setter Property="Columns" Value="3" />
    <Setter Property="ColumnSpacing" Value="12" />
    <Setter Property="RowSpacing" Value="12" />
  </Style>

  <!-- ==================== Buttons ==================== -->

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- The theme fills disabled buttons with its disabled brush, near black in the dark theme and
       darker than the surface around them. Keep each button's own fill and border instead; the
       disabled text color is enough to show the state. -->
  <Style Selector=":is(Button):disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
  </Style>
  <Style Selector="Button > StackPanel > PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Compact icon-only button. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon > PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="Button.icon.small > PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- Primary / accent action. -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSolidAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccentPointerOver}" />
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSolidAccent}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccentPressed}" />
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSolidAccent}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSolidAccent}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Quiet destructive action: red text, red fill on hover. -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidDanger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger.solid">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidDanger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Every text button the same height, with or without an icon or accent, so swapping one for another
       (Dump / Stop dump) doesn't shift the layout. Declared after accent / danger so it wins. Tiles,
       icon buttons and the other drawn-content buttons keep their own size; .mini is a small inline link. -->
  <Style Selector="Button:not(.icon):not(.tile):not(.slot):not(.cardtile):not(.foldertile):not(.copycell):not(.colorpick):not(.ledpick):not(.slottarget):not(.mini), DropDownButton">
    <!-- Comfortable to tap on a phone. -->
    <Setter Property="Height" Value="40" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="actipro|ToggleThemeButton">
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="40" />
  </Style>

  <!-- Large clickable tile (scan buttons). -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="{actipro:ThemeResource Container1BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>

  <!-- Read-only value field that copies itself on click (looks like an inset). -->
  <Style Selector="Button.copycell">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.copycell:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
  </Style>

  <!-- Dump block strip (drawn control); colors match the legend cells below. -->
  <Style Selector="c|BlockStrip">
    <Setter Property="PendingBrush" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
    <Setter Property="ReadingBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
    <Setter Property="ReadBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidSuccess}" />
    <Setter Property="ReadErrorBrush" Value="{DynamicResource BrandAmberBrush}" />
    <Setter Property="NoKeyBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidDanger}" />
  </Style>

  <!-- Legend cells for the dump block strip, colored by read state. -->
  <Style Selector="Border.blockcell">
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
  </Style>
  <Style Selector="Border.blockcell.reading">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <Style Selector="Border.blockcell.read">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidSuccess}" />
  </Style>
  <Style Selector="Border.blockcell.readerror">
    <Setter Property="Background" Value="{DynamicResource BrandAmberBrush}" />
  </Style>
  <Style Selector="Border.blockcell.nokey">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidDanger}" />
  </Style>
  <Style Selector="Border.blocklegend">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Slot card button: strip default chrome so the inner Border shows. -->
  <Style Selector="Button.slot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.slot /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.slot:pointerover /template/ ContentPresenter, Button.slot:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.slotcard">
    <Setter Property="Background" Value="{actipro:ThemeResource Container1BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.slot:pointerover Border.slotcard">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container3BorderBrush}" />
  </Style>
  <Style Selector="Border.slotcard.active, Button.slot:pointerover Border.slotcard.active">
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <Style Selector="Border.slotnum">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
  </Style>
  <Style Selector="Border.slotnum.active">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
    <Setter Property="TextElement.Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSolidAccent}" />
  </Style>

  <!-- Segmented two-way switch built from radio buttons. -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" Background="Transparent" CornerRadius="7" Padding="12,8">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushSolidAccent}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <Style Selector="RadioButton.segment PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Touch-friendly number field: big − / + buttons on either side of the value instead of
       the theme's tiny stacked arrows. -->
  <!-- Height comes from the text box alone, so it lines up with combo boxes and text boxes. -->
  <Style Selector="NumericUpDown.stepper">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown.stepper /template/ TextBox#PART_TextBox">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextInputOptions.ContentType" Value="Digits" />
  </Style>
  <Style Selector="NumericUpDown.stepper /template/ ButtonSpinner">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <RepeatButton Name="PART_DecreaseButton" Grid.Column="0" Classes="step"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">
              <PathIcon Data="{StaticResource Icon.remove}" />
            </RepeatButton>
            <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
            <RepeatButton Name="PART_IncreaseButton" Grid.Column="2" Classes="step"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">
              <PathIcon Data="{StaticResource Icon.add}" />
            </RepeatButton>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RepeatButton.step">
    <Setter Property="Width" Value="44" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
  </Style>
  <Style Selector="RepeatButton.step:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
  </Style>
  <Style Selector="RepeatButton.step:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccent}" />
  </Style>
  <Style Selector="RepeatButton.step:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="RepeatButton.step > PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <!-- ==================== Navigation ==================== -->

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- The items touch, and each row (Border.navrow) draws its own highlight inset by 2 px: the gap
       between highlights belongs to the items, so there is no hole a click or hover falls through. -->
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter, ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter, ListBox.nav ListBoxItem:selected /template/ ContentPresenter, ListBox.nav ListBoxItem:pressed /template/ ContentPresenter, ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.nav ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav Border.navrow">
    <Setter Property="Margin" Value="2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The theme's own list item brushes, as the item would have drawn them. -->
  <Style Selector="ListBox.nav ListBoxItem:pointerover Border.navrow">
    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPointerOver}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pressed Border.navrow">
    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPressed}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Border.navrow">
    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushSelected}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover Border.navrow">
    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushSelectedPointerOver}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pressed Border.navrow">
    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushSelectedPressed}" />
  </Style>
  <!-- A card dragged over a folder (or Cards) in the navigation pane. -->
  <Style Selector="ListBox.nav Border.navrow.droptarget">
    <Setter Property="Background" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
  </Style>
  <!-- Folders without cards are dimmed (the name, icon and count; not the rename / delete buttons). -->
  <Style Selector="Grid.folderrow PathIcon.foldericon">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Grid.folderrow.empty PathIcon.foldericon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Grid.folderrow.empty Border.foldername, Grid.folderrow.empty TextBlock.foldercount">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- Folder rows trade their card count for Rename / Delete on hover and while open; the buttons sit
       over the end of the name, which fades out under them. Nothing changes size, so the name doesn't
       rewrap (and the row jump) as they come and go. -->
  <Style Selector="ListBox.nav StackPanel.folderactions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover StackPanel.folderactions, ListBox.nav ListBoxItem:selected StackPanel.folderactions">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover TextBlock.foldercount, ListBox.nav ListBoxItem:selected TextBlock.foldercount">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover Border.foldername, ListBox.nav ListBoxItem:selected Border.foldername">
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="Black" />
        <GradientStop Offset="0.5" Color="Black" />
        <GradientStop Offset="0.68" Color="Transparent" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <!-- Renaming a folder: the name (and count) stay, unseen, so the row keeps its size, and the field lies
       over them, its frame and padding outside the text (negative margin) so the letters don't move. -->
  <Style Selector="Grid.folderrow.editing Border.foldername, Grid.folderrow.editing TextBlock.foldercount">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.navbar">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>

  <!-- ==================== Card rows (saved cards, dictionaries, write) ==================== -->

  <Style Selector="ListBox.cards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <!-- Never scroll sideways: rows take the list's width and long names trim instead. -->
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <!-- A wide list wraps into several columns. The rows touch: the gap between them is each row's
         own transparent padding, so there is no hole a click or hover falls through. -->
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <c:TileGrid MinItemWidth="280" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <!-- Devices on the Connect page: the same rows, always in one column. -->
  <Style Selector="ListBox.cards.devices">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.cards ListBoxItem">
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- The row draws itself (Border.cardrow); the item behind it, padding included, stays clear. -->
  <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter, ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter, ListBox.cards ListBoxItem:selected /template/ ContentPresenter, ListBox.cards ListBoxItem:pressed /template/ ContentPresenter, ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.cards ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.cardrow">
    <Setter Property="Background" Value="{actipro:ThemeResource Container1BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.cardrow">
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <!-- Hover: like a card tile (Button.cardtile). After the row's own style, which it overrides. -->
  <Style Selector="ListBox.cards ListBoxItem:pointerover Border.cardrow">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <!-- Clips the color stripe to the inner edge of the frame (12 - 1.5) so it never paints over it. -->
  <Style Selector="Border.cardrow > Border.cardclip">
    <Setter Property="CornerRadius" Value="10.5" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="0,0,14,0" />
  </Style>

  <!-- A saved card outside the list (slot editor, scanned card already saved): the list row,
       as a button that opens the card. -->
  <Style Selector="Button.cardtile">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{actipro:ThemeResource Container1BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.cardtile:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <!-- A folder in the Cards list: a row like a card's, dimmed while empty. Padded like the list rows,
       so the gaps between folders are part of them too. -->
  <Style Selector="Button.foldertile">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.foldertile /template/ ContentPresenter, Button.foldertile:pointerover /template/ ContentPresenter, Button.foldertile:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.foldertile:pointerover Border.cardrow, Button.foldertile.droptarget Border.cardrow">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <Style Selector="Button.foldertile PathIcon.foldericon">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.foldertile.empty PathIcon.foldericon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.foldertile.empty TextBlock.foldername, Button.foldertile.empty TextBlock.foldercount">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.cardtile > Border.cardclip">
    <Setter Property="CornerRadius" Value="10.5" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="0,0,14,0" />
  </Style>

  <!-- The row being dragged into place (see ListReorder). -->
  <Style Selector="ListBox.cards ListBoxItem.dragging">
    <Setter Property="Opacity" Value="0.85" />
    <Setter Property="ZIndex" Value="1" />
    <!-- The item and its presenter must not clip the shadow. -->
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem.dragging /template/ ContentPresenter">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <!-- Shadow only below and to the sides; the list leaves room for it (see the list's ScrollViewer). -->
  <Style Selector="ListBox.cards ListBoxItem.dragging Border.cardrow">
    <Setter Property="BoxShadow" Value="0 4 14 -2 #80000000" />
  </Style>
  <!-- Thick frame drawn over the row's own edge, inwards, so the tile keeps its size. -->
  <Style Selector="Border.dragframe">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem.dragging Border.dragframe">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- The row a dragged one would be dropped onto (drop-onto lists, e.g. swapping slots). -->
  <Style Selector="ListBox.cards ListBoxItem.droptarget Border.dragframe">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem.droptarget Border.cardrow">
    <Setter Property="Background" Value="{actipro:ThemeResource Container2BackgroundBrush}" />
  </Style>

  <!-- ==================== Library pages (list + details: cards, slots, dictionaries) ==================== -->

  <!-- Wide: list on the left, details on the right (SplitLayout sizes the column).
       Narrow ("single"): one at a time; "open" means the details are in use. -->
  <Style Selector="Grid.cardsplit > :is(Control).detailpane">
    <!-- Column is set here, not on the element, so the single style can move it. -->
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Margin" Value="18,0,0,0" />
  </Style>
  <!-- Both panes share the star column; the Auto column would let the pane grow unbounded. -->
  <Style Selector="Grid.cardsplit.single > :is(Control).detailpane">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Grid.cardsplit.single.open > :is(Control).listpane">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Grid.cardsplit.single:not(.open) > :is(Control).detailpane">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.backonly">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Grid.cardsplit.single Button.backonly">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Color palette (a ListBox of swatches, usually in a flyout). -->
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>
  <!-- Breathing room between the swatches and the flyout edge. -->
  <Style Selector="ListBox.swatches">
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem:selected Border.swatch">
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="2.5" />
  </Style>
  <!-- Header color strip: opens the palette. -->
  <Style Selector="Button.colorpick">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.colorpick > Border">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.colorpick:pointerover > Border">
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- Header name: reads as a title, turns into a field on hover / focus. -->
  <Style Selector="TextBox.titlebox">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Margin" Value="-7,0,0,0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBox.titlebox:pointerover">
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
  </Style>
  <Style Selector="TextBox.titlebox:focus-within">
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
  </Style>
  <!-- Actions short of room: icon only (the tooltip names the action). Only the label in the
       button's content: a plain descendant selector would also blank the tooltip's text. -->
  <Style Selector="c|ActionRow > :is(Control).iconic > StackPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Save / discard bar under the details. -->
  <Style Selector="Border.savebar">
    <Setter Property="Background" Value="{actipro:ThemeResource Container1BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <!-- A question floating over the dimmed details instead of sitting in the bar. -->
  <Style Selector="Border.savebar.dialog">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="440" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
  </Style>
  <Style Selector="Border.lightbox">
    <Setter Property="Background" Value="#73000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.lightbox.on">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <!-- List filter beside the combos: shorter than they are, then stretched to their height,
       so it never makes the row (and the combos) taller. -->
  <Style Selector="Border.segmented.filter">
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.segmented.filter RadioButton.segment /template/ Border#PART_Bg">
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <!-- ==================== Status banner ==================== -->

  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8,6,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{actipro:ThemeResource InfoBarBackgroundBrushSuccess}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidSuccess}" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
  </Style>
  <Style Selector="Border.banner PathIcon.state">
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlBackgroundBrushSolidSuccess}" />
  </Style>
  <Style Selector="Border.banner.error">
    <Setter Property="Background" Value="{actipro:ThemeResource InfoBarBackgroundBrushError}" />
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidDanger}" />
  </Style>
  <Style Selector="Border.banner.error PathIcon.state">
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlBackgroundBrushSolidDanger}" />
  </Style>

  <!-- ==================== Compact (phone-width) overrides ==================== -->
  <!-- MainView adds the "compact" class to itself below its width threshold. -->

  <Style Selector=".compact StackPanel.page">
    <Setter Property="Margin" Value="14,10,14,88" />
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector=".compact Grid.page">
    <Setter Property="Margin" Value="14,10,14,8" />
    <Setter Property="RowSpacing" Value="8" />
  </Style>
  <Style Selector=".compact Grid.panestack">
    <Setter Property="RowSpacing" Value="8" />
  </Style>
  <Style Selector=".compact StackPanel.panestack">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector=".compact Border.card">
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector=".compact Expander.card">
    <Setter Property="Padding" Value="14,0,14,14" />
  </Style>
  <Style Selector=".compact Expander.card /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <!-- Scroll bars float over the content as a thin strip instead of taking a column. -->
  <Style Selector=".compact ScrollViewer">
    <!-- Actipro's default theme always reserves a column for the bar; the overlay theme doesn't. -->
    <Setter Property="Theme" Value="{actipro:ControlTheme ScrollViewerOverlay}" />
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <Style Selector=".compact ScrollBar">
    <Setter Property="actipro:ThemeProperties.ScrollBarHasLineButtons" Value="False" />
  </Style>
  <Style Selector=".compact ScrollBar:vertical">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector=".compact ScrollBar:horizontal">
    <Setter Property="Height" Value="8" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector=".compact UniformGrid.cols2, .compact UniformGrid.cols3">
    <Setter Property="Columns" Value="1" />
  </Style>
  <Style Selector=".compact :is(Control).wide-only">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control).compact-only">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".compact :is(Control).compact-only">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- The tab bar makes way for the on-screen keyboard. -->
  <Style Selector=".compact.keyboard Panel.tabbar">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ==================== Bottom tab bar (narrow layouts) ==================== -->

  <Style Selector="ListBox.tabbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tabbar ListBoxItem">
    <Setter Property="Padding" Value="2,4" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
  </Style>
  <Style Selector="ListBox.tabbar ListBoxItem /template/ ContentPresenter, ListBox.tabbar ListBoxItem:pointerover /template/ ContentPresenter, ListBox.tabbar ListBoxItem:selected /template/ ContentPresenter, ListBox.tabbar ListBoxItem:pressed /template/ ContentPresenter, ListBox.tabbar ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.tabbar ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The highlight is a pill behind the icon, as on Android's navigation bar. -->
  <Style Selector="ListBox.tabbar Border.tabpill">
    <Setter Property="Padding" Value="16,4" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabbar ListBoxItem:pointerover Border.tabpill">
    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushPointerOver}" />
  </Style>
  <Style Selector="ListBox.tabbar ListBoxItem:selected Border.tabpill">
    <Setter Property="Background" Value="{actipro:ThemeResource ListItemBackgroundBrushSelected}" />
  </Style>
  <Style Selector="ListBox.tabbar ListBoxItem:selected">
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
  </Style>
  <!-- ==================== Hex editing ==================== -->

  <Style Selector="TextBox.hex">
    <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
  </Style>
  <Style Selector="TextBox.hex TextBlock.hexcount">
    <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrushTertiary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="6,0,10,0" />
  </Style>
  <Style Selector="TextBox.hex:invalid TextBlock.hexcount">
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}" />
  </Style>
  <Style Selector="TextBox.hex:invalid:not(:focus-within)">
    <Setter Property="BorderBrush" Value="{actipro:ThemeResource ControlForegroundBrushOutlineDanger}" />
  </Style>

  <Style Selector="c|HexEditor">
    <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrush}" />
    <Setter Property="LabelBrush" Value="{actipro:ThemeResource DefaultForegroundBrushTertiary}" />
    <Setter Property="DimBrush" Value="{actipro:ThemeResource DefaultForegroundBrushDisabled}" />
    <Setter Property="ChangedBrush" Value="{DynamicResource BrandRedBrush}" />
    <Setter Property="ManufacturerBrush" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
    <Setter Property="KeyABrush" Value="{DynamicResource BrandBlueBrush}" />
    <Setter Property="AccessBitsBrush" Value="{DynamicResource BrandAmberBrush}" />
    <Setter Property="KeyBBrush" Value="{DynamicResource HexKeyBBrush}" />
    <Setter Property="CaretBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" />
    <Setter Property="CaretCellBrush" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource BrandBlueSoftBrush}" />
    <Setter Property="ActiveRowBrush" Value="{actipro:ThemeResource Container3BackgroundBrush}" />
    <Setter Property="SeparatorBrush" Value="{actipro:ThemeResource Container1BorderBrush}" />
  </Style>

  <Style Selector="WrapPanel.hexlegend">
    <Setter Property="ItemSpacing" Value="12" />
    <Setter Property="LineSpacing" Value="2" />
  </Style>
  <Style Selector="WrapPanel.hexlegend > TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="WrapPanel.hexlegend > TextBlock.manufacturer">
    <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}" />
  </Style>
  <Style Selector="WrapPanel.hexlegend > TextBlock.keya">
    <Setter Property="Foreground" Value="{DynamicResource BrandBlueBrush}" />
  </Style>
  <Style Selector="WrapPanel.hexlegend > TextBlock.access">
    <Setter Property="Foreground" Value="{DynamicResource BrandAmberBrush}" />
  </Style>
  <Style Selector="WrapPanel.hexlegend > TextBlock.keyb">
    <Setter Property="Foreground" Value="{DynamicResource HexKeyBBrush}" />
  </Style>
  <Style Selector="WrapPanel.hexlegend > TextBlock.changed">
    <Setter Property="Foreground" Value="{DynamicResource BrandRedBrush}" />
  </Style>

</Styles>
