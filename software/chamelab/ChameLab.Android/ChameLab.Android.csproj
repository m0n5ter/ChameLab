<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CI publishes one APK per ABI with -r (android-arm64, android-arm) to keep each one small -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifiers>
    <ApplicationId>io.github.m0n5ter.chamelab</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mono runtime settings (a larger garbage collector nursery, see the file). -->
    <AndroidEnvironment Include="environment.txt" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" />
    <PackageReference Include="Plugin.BLE" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared Nordic-UART BLE transport, compiled into each mobile head. -->
    <Compile Include="..\Mobile\BleTransport.cs" Link="BleTransport.cs" />
    <Compile Include="..\Mobile\BleDfu.cs" Link="BleDfu.cs" />
    <Compile Include="..\Mobile\UsbCdcTransport.cs" Link="UsbCdcTransport.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChameLab\ChameLab.csproj" />
  </ItemGroup>
</Project>
