<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Keep the whole Avalonia stack on one version. -->
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- QR codes: card sharing (encode and decode, fully managed) -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <!-- Reactive stack -->
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.7" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <!-- Actipro modern theme + controls -->
    <PackageVersion Include="ActiproSoftware.Controls.Avalonia" Version="26.2.0" />
    <!-- Transports -->
    <PackageVersion Include="System.IO.Ports" Version="11.0.0" />
    <PackageVersion Include="Plugin.BLE" Version="3.3.0-beta.3" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Android splash -->
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <!-- Android QR scanner: Google Play services' ready-made scanner screen (no camera permission) -->
    <PackageVersion Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.17" />
    <!-- Keep Core.Ktx in step with Core: the Kotlin extensions moved into Core, and mismatched
         versions both ship them, so D8 fails with "Type ... is defined multiple times". -->
    <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.1" />
    <!-- Core.Ktx pulls Lifecycle 2.11; lift the packages that still pin 2.10 so NuGet doesn't
         resolve them outside their dependency range (NU1608). -->
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
  </ItemGroup>
</Project>
