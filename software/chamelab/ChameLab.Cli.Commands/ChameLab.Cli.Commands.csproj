<Project Sdk="Microsoft.NET.Sdk">
  <!-- The CLI's commands without a terminal: shared by the chamelab executable and the app's console. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ChameLab.Cli</RootNamespace>
    <!-- The app ships these commands in trimmed builds (iOS, browser); analyze here so desktop builds catch it too. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ChameLab.Core/ChameLab.Core.csproj" />
    <EmbeddedResource Include="CommandCatalog.json;EnumCatalog.json;DesfireKeys.json" />
    <InternalsVisibleTo Include="chamelab" />
    <InternalsVisibleTo Include="ChameLab.Cli.Tests" />
  </ItemGroup>
</Project>
