<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- Link SkiaSharp/HarfBuzz native assets into the WASM output. Requires the
         wasm-tools workload (`dotnet workload install wasm-tools`). -->
    <WasmBuildNative>true</WasmBuildNative>
    <!-- Recovery loops need compiled Wasm, rather than the IL interpreter.
         AOT runs on publish; retain fast local Debug builds. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release' and '$(RunAOTCompilation)' == ''">true</RunAOTCompilation>
    <!-- By default the runtime loads only the ICU shard for the browser's own locale, so a UI
         language picked in Settings (e.g. Russian in an English browser) could be missing. -->
    <WasmIncludeFullIcuData>true</WasmIncludeFullIcuData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChameLab\ChameLab.csproj" />
  </ItemGroup>
</Project>
