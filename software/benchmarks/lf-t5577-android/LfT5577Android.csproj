<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <ApplicationId>io.github.m0n5ter.chamelab.lft5577bench</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LfT5577Schedule Condition="'$(LfT5577Schedule)' == ''">$(MSBuildThisFileDirectory)Assets/schedule.json</LfT5577Schedule>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Android.Widget" />
    <ProjectReference Include="../../chamelab/ChameLab.Cli.Commands/ChameLab.Cli.Commands.csproj" />
    <PackageReference Include="Plugin.BLE" Version="3.3.0-beta.2" />
    <Compile Include="../../chamelab/Mobile/BleTransport.cs" Link="BleTransport.cs" />
    <AndroidAsset Include="$(LfT5577Schedule)" Link="schedule.json" />
  </ItemGroup>
  <Target Name="RequireLfSchedule" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LfT5577Schedule)')" Text="Supply the LF test schedule JSON with -p:LfT5577Schedule=ABSOLUTE_PATH." />
  </Target>
</Project>
