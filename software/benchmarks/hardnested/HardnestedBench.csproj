<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../chamelab/ChameLab/Crypto/**/*.cs" Link="Crypto/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../chamelab/ChameLab/Services/HardnestedRecovery.cs" Link="HardnestedRecovery.cs" />
    <Compile Include="../../chamelab/ChameLab/Services/ManagedHardnestedEngine.cs" Link="ManagedHardnestedEngine.cs" />
    <EmbeddedResource Include="../../chamelab/ChameLab/Crypto/Hardnested/tables.bin" LogicalName="ChameLab.Hardnested.Tables" />
  </ItemGroup>
</Project>
