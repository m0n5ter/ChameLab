<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <ApplicationId>io.github.m0n5ter.chamelab.batchbench</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Android.Widget" />
    <ProjectReference Include="../../chamelab/ChameLab.Core/ChameLab.Core.csproj" />
    <PackageReference Include="Plugin.BLE" Version="3.3.0-beta.2" />
    <Compile Include="../../chamelab/Mobile/BleTransport.cs" Link="BleTransport.cs" />
    <Compile Include="../batch-keys/Runner.cs" Link="Runner.cs" />
    <Compile Include="../batch-keys/MeasuredTransport.cs" Link="MeasuredTransport.cs" />
  </ItemGroup>
</Project>
